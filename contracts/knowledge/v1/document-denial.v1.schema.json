{
  "$id": "urn:retailops:knowledge:document-denial:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Actor",
      "type": "string"
    },
    "document_id": {
      "pattern": "^document-sha256-[0-9a-f]{64}$",
      "title": "Document Id",
      "type": "string"
    },
    "environment": {
      "enum": [
        "local",
        "test"
      ],
      "title": "Environment",
      "type": "string"
    },
    "reason": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "environment",
    "document_id",
    "actor",
    "reason"
  ],
  "title": "DocumentDenial",
  "type": "object"
}
