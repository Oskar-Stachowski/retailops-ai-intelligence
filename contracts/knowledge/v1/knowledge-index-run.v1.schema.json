{
  "$defs": {
    "IndexSource": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha"
      ],
      "title": "IndexSource",
      "type": "object"
    },
    "KnowledgeIndexRequest": {
      "additionalProperties": false,
      "properties": {
        "corpus_config_id": {
          "pattern": "^corpus-config-sha256-[0-9a-f]{64}$",
          "title": "Corpus Config Id",
          "type": "string"
        },
        "evaluation_set_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Evaluation Set Id",
          "type": "string"
        },
        "index_config_id": {
          "pattern": "^index-config-sha256-[0-9a-f]{64}$",
          "title": "Index Config Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/IndexSource"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "corpus_config_id",
        "sources",
        "index_config_id",
        "evaluation_set_id"
      ],
      "title": "KnowledgeIndexRequest",
      "type": "object"
    },
    "KnowledgeRunInput": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": [
            "local",
            "test"
          ],
          "title": "Environment",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^index-build-profile-sha256-[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/KnowledgeIndexRequest"
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Hash",
          "type": "string"
        }
      },
      "required": [
        "request",
        "request_hash",
        "profile_id",
        "environment"
      ],
      "title": "KnowledgeRunInput",
      "type": "object"
    },
    "KnowledgeRunOutput": {
      "additionalProperties": false,
      "properties": {
        "activation_status": {
          "const": "candidate",
          "title": "Activation Status",
          "type": "string"
        },
        "complete": {
          "const": true,
          "title": "Complete",
          "type": "boolean"
        },
        "evaluation_report_ref": {
          "pattern": "^db:ai.rag_index_reports:index-run-report-sha256-[0-9a-f]{64}$",
          "title": "Evaluation Report Ref",
          "type": "string"
        },
        "index_id": {
          "pattern": "^index-sha256-[0-9a-f]{64}$",
          "title": "Index Id",
          "type": "string"
        },
        "kind": {
          "const": "knowledge_index",
          "title": "Kind",
          "type": "string"
        },
        "manifest_ref": {
          "pattern": "^db:ai.rag_indexes:index-sha256-[0-9a-f]{64}$",
          "title": "Manifest Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "complete",
        "index_id",
        "manifest_ref",
        "evaluation_report_ref",
        "activation_status"
      ],
      "title": "KnowledgeRunOutput",
      "type": "object"
    },
    "RunError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_input",
            "dependency_unavailable",
            "execution_failed",
            "cancelled",
            "gate_failed"
          ],
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "title": "RunError",
      "type": "object"
    }
  },
  "$id": "urn:retailops:knowledge:knowledge-index-run:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "New knowledge contract namespace reuses the shared Run envelope and transitions.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "contract_type": {
      "const": "run",
      "title": "Contract Type",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunError"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_ref": {
      "$ref": "#/$defs/KnowledgeRunInput"
    },
    "output_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeRunOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Requested By",
      "type": "string"
    },
    "resolved_model": {
      "title": "Resolved Model",
      "type": "null"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_type": {
      "const": "knowledge_index",
      "title": "Run Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "run_id",
    "run_type",
    "status",
    "attempt",
    "requested_at",
    "started_at",
    "completed_at",
    "requested_by",
    "input_ref",
    "resolved_model",
    "output_ref",
    "error"
  ],
  "title": "KnowledgeRunRecord",
  "type": "object"
}
