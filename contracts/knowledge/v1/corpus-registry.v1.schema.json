{
  "$defs": {
    "DocumentRegistration": {
      "additionalProperties": false,
      "properties": {
        "access_class": {
          "enum": [
            "public_project",
            "project_internal",
            "restricted"
          ],
          "title": "Access Class",
          "type": "string"
        },
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "document_status": {
          "enum": [
            "specified",
            "implemented",
            "verified",
            "deprecated",
            "historical"
          ],
          "title": "Document Status",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "architecture",
            "contract",
            "guide",
            "runbook",
            "policy",
            "plan",
            "evidence",
            "model_card"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "fact_scope": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Fact Scope",
          "type": "string"
        },
        "implementation_refs": {
          "items": {
            "$ref": "#/$defs/ImplementationReference"
          },
          "maxItems": 8,
          "title": "Implementation Refs",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "title",
        "byte_sha256",
        "document_type",
        "document_status",
        "access_class",
        "fact_scope",
        "implementation_refs",
        "verification"
      ],
      "title": "DocumentRegistration",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "commit_pointer": {
          "maxLength": 200,
          "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
          "title": "Commit Pointer",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "expected_result": {
          "enum": [
            "success",
            "passed",
            "rejected"
          ],
          "title": "Expected Result",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        },
        "result_pointer": {
          "maxLength": 200,
          "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
          "title": "Result Pointer",
          "type": "string"
        },
        "scope": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Verified At",
          "type": "string"
        },
        "verified_at_pointer": {
          "maxLength": 200,
          "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
          "title": "Verified At Pointer",
          "type": "string"
        },
        "verified_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Verified Commit",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "byte_sha256",
        "verified_at",
        "verified_commit",
        "commit_pointer",
        "verified_at_pointer",
        "scope",
        "result_pointer",
        "expected_result"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ImplementationReference": {
      "additionalProperties": false,
      "properties": {
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "byte_sha256"
      ],
      "title": "ImplementationReference",
      "type": "object"
    },
    "SourceRegistration": {
      "additionalProperties": false,
      "properties": {
        "allowed_roots": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Allowed Roots",
          "type": "array"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentRegistration"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Documents",
          "type": "array"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "allowed_roots",
        "documents"
      ],
      "title": "SourceRegistration",
      "type": "object"
    }
  },
  "$id": "urn:retailops:knowledge:corpus-registry:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "enum": [
        "local",
        "test",
        "dev",
        "production"
      ],
      "title": "Environment",
      "type": "string"
    },
    "policy_version": {
      "const": "registered-markdown-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "review_owner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Review Owner",
      "type": "string"
    },
    "review_state": {
      "const": "proposed",
      "title": "Review State",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRegistration"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "policy_version",
    "environment",
    "review_state",
    "review_owner",
    "sources"
  ],
  "title": "CorpusRegistry",
  "type": "object"
}
