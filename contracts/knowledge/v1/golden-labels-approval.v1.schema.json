{
  "$id": "urn:retailops:knowledge:golden-labels-approval:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "pattern": "^golden-approval-sha256-[0-9a-f]{64}$",
      "title": "Approval Id",
      "type": "string"
    },
    "decision": {
      "const": "approved",
      "title": "Decision",
      "type": "string"
    },
    "environment": {
      "enum": [
        "local",
        "test"
      ],
      "title": "Environment",
      "type": "string"
    },
    "golden_set_id": {
      "pattern": "^golden-set-sha256-[0-9a-f]{64}$",
      "title": "Golden Set Id",
      "type": "string"
    },
    "index_id": {
      "pattern": "^index-sha256-[0-9a-f]{64}$",
      "title": "Index Id",
      "type": "string"
    },
    "retrieval_config_id": {
      "pattern": "^retrieval-config-sha256-[0-9a-f]{64}$",
      "title": "Retrieval Config Id",
      "type": "string"
    },
    "review_owner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Review Owner",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Reviewer",
      "type": "string"
    },
    "reviewer_kind": {
      "enum": [
        "human",
        "approved_pipeline"
      ],
      "title": "Reviewer Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "labels_tools_and_frozen_thresholds",
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "golden_set_id",
    "index_id",
    "retrieval_config_id",
    "environment",
    "review_owner",
    "reviewer",
    "reviewer_kind",
    "decision",
    "scope",
    "reviewed_at"
  ],
  "title": "GoldenLabelsApproval",
  "type": "object"
}
