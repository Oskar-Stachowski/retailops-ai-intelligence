{
  "$id": "urn:retailops:knowledge:embedding-config:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dimension": {
      "enum": [
        8,
        16,
        32,
        64,
        256,
        512,
        1024
      ],
      "title": "Dimension",
      "type": "integer"
    },
    "distance": {
      "const": "cosine",
      "title": "Distance",
      "type": "string"
    },
    "inference_profile": {
      "title": "Inference Profile",
      "type": "null"
    },
    "model_id": {
      "enum": [
        "sha256-unit-f32-v1",
        "amazon.titan-embed-text-v2:0"
      ],
      "title": "Model Id",
      "type": "string"
    },
    "normalization": {
      "const": "l2-unit",
      "title": "Normalization",
      "type": "string"
    },
    "provider": {
      "enum": [
        "fake",
        "bedrock"
      ],
      "title": "Provider",
      "type": "string"
    },
    "region": {
      "pattern": "^(offline|[a-z]{2}-[a-z]+-[0-9])$",
      "title": "Region",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "transformation_version": {
      "enum": [
        "utf8-chunk-body-v1",
        "utf8-heading-path-body-v1"
      ],
      "title": "Transformation Version",
      "type": "string"
    },
    "vector_format": {
      "const": "float32-big-endian-v1",
      "title": "Vector Format",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "provider",
    "model_id",
    "inference_profile",
    "region",
    "dimension",
    "normalization",
    "distance",
    "transformation_version",
    "vector_format"
  ],
  "title": "EmbeddingConfig",
  "type": "object"
}
