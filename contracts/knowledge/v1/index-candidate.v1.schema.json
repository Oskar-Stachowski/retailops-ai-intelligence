{
  "$defs": {
    "ChunkManifest": {
      "additionalProperties": false,
      "properties": {
        "chunk_manifest_id": {
          "pattern": "^chunks-sha256-[0-9a-f]{64}$",
          "title": "Chunk Manifest Id",
          "type": "string"
        },
        "chunker": {
          "$ref": "#/$defs/ChunkerConfig"
        },
        "chunker_config_id": {
          "pattern": "^chunker-config-sha256-[0-9a-f]{64}$",
          "title": "Chunker Config Id",
          "type": "string"
        },
        "chunks": {
          "items": {
            "$ref": "#/$defs/MarkdownChunk"
          },
          "maxItems": 32768,
          "title": "Chunks",
          "type": "array"
        },
        "content_trust": {
          "const": "untrusted_reference",
          "title": "Content Trust",
          "type": "string"
        },
        "corpus": {
          "$ref": "#/$defs/CorpusManifest"
        },
        "corpus_id": {
          "pattern": "^corpus-sha256-[0-9a-f]{64}$",
          "title": "Corpus Id",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentChunkMap"
          },
          "maxItems": 128,
          "minItems": 2,
          "title": "Documents",
          "type": "array"
        },
        "lifecycle": {
          "const": "candidate",
          "title": "Lifecycle",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "lifecycle",
        "content_trust",
        "corpus_id",
        "corpus",
        "chunker",
        "chunker_config_id",
        "chunk_manifest_id",
        "documents",
        "chunks"
      ],
      "title": "ChunkManifest",
      "type": "object"
    },
    "ChunkerConfig": {
      "additionalProperties": false,
      "properties": {
        "chunker_version": {
          "const": "markdown-blocks-v1",
          "title": "Chunker Version",
          "type": "string"
        },
        "duplicate_policy": {
          "const": "same-document-heading-block-content-v1",
          "title": "Duplicate Policy",
          "type": "string"
        },
        "max_utf8_bytes": {
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Utf8 Bytes",
          "type": "integer"
        },
        "navigation_policy": {
          "const": "toc-headings-and-anchor-only-blocks-v1",
          "title": "Navigation Policy",
          "type": "string"
        },
        "normalization": {
          "const": "utf8-lf-v1",
          "title": "Normalization",
          "type": "string"
        },
        "parser": {
          "const": "markdown-it-py",
          "title": "Parser",
          "type": "string"
        },
        "parser_preset": {
          "const": "commonmark-table-v1",
          "title": "Parser Preset",
          "type": "string"
        },
        "parser_version": {
          "const": "4.2.0",
          "title": "Parser Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_estimator": {
          "const": "utf8-bytes-div4-v1",
          "title": "Size Estimator",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "chunker_version",
        "parser",
        "parser_version",
        "parser_preset",
        "normalization",
        "max_utf8_bytes",
        "size_estimator",
        "navigation_policy",
        "duplicate_policy"
      ],
      "title": "ChunkerConfig",
      "type": "object"
    },
    "CorpusManifest": {
      "additionalProperties": false,
      "properties": {
        "canonicalization_version": {
          "const": "utf8-lf-v1",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "content_trust": {
          "const": "untrusted_reference",
          "title": "Content Trust",
          "type": "string"
        },
        "corpus_config_id": {
          "pattern": "^corpus-config-sha256-[0-9a-f]{64}$",
          "title": "Corpus Config Id",
          "type": "string"
        },
        "corpus_id": {
          "pattern": "^corpus-sha256-[0-9a-f]{64}$",
          "title": "Corpus Id",
          "type": "string"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/ManifestDocument"
          },
          "maxItems": 128,
          "minItems": 2,
          "title": "Documents",
          "type": "array"
        },
        "duplicate_content_groups": {
          "items": {
            "items": {
              "pattern": "^document-sha256-[0-9a-f]{64}$",
              "type": "string"
            },
            "type": "array"
          },
          "title": "Duplicate Content Groups",
          "type": "array"
        },
        "environment": {
          "enum": [
            "local",
            "test",
            "dev",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        },
        "excluded_documents": {
          "items": {
            "$ref": "#/$defs/ExcludedDocument"
          },
          "title": "Excluded Documents",
          "type": "array"
        },
        "exclusion_policy": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Exclusion Policy",
          "type": "object"
        },
        "lifecycle": {
          "const": "candidate",
          "title": "Lifecycle",
          "type": "string"
        },
        "policy_version": {
          "const": "registered-markdown-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "review_owner": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Review Owner",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRegistration"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "canonicalization_version",
        "environment",
        "lifecycle",
        "review_owner",
        "content_trust",
        "corpus_config_id",
        "corpus_id",
        "sources",
        "documents",
        "excluded_documents",
        "exclusion_policy",
        "duplicate_content_groups"
      ],
      "title": "CorpusManifest",
      "type": "object"
    },
    "DocumentChunkMap": {
      "additionalProperties": false,
      "properties": {
        "chunk_ids": {
          "items": {
            "pattern": "^chunk-sha256-[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Chunk Ids",
          "type": "array"
        },
        "document_id": {
          "pattern": "^document-sha256-[0-9a-f]{64}$",
          "title": "Document Id",
          "type": "string"
        },
        "omitted_blocks": {
          "items": {
            "$ref": "#/$defs/OmittedBlock"
          },
          "maxItems": 8192,
          "title": "Omitted Blocks",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "chunked",
            "no_retrievable_content"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "source_characters": {
          "exclusiveMinimum": 0,
          "maximum": 500000,
          "title": "Source Characters",
          "type": "integer"
        },
        "source_lines": {
          "exclusiveMinimum": 0,
          "maximum": 500001,
          "title": "Source Lines",
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "source_characters",
        "source_lines",
        "chunk_ids",
        "omitted_blocks",
        "outcome"
      ],
      "title": "DocumentChunkMap",
      "type": "object"
    },
    "DocumentRegistration": {
      "additionalProperties": false,
      "properties": {
        "access_class": {
          "enum": [
            "public_project",
            "project_internal",
            "restricted"
          ],
          "title": "Access Class",
          "type": "string"
        },
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "document_status": {
          "enum": [
            "specified",
            "implemented",
            "verified",
            "deprecated",
            "historical"
          ],
          "title": "Document Status",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "architecture",
            "contract",
            "guide",
            "runbook",
            "policy",
            "plan",
            "evidence",
            "model_card"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "fact_scope": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Fact Scope",
          "type": "string"
        },
        "implementation_refs": {
          "items": {
            "$ref": "#/$defs/ImplementationReference"
          },
          "maxItems": 8,
          "title": "Implementation Refs",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "title",
        "byte_sha256",
        "document_type",
        "document_status",
        "access_class",
        "fact_scope",
        "implementation_refs",
        "verification"
      ],
      "title": "DocumentRegistration",
      "type": "object"
    },
    "EmbeddingConfig": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            8,
            16,
            32,
            64
          ],
          "title": "Dimension",
          "type": "integer"
        },
        "distance": {
          "const": "cosine",
          "title": "Distance",
          "type": "string"
        },
        "inference_profile": {
          "title": "Inference Profile",
          "type": "null"
        },
        "model_id": {
          "const": "sha256-unit-f32-v1",
          "title": "Model Id",
          "type": "string"
        },
        "normalization": {
          "const": "l2-unit",
          "title": "Normalization",
          "type": "string"
        },
        "provider": {
          "const": "fake",
          "title": "Provider",
          "type": "string"
        },
        "region": {
          "const": "offline",
          "title": "Region",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "transformation_version": {
          "const": "utf8-chunk-body-v1",
          "title": "Transformation Version",
          "type": "string"
        },
        "vector_format": {
          "const": "float32-big-endian-v1",
          "title": "Vector Format",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "provider",
        "model_id",
        "inference_profile",
        "region",
        "dimension",
        "normalization",
        "distance",
        "transformation_version",
        "vector_format"
      ],
      "title": "EmbeddingConfig",
      "type": "object"
    },
    "EmbeddingRecord": {
      "additionalProperties": false,
      "properties": {
        "content_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Checksum",
          "type": "string"
        },
        "dimension": {
          "enum": [
            8,
            16,
            32,
            64
          ],
          "title": "Dimension",
          "type": "integer"
        },
        "embedding_id": {
          "pattern": "^embedding-sha256-[0-9a-f]{64}$",
          "title": "Embedding Id",
          "type": "string"
        },
        "space_id": {
          "pattern": "^embedding-space-sha256-[0-9a-f]{64}$",
          "title": "Space Id",
          "type": "string"
        },
        "vector": {
          "items": {
            "type": "number"
          },
          "maxItems": 64,
          "minItems": 8,
          "title": "Vector",
          "type": "array"
        },
        "vector_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vector Checksum",
          "type": "string"
        }
      },
      "required": [
        "embedding_id",
        "space_id",
        "content_checksum",
        "dimension",
        "vector",
        "vector_checksum"
      ],
      "title": "EmbeddingRecord",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "commit_pointer": {
          "maxLength": 200,
          "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
          "title": "Commit Pointer",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "expected_result": {
          "enum": [
            "success",
            "passed",
            "rejected"
          ],
          "title": "Expected Result",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        },
        "result_pointer": {
          "maxLength": 200,
          "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
          "title": "Result Pointer",
          "type": "string"
        },
        "scope": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Verified At",
          "type": "string"
        },
        "verified_at_pointer": {
          "maxLength": 200,
          "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
          "title": "Verified At Pointer",
          "type": "string"
        },
        "verified_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Verified Commit",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "byte_sha256",
        "verified_at",
        "verified_commit",
        "commit_pointer",
        "verified_at_pointer",
        "scope",
        "result_pointer",
        "expected_result"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExcludedDocument": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "enum": [
            "not_registered",
            "credentials_or_private_path",
            "non_regular_git_entry"
          ],
          "title": "Reason",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "path",
        "reason"
      ],
      "title": "ExcludedDocument",
      "type": "object"
    },
    "Heading": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "maximum": 6,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "level",
        "title"
      ],
      "title": "Heading",
      "type": "object"
    },
    "ImplementationReference": {
      "additionalProperties": false,
      "properties": {
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "byte_sha256"
      ],
      "title": "ImplementationReference",
      "type": "object"
    },
    "IndexEntry": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "pattern": "^chunk-sha256-[0-9a-f]{64}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "embedding_id": {
          "pattern": "^embedding-sha256-[0-9a-f]{64}$",
          "title": "Embedding Id",
          "type": "string"
        },
        "vector_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vector Checksum",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "embedding_id",
        "vector_checksum"
      ],
      "title": "IndexEntry",
      "type": "object"
    },
    "IndexManifest": {
      "additionalProperties": false,
      "properties": {
        "chunk_count": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Chunk Count",
          "type": "integer"
        },
        "chunk_manifest_id": {
          "pattern": "^chunks-sha256-[0-9a-f]{64}$",
          "title": "Chunk Manifest Id",
          "type": "string"
        },
        "corpus_id": {
          "pattern": "^corpus-sha256-[0-9a-f]{64}$",
          "title": "Corpus Id",
          "type": "string"
        },
        "embedding_config": {
          "$ref": "#/$defs/EmbeddingConfig"
        },
        "embedding_count": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Embedding Count",
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/IndexEntry"
          },
          "maxItems": 32768,
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "environment": {
          "enum": [
            "local",
            "test"
          ],
          "title": "Environment",
          "type": "string"
        },
        "index_id": {
          "pattern": "^index-sha256-[0-9a-f]{64}$",
          "title": "Index Id",
          "type": "string"
        },
        "lifecycle": {
          "const": "candidate",
          "title": "Lifecycle",
          "type": "string"
        },
        "migration_revision": {
          "const": "0002_rag_candidates",
          "title": "Migration Revision",
          "type": "string"
        },
        "pgvector_version": {
          "const": "0.8.6",
          "title": "Pgvector Version",
          "type": "string"
        },
        "retrieval_version": {
          "const": "not_implemented",
          "title": "Retrieval Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_quality": {
          "const": "not_evaluated_fake_vectors",
          "title": "Semantic Quality",
          "type": "string"
        },
        "space_id": {
          "pattern": "^embedding-space-sha256-[0-9a-f]{64}$",
          "title": "Space Id",
          "type": "string"
        },
        "storage_version": {
          "const": "pgvector-checked-dimension-v1",
          "title": "Storage Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "lifecycle",
        "environment",
        "semantic_quality",
        "index_id",
        "corpus_id",
        "chunk_manifest_id",
        "embedding_config",
        "space_id",
        "storage_version",
        "pgvector_version",
        "migration_revision",
        "retrieval_version",
        "chunk_count",
        "embedding_count",
        "entries"
      ],
      "title": "IndexManifest",
      "type": "object"
    },
    "ManifestDocument": {
      "additionalProperties": false,
      "properties": {
        "access_class": {
          "enum": [
            "public_project",
            "project_internal",
            "restricted"
          ],
          "title": "Access Class",
          "type": "string"
        },
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "content_id": {
          "pattern": "^markdown-sha256-[0-9a-f]{64}$",
          "title": "Content Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^document-sha256-[0-9a-f]{64}$",
          "title": "Document Id",
          "type": "string"
        },
        "document_status": {
          "enum": [
            "specified",
            "implemented",
            "verified",
            "deprecated",
            "historical"
          ],
          "title": "Document Status",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "architecture",
            "contract",
            "guide",
            "runbook",
            "policy",
            "plan",
            "evidence",
            "model_card"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "fact_scope": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Fact Scope",
          "type": "string"
        },
        "implementation_refs": {
          "items": {
            "$ref": "#/$defs/ImplementationReference"
          },
          "maxItems": 8,
          "title": "Implementation Refs",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
