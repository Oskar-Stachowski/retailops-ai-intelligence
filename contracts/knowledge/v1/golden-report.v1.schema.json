{
  "$defs": {
    "CaseEvaluation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "citations_bound": {
          "title": "Citations Bound",
          "type": "boolean"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "expected_outcome": {
          "title": "Expected Outcome",
          "type": "boolean"
        },
        "forbidden_sources_absent": {
          "title": "Forbidden Sources Absent",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "ok",
            "insufficient_evidence",
            "forbidden"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "recall_at_5": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recall At 5"
        },
        "reciprocal_rank": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reciprocal Rank"
        },
        "retrieved_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Retrieved Chunk Ids",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "outcome",
        "recall_at_5",
        "reciprocal_rank",
        "forbidden_sources_absent",
        "expected_outcome",
        "citations_bound",
        "critical",
        "passed",
        "retrieved_chunk_ids",
        "elapsed_ms"
      ],
      "title": "CaseEvaluation",
      "type": "object"
    },
    "GoldenThresholds": {
      "additionalProperties": false,
      "properties": {
        "citation_correctness_min": {
          "maximum": 1,
          "minimum": 1,
          "title": "Citation Correctness Min",
          "type": "number"
        },
        "critical_pass_rate_min": {
          "maximum": 1,
          "minimum": 1,
          "title": "Critical Pass Rate Min",
          "type": "number"
        },
        "groundedness_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Groundedness Min",
          "type": "number"
        },
        "latency_p95_ms_max": {
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "title": "Latency P95 Ms Max",
          "type": "number"
        },
        "mrr_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mrr Min",
          "type": "number"
        },
        "offline_cost_usd_max": {
          "maximum": 0,
          "minimum": 0,
          "title": "Offline Cost Usd Max",
          "type": "number"
        },
        "recall_at_5_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall At 5 Min",
          "type": "number"
        }
      },
      "required": [
        "recall_at_5_min",
        "mrr_min",
        "citation_correctness_min",
        "critical_pass_rate_min",
        "groundedness_min",
        "latency_p95_ms_max",
        "offline_cost_usd_max"
      ],
      "title": "GoldenThresholds",
      "type": "object"
    }
  },
  "$id": "urn:retailops:knowledge:golden-report:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_allowed": {
      "const": false,
      "default": false,
      "title": "Activation Allowed",
      "type": "boolean"
    },
    "agent_tool_evaluation": {
      "const": "labels_only_no_agent_runtime",
      "default": "labels_only_no_agent_runtime",
      "title": "Agent Tool Evaluation",
      "type": "string"
    },
    "answer_groundedness": {
      "default": null,
      "title": "Answer Groundedness",
      "type": "null"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseEvaluation"
      },
      "title": "Cases",
      "type": "array"
    },
    "citation_correctness": {
      "title": "Citation Correctness",
      "type": "number"
    },
    "corpus_approved": {
      "const": false,
      "default": false,
      "title": "Corpus Approved",
      "type": "boolean"
    },
    "critical_pass_rate": {
      "title": "Critical Pass Rate",
      "type": "number"
    },
    "golden_set_id": {
      "pattern": "^golden-set-sha256-[0-9a-f]{64}$",
      "title": "Golden Set Id",
      "type": "string"
    },
    "index_id": {
      "pattern": "^index-sha256-[0-9a-f]{64}$",
      "title": "Index Id",
      "type": "string"
    },
    "labels_approved": {
      "const": false,
      "default": false,
      "title": "Labels Approved",
      "type": "boolean"
    },
    "latency_p95_ms": {
      "title": "Latency P95 Ms",
      "type": "number"
    },
    "measured_thresholds_passed": {
      "title": "Measured Thresholds Passed",
      "type": "boolean"
    },
    "model_cost_usd": {
      "default": 0.0,
      "maximum": 0,
      "minimum": 0,
      "title": "Model Cost Usd",
      "type": "number"
    },
    "mrr": {
      "title": "Mrr",
      "type": "number"
    },
    "provider": {
      "default": "fake",
      "enum": [
        "fake",
        "bedrock"
      ],
      "title": "Provider",
      "type": "string"
    },
    "recall_at_5": {
      "title": "Recall At 5",
      "type": "number"
    },
    "report_kind": {
      "default": "offline_mechanics_with_draft_semantic_labels",
      "enum": [
        "offline_mechanics_with_draft_semantic_labels",
        "semantic_retrieval_evaluation"
      ],
      "title": "Report Kind",
      "type": "string"
    },
    "retrieval_config_id": {
      "pattern": "^retrieval-config-sha256-[0-9a-f]{64}$",
      "title": "Retrieval Config Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_quality": {
      "default": "not_evaluated_fake_vectors",
      "enum": [
        "not_evaluated_fake_vectors",
        "measured_real_vectors"
      ],
      "title": "Semantic Quality",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/GoldenThresholds"
    }
  },
  "required": [
    "golden_set_id",
    "index_id",
    "retrieval_config_id",
    "thresholds",
    "cases",
    "recall_at_5",
    "mrr",
    "citation_correctness",
    "critical_pass_rate",
    "latency_p95_ms",
    "measured_thresholds_passed"
  ],
  "title": "GoldenReport",
  "type": "object"
}
