{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "title": "Name",
            "type": "string"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "up",
              "down",
              "timeout"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "required",
          "status"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "anyOf": [
              {
                "enum": [
                  "configuration-not-approved",
                  "idempotency-conflict",
                  "index-run-not-found",
                  "index-not-configured",
                  "queue-full",
                  "worker-busy",
                  "claim-lost",
                  "index-report-not-found"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "database-not-ready",
                  "scope-denied",
                  "batch-scope-limit",
                  "forecast-run-not-found",
                  "forecast-run-denied",
                  "invalid-idempotency-key",
                  "idempotency-conflict",
                  "input-from-future",
                  "model-not-approved",
                  "model-decision-incomplete",
                  "input-not-prepared",
                  "input-origin-mismatch",
                  "queue-full",
                  "input-coverage-mismatch",
                  "input-runtime-incompatible",
                  "run-not-active"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "forecast-read-denied",
                  "forecast-scope-invalid",
                  "forecast-scope-limit",
                  "forecast-output-not-found",
                  "forecast-view-changed",
                  "forecast-view-required",
                  "forecast-read-budget",
                  "forecast-output-invalid"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "model-read-denied",
                  "model-scope-invalid",
                  "model-scope-limit",
                  "model-not-found",
                  "model-view-required",
                  "model-view-changed",
                  "model-read-budget",
                  "model-metadata-invalid"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "evaluation-read-denied",
                  "evaluation-scope-invalid",
                  "evaluation-scope-limit",
                  "evaluation-not-found",
                  "evaluation-view-required",
                  "evaluation-view-changed",
                  "evaluation-read-budget",
                  "evaluation-evidence-invalid"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "stockout-run-not-found",
                  "stockout-run-denied",
                  "stockout-risk-not-found",
                  "stockout-scope-denied",
                  "stockout-input-not-prepared",
                  "stockout-input-origin-mismatch",
                  "stockout-input-coverage-mismatch",
                  "stockout-input-runtime-incompatible",
                  "stockout-input-from-future",
                  "stockout-model-not-approved",
                  "stockout-model-decision-incomplete",
                  "stockout-queue-full",
                  "stockout-idempotency-conflict",
                  "stockout-invalid-idempotency-key",
                  "stockout-run-not-active",
                  "stockout-database-not-ready",
                  "stockout-view-changed",
                  "stockout-read-budget"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "pattern": "^urn:uuid:[0-9a-f-]{36}$",
            "title": "Instance",
            "type": "string"
          },
          "readiness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ready"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "maximum": 599.0,
            "minimum": 400.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "const": "about:blank",
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "correlation_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Ready": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "role": {
            "default": "foundation",
            "enum": [
              "foundation",
              "ai_api"
            ],
            "title": "Role",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "degraded",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "Ready",
        "type": "object"
      },
      "ServiceVersion": {
        "additionalProperties": false,
        "properties": {
          "build_commit": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build Commit"
          },
          "image_digest": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Digest"
          },
          "implementation_status": {
            "const": "in_progress",
            "default": "in_progress",
            "title": "Implementation Status",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "null"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "service": {
            "const": "retailops-ai-intelligence",
            "default": "retailops-ai-intelligence",
            "title": "Service",
            "type": "string"
          },
          "version": {
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[a-z0-9.+-]+)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "ServiceVersion",
        "type": "object"
      }
    },
    "securitySchemes": {
      "metricsBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RetailOps AI diagnostics",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "prometheus_metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain; version=1.0.0; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "metricsBearer": []
          }
        ],
        "summary": "Prometheus Metrics"
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/version": {
      "get": {
        "operationId": "service_version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceVersion"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Service Version"
      }
    }
  }
}
