{
  "$defs": {
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "DataScope",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "FactualFactor": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "known_available_stock",
            "inventory_snapshot_age",
            "supply_from_observed_sales",
            "supply_from_verified_in_stock_sales",
            "known_delivery_plan_within_horizon",
            "known_overdue_order_quantity",
            "history_had_inventory_constraints",
            "history_inventory_coverage_missing",
            "current_stockout",
            "input_not_evaluable",
            "stale_inventory"
          ],
          "title": "Code",
          "type": "string"
        },
        "field": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Field",
          "type": "string"
        },
        "interpretation": {
          "const": "verified_PIT_fact_not_causal_attribution",
          "default": "verified_PIT_fact_not_causal_attribution",
          "title": "Interpretation",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "code",
        "field",
        "value"
      ],
      "title": "FactualFactor",
      "type": "object"
    },
    "InventoryRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "contract_type": {
          "const": "tool_request",
          "title": "Contract Type",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "const": "get_inventory_status",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "scope",
        "as_of",
        "tool"
      ],
      "title": "InventoryRequest",
      "type": "object"
    },
    "NativeInventoryEvidence": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "curated_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Curated Descriptor Sha256",
          "type": "string"
        },
        "environment": {
          "enum": [
            "local",
            "test"
          ],
          "title": "Environment",
          "type": "string"
        },
        "evidence_version": {
          "const": "verified-inventory-snapshots-v1",
          "default": "verified-inventory-snapshots-v1",
          "title": "Evidence Version",
          "type": "string"
        },
        "max_snapshot_age_seconds": {
          "const": 300,
          "default": 300,
          "title": "Max Snapshot Age Seconds",
          "type": "integer"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/NativeInventoryPoint"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "qualification_runtime_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qualification Runtime Sha256",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/InventoryRequest"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "source_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Descriptor Sha256",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "request",
        "source_dataset_id",
        "source_descriptor_sha256",
        "curated_dataset_id",
        "curated_descriptor_sha256",
        "qualification_runtime_sha256",
        "points"
      ],
      "title": "NativeInventoryEvidence",
      "type": "object"
    },
    "NativeInventoryPoint": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeInventoryRoute"
            },
            {
              "type": "null"
            }
          ]
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeInventorySnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "known",
            "missing_route",
            "missing_snapshot",
            "not_available",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "route",
        "snapshot",
        "status"
      ],
      "title": "NativeInventoryPoint",
      "type": "object"
    },
    "NativeInventoryRoute": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Available At",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "curated_available_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Curated Available At",
          "type": "string"
        },
        "effective_from": {
          "format": "date",
          "title": "Effective From",
          "type": "string"
        },
        "effective_to": {
          "format": "date",
          "title": "Effective To",
          "type": "string"
        },
        "route_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Route Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "source_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Record Sha256",
          "type": "string"
        },
        "stock_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Stock Location Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "route_id",
        "version",
        "selling_location_id",
        "stock_location_id",
        "channel",
        "effective_from",
        "effective_to",
        "available_at",
        "curated_available_at",
        "source_record_sha256"
      ],
      "title": "NativeInventoryRoute",
      "type": "object"
    },
    "NativeInventorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of_time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of Time",
          "type": "string"
        },
        "available_qty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Qty"
        },
        "business_date": {
          "format": "date",
          "title": "Business Date",
          "type": "string"
        },
        "curated_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Curated Available At"
        },
        "is_full_business_day": {
          "title": "Is Full Business Day",
          "type": "boolean"
        },
        "on_hand": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "On Hand"
        },
        "period_from_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Period From At",
          "type": "string"
        },
        "period_to_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Period To At",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "reserved_qty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reserved Qty"
        },
        "snapshot_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Snapshot At",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Available At"
        },
        "source_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Record Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "known",
            "not_available"
          ],
          "title": "Status",
          "type": "string"
        },
        "stock_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Stock Location Id",
          "type": "string"
        },
        "unit_of_measure": {
          "const": "pcs",
          "title": "Unit Of Measure",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "product_id",
        "stock_location_id",
        "business_date",
        "period_from_at",
        "period_to_at",
        "is_full_business_day",
        "snapshot_at",
        "as_of_time",
        "unit_of_measure",
        "on_hand",
        "reserved_qty",
        "available_qty",
        "status",
        "source_available_at",
        "curated_available_at",
        "source_record_sha256"
      ],
      "title": "NativeInventorySnapshot",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 2800,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "RiskRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "contract_type": {
          "const": "tool_request",
          "title": "Contract Type",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "const": "get_stockout_risk",
          "title": "Tool",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/DateWindow"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "scope",
        "as_of",
        "tool",
        "window"
      ],
      "title": "RiskRequest",
      "type": "object"
    },
    "RuntimeLineage": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^feature-partitions-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "source_completeness_status": {
          "enum": [
            "complete",
            "not_ready",
            "unavailable"
          ],
          "title": "Source Completeness Status",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "source_watermark": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark"
        },
        "upstream_bundle_id": {
          "pattern": "^upstream-partitions-sha256-[0-9a-f]{64}$",
          "title": "Upstream Bundle Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id",
        "feature_set_id",
        "upstream_bundle_id",
        "source_watermark",
        "source_completeness_status"
      ],
      "title": "RuntimeLineage",
      "type": "object"
    },
    "StockoutPriority": {
      "additionalProperties": false,
      "properties": {
        "capacity_slots": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capacity Slots"
        },
        "eligible_in_universe": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Eligible In Universe"
        },
        "other_scope_context": {
          "enum": [
            "visible_authorized",
            "withheld"
          ],
          "title": "Other Scope Context",
          "type": "string"
        },
        "rank_at_origin": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rank At Origin"
        },
        "selected_at_origin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected At Origin"
        },
        "universe": {
          "const": "complete_registered_profile_at_origin",
          "default": "complete_registered_profile_at_origin",
          "title": "Universe",
          "type": "string"
        },
        "universe_id": {
          "pattern": "^stockout-inputs-sha256-[0-9a-f]{64}$",
          "title": "Universe Id",
          "type": "string"
        },
        "version": {
          "const": "stockout-origin-priority-1.0.0",
          "default": "stockout-origin-priority-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "universe_id",
        "selected_at_origin",
        "rank_at_origin",
        "eligible_in_universe",
        "capacity_slots",
        "other_scope_context"
      ],
      "title": "StockoutPriority",
      "type": "object"
    },
    "StockoutRisk": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "calibrator_version": {
          "pattern": "^stockout-calibrator-sha256-[0-9a-f]{64}$",
          "title": "Calibrator Version",
          "type": "string"
        },
        "feature_lineage_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Lineage Sha256",
          "type": "string"
        },
        "freshness_reason": {
          "enum": [
            "source_watermark_unavailable",
            "origin_age_exceeded",
            "within_policy",
            "newer_run_unpublished"
          ],
          "title": "Freshness Reason",
          "type": "string"
        },
        "freshness_status": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "horizon_days": {
          "const": 7,
          "default": 7,
          "title": "Horizon Days",
          "type": "integer"
        },
        "inference_run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Inference Run Id",
          "type": "string"
        },
        "inventory_freshness_status": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Inventory Freshness Status",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/RuntimeLineage"
        },
        "max_origin_age_seconds": {
          "const": 86400,
          "default": 86400,
          "title": "Max Origin Age Seconds",
          "type": "integer"
        },
        "model_name": {
          "enum": [
            "retailops-stockout-risk",
            "retailops-stockout-risk-test-mechanics"
          ],
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,8}$",
          "title": "Model Version",
          "type": "string"
        },
        "origin_age_seconds": {
          "minimum": 0,
          "title": "Origin Age Seconds",
          "type": "number"
        },
        "output_age_seconds": {
          "minimum": 0,
          "title": "Output Age Seconds",
          "type": "number"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/StockoutPriority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probability"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "quality_status": {
          "enum": [
            "passed_at_publication",
            "mechanics_only"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "read_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Read At",
          "type": "string"
        },
        "release_id": {
          "pattern": "^stockout-release-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "risk_band": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk Band"
        },
        "risk_id": {
          "pattern": "^risk-sha256-[0-9a-f]{64}$",
          "title": "Risk Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "scored",
            "already_stockout",
            "insufficient_data",
            "stale_input"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_reason": {
          "anyOf": [
            {
              "enum": [
                "already_stockout",
                "inventory_unknown",
                "stale_inventory_snapshot",
                "inactive_or_unknown_product",
                "inactive_or_unknown_assortment_routing",
                "insufficient_sales_history"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Reason"
        },
        "stock_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Stock Location Id",
          "type": "string"
        },
        "threshold_version": {
          "pattern": "^stockout-scoring-policy-sha256-[0-9a-f]{64}$",
          "title": "Threshold Version",
          "type": "string"
        },
        "top_factors": {
          "items": {
            "$ref": "#/$defs/FactualFactor"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Top Factors",
          "type": "array"
        },
        "upstream_lineage_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream Lineage Sha256"
        }
      },
      "required": [
        "risk_id",
        "product_id",
        "stock_location_id",
        "as_of",
        "status",
        "status_reason",
        "probability",
        "risk_band",
        "threshold_version",
        "calibrator_version",
        "model_name",
        "model_version",
        "release_id",
        "top_factors",
        "inventory_freshness_status",
        "freshness_status",
        "lineage",
        "upstream_lineage_sha256",
        "feature_lineage_sha256",
        "inference_run_id",
        "generated_at",
        "quality_status",
        "read_at",
        "origin_age_seconds",
        "output_age_seconds",
        "freshness_reason"
      ],
      "title": "StockoutRisk",
      "type": "object"
    },
    "StockoutRiskPage": {
      "additionalProperties": false,
      "properties": {
        "data_status": {
          "enum": [
            "available",
            "no_data"
          ],
          "title": "Data Status",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/StockoutRisk"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "selection": {
          "enum": [
            "latest_per_product_stock",
            "origin",
            "inference_run"
          ],
          "title": "Selection",
          "type": "string"
        },
        "version": {
          "const": "stockout-risk-page-1.0.0",
          "default": "stockout-risk-page-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "view_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "View Sha256",
          "type": "string"
        }
      },
      "required": [
        "items",
        "pagination",
        "generated_at",
        "data_status",
        "selection",
        "view_sha256"
      ],
      "title": "StockoutRiskPage",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:native-stockout-evidence:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "enum": [
        "local",
        "test"
      ],
      "title": "Environment",
      "type": "string"
    },
    "evidence_version": {
      "const": "native-stockout-read-v1",
      "default": "native-stockout-read-v1",
      "title": "Evidence Version",
      "type": "string"
    },
    "inventory": {
      "$ref": "#/$defs/NativeInventoryEvidence"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/StockoutRiskPage"
        },
        {
          "type": "null"
        }
      ]
    },
    "request": {
      "$ref": "#/$defs/RiskRequest"
    }
  },
  "required": [
    "environment",
    "request",
    "inventory",
    "page"
  ],
  "title": "NativeRiskEvidence",
  "type": "object"
}
