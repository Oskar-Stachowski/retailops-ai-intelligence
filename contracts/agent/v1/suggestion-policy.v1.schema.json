{
  "$id": "urn:retailops:agent:suggestion-policy:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lifetime_seconds": {
      "default": 300,
      "maximum": 300,
      "minimum": 1,
      "title": "Lifetime Seconds",
      "type": "integer"
    },
    "max_candidates": {
      "default": 5,
      "maximum": 5,
      "minimum": 1,
      "title": "Max Candidates",
      "type": "integer"
    },
    "minimum_stockout_probability": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0.8,
      "title": "Minimum Stockout Probability",
      "type": "number"
    },
    "operations_lag_seconds": {
      "default": 60.0,
      "maximum": 3600,
      "minimum": 60,
      "title": "Operations Lag Seconds",
      "type": "number"
    },
    "policy_version": {
      "const": "read-only-review-v1",
      "default": "read-only-review-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "SuggestionPolicy",
  "type": "object"
}
