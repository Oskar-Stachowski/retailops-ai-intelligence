{
  "$defs": {
    "DataLineage": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id"
      ],
      "title": "DataLineage",
      "type": "object"
    },
    "ForecastFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "latest_complete_observation_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Complete Observation Date"
        },
        "max_observation_lag_days": {
          "const": 1,
          "default": 1,
          "title": "Max Observation Lag Days",
          "type": "integer"
        },
        "max_origin_age_seconds": {
          "const": 86400,
          "default": 86400,
          "title": "Max Origin Age Seconds",
          "type": "integer"
        },
        "max_source_watermark_origin_lag_seconds": {
          "const": 0,
          "default": 0,
          "title": "Max Source Watermark Origin Lag Seconds",
          "type": "integer"
        },
        "observation_lag_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Lag Days"
        },
        "origin_age_seconds": {
          "minimum": 0,
          "title": "Origin Age Seconds",
          "type": "number"
        },
        "policy_id": {
          "const": "forecast-read-v2",
          "default": "forecast-read-v2",
          "title": "Policy Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "source_watermark_unavailable",
            "source_watermark_policy_unsupported",
            "source_watermark_not_ready",
            "source_watermark_lag_exceeded",
            "source_observation_unavailable",
            "source_observation_lag_exceeded",
            "origin_age_exceeded",
            "newer_run_unpublished",
            "within_policy"
          ],
          "title": "Reason",
          "type": "string"
        },
        "source_completeness_status": {
          "enum": [
            "complete",
            "not_ready",
            "unavailable"
          ],
          "title": "Source Completeness Status",
          "type": "string"
        },
        "source_watermark": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark"
        },
        "source_watermark_age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark Age Seconds"
        },
        "source_watermark_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark As Of"
        },
        "source_watermark_origin_lag_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark Origin Lag Seconds"
        },
        "source_watermark_policy_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark Policy Version"
        },
        "status": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "source_watermark",
        "source_watermark_as_of",
        "source_watermark_policy_version",
        "source_completeness_status",
        "source_watermark_age_seconds",
        "source_watermark_origin_lag_seconds",
        "latest_complete_observation_date",
        "observation_lag_days",
        "evaluated_at",
        "origin_age_seconds"
      ],
      "title": "ForecastFreshness",
      "type": "object"
    },
    "ForecastKey": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days"
      ],
      "title": "ForecastKey",
      "type": "object"
    },
    "ForecastScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        },
        "target_from": {
          "format": "date",
          "title": "Target From",
          "type": "string"
        },
        "target_to": {
          "format": "date",
          "title": "Target To",
          "type": "string"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel",
        "target_from",
        "target_to"
      ],
      "title": "ForecastScope",
      "type": "object"
    },
    "ModelRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "contract_type": {
          "const": "model",
          "title": "Contract Type",
          "type": "string"
        },
        "feature_allowlist_version": {
          "const": "forecast-observed-sales-v1",
          "title": "Feature Allowlist Version",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "1.0",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "model_family": {
          "enum": [
            "baseline",
            "random_forest",
            "hist_gradient_boosting"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_id": {
          "pattern": "^model-sha256-[0-9a-f]{64}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_name": {
          "const": "retailops-demand-forecast",
          "title": "Model Name",
          "type": "string"
        },
        "model_seed": {
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Model Version",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        },
        "training_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Training Cutoff",
          "type": "string"
        },
        "training_lineage": {
          "$ref": "#/$defs/DataLineage"
        },
        "training_run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Training Run Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "model_id",
        "model_name",
        "model_version",
        "target_type",
        "feature_schema_version",
        "feature_allowlist_version",
        "model_family",
        "training_run_id",
        "training_lineage",
        "feature_set_id",
        "label_dataset_id",
        "split_id",
        "training_cutoff",
        "selection_cutoff",
        "model_seed",
        "artifact_sha256",
        "config_sha256",
        "provenance"
      ],
      "title": "ModelRecord",
      "type": "object"
    },
    "NativeForecastRead": {
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "const": "forecast_v12_tool_result",
          "default": "forecast_v12_tool_result",
          "title": "Contract Type",
          "type": "string"
        },
        "environment": {
          "enum": [
            "local",
            "test"
          ],
          "title": "Environment",
          "type": "string"
        },
        "page": {
          "$ref": "#/$defs/V12ForecastPage"
        },
        "request": {
          "$ref": "#/$defs/ToolRequest"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request",
        "environment",
        "page"
      ],
      "title": "NativeForecastRead",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 2800,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "PredictionInterval": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Calibration Version",
          "type": "string"
        },
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "method": {
          "const": "validation_residual_quantiles",
          "title": "Method",
          "type": "string"
        },
        "nominal_coverage": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Nominal Coverage",
          "type": "number"
        },
        "upper": {
          "minimum": 0,
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "nominal_coverage",
        "method",
        "calibration_version"
      ],
      "title": "PredictionInterval",
      "type": "object"
    },
    "PredictionRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "const": "prediction",
          "title": "Contract Type",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "freshness_status": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "inference_run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Inference Run Id",
          "type": "string"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictionInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "interval_reason": {
          "anyOf": [
            {
              "enum": [
                "not_calibrated",
                "insufficient_calibration"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interval Reason"
        },
        "key": {
          "$ref": "#/$defs/ForecastKey"
        },
        "lineage": {
          "$ref": "#/$defs/DataLineage"
        },
        "model": {
          "$ref": "#/$defs/ModelRecord"
        },
        "predicted_units": {
          "minimum": 0,
          "title": "Predicted Units",
          "type": "number"
        },
        "prediction_dataset_id": {
          "pattern": "^predictions-sha256-[0-9a-f]{64}$",
          "title": "Prediction Dataset Id",
          "type": "string"
        },
        "prediction_id": {
          "pattern": "^prediction-sha256-[0-9a-f]{64}$",
          "title": "Prediction Id",
          "type": "string"
        },
        "quality_status": {
          "enum": [
            "passed",
            "warning",
            "not_evaluable"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        },
        "unit_of_measure": {
          "const": "unit",
          "title": "Unit Of Measure",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "prediction_id",
        "prediction_dataset_id",
        "key",
        "target_type",
        "unit_of_measure",
        "predicted_units",
        "interval",
        "interval_reason",
        "lineage",
        "feature_set_id",
        "inference_run_id",
        "model",
        "release_id",
        "generated_at",
        "freshness_status",
        "quality_status"
      ],
      "title": "PredictionRecord",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "code_state": {
          "enum": [
            "clean",
            "dirty"
          ],
          "title": "Code State",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "dirty_patch_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty Patch Sha256"
        },
        "repository": {
          "enum": [
            "retailops-cloud-native-platform",
            "retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        },
        "transform_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Transform Version",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "code_state",
        "dirty_patch_sha256",
        "dependency_lock_sha256",
        "transform_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReadPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_outputs": {
          "const": 32,
          "default": 32,
          "title": "Max Candidate Outputs",
          "type": "integer"
        },
        "max_observation_lag_days": {
          "const": 1,
          "default": 1,
          "title": "Max Observation Lag Days",
          "type": "integer"
        },
        "max_origin_age_seconds": {
          "const": 86400,
          "default": 86400,
          "title": "Max Origin Age Seconds",
          "type": "integer"
        },
        "max_source_watermark_origin_lag_seconds": {
          "const": 0,
          "default": 0,
          "title": "Max Source Watermark Origin Lag Seconds",
          "type": "integer"
        },
        "policy_id": {
          "const": "forecast-read-v2",
          "default": "forecast-read-v2",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ReadPolicy",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_scope",
            "unauthorized",
            "unavailable",
            "stale",
            "not_found",
            "unsupported_grain",
            "budget_exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "description": {
          "enum": [
            "The requested scope is invalid.",
            "The requested scope is not authorized.",
            "The required source is unavailable.",
            "The requested source is stale.",
            "The requested output was not found.",
            "The requested grain is unsupported.",
            "The tool budget was exceeded."
          ],
          "title": "Description",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "description",
        "retryable"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ToolRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "contract_type": {
          "const": "tool_request",
          "title": "Contract Type",
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ForecastScope"
        },
        "tool": {
          "const": "get_demand_forecast",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "tool",
        "as_of",
        "scope",
        "limit"
      ],
      "title": "ToolRequest",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
