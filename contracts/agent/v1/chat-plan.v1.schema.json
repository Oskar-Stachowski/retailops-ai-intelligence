    "RetrievalFilters": {
      "additionalProperties": false,
      "properties": {
        "access_classes": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "public_project",
                  "project_internal",
                  "restricted"
                ],
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Classes"
        },
        "document_statuses": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "specified",
                  "implemented",
                  "verified",
                  "deprecated",
                  "historical"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Statuses"
        },
        "document_types": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "architecture",
                  "contract",
                  "guide",
                  "runbook",
                  "policy",
                  "plan",
                  "evidence",
                  "model_card"
                ],
                "type": "string"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Types"
        },
        "repositories": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "Oskar-Stachowski/retailops-cloud-native-platform",
                  "Oskar-Stachowski/retailops-ai-intelligence"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repositories"
        }
      },
      "title": "RetrievalFilters",
      "type": "object"
    },
    "RetrievalRequest": {
      "additionalProperties": false,
      "properties": {
        "filters": {
          "$ref": "#/$defs/RetrievalFilters"
        },
        "max_context_tokens": {
          "default": 6000,
          "maximum": 6000,
          "minimum": 1,
          "title": "Max Context Tokens",
          "type": "integer"
        },
        "purpose": {
          "default": "documentation",
          "enum": [
            "documentation",
            "implementation",
            "verified_state",
            "history"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "top_k": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "question"
      ],
      "title": "RetrievalRequest",
      "type": "object"
    },
