  "$id": "urn:retailops:agent:chat-plan:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "tool_plan",
      "title": "Kind",
      "type": "string"
    },
    "tools": {
      "items": {
        "discriminator": {
          "mapping": {
            "get_demand_forecast": "#/$defs/ToolRequest",
            "get_detected_anomalies": "#/$defs/AnomalyRequest",
            "get_inventory_status": "#/$defs/InventoryRequest",
            "get_live_operations": "#/$defs/OperationsRequest",
            "get_model_status": "#/$defs/ModelStatusRequest",
            "get_sales_summary": "#/$defs/SalesRequest",
            "get_stockout_risk": "#/$defs/RiskRequest",
            "search_knowledge": "#/$defs/KnowledgeRequest"
          },
          "propertyName": "tool"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SalesRequest"
          },
          {
            "$ref": "#/$defs/InventoryRequest"
          },
          {
            "$ref": "#/$defs/ToolRequest"
          },
          {
            "$ref": "#/$defs/RiskRequest"
          },
          {
            "$ref": "#/$defs/AnomalyRequest"
          },
          {
            "$ref": "#/$defs/OperationsRequest"
          },
          {
            "$ref": "#/$defs/ModelStatusRequest"
          },
          {
            "$ref": "#/$defs/KnowledgeRequest"
          }
        ]
      },
      "maxItems": 6,
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "tools"
  ],
  "title": "PlanDraft",
  "type": "object"
}
