          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        },
        "target_from": {
          "format": "date",
          "title": "Target From",
          "type": "string"
        },
        "target_to": {
          "format": "date",
          "title": "Target To",
          "type": "string"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel",
        "target_from",
        "target_to"
      ],
      "title": "ForecastScope",
      "type": "object"
    },
