{
  "$defs": {
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "DataScope",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:get_inventory_status:request:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "As Of",
      "type": "string"
    },
    "contract_type": {
      "const": "tool_request",
      "title": "Contract Type",
      "type": "string"
    },
    "limit": {
      "default": 20,
      "maximum": 50,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool": {
      "const": "get_inventory_status",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "scope",
    "as_of",
    "tool"
  ],
  "title": "InventoryRequest",
  "type": "object"
}
