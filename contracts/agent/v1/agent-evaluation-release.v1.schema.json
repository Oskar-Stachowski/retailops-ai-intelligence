{
  "$id": "urn:retailops:agent:agent-evaluation-release:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_scope": {
      "const": "canonical_fixture_invariants_only",
      "title": "Acceptance Scope",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "evaluator_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Sha256",
      "type": "string"
    },
    "fixture_only": {
      "const": true,
      "title": "Fixture Only",
      "type": "boolean"
    },
    "golden_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Golden Sha256",
      "type": "string"
    },
    "graph_config_id": {
      "pattern": "^agent-graph-config-sha256-[0-9a-f]{64}$",
      "title": "Graph Config Id",
      "type": "string"
    },
    "provider": {
      "const": "fake",
      "title": "Provider",
      "type": "string"
    },
    "release_id": {
      "pattern": "^agent-evaluation-release-sha256-[0-9a-f]{64}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "set_version": {
      "const": "agent-canonical-golden-v1",
      "title": "Set Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "graph_config_id",
    "golden_sha256",
    "evaluator_sha256",
    "dependency_lock_sha256",
    "set_version",
    "provider",
    "fixture_only",
    "acceptance_scope"
  ],
  "title": "AgentEvaluationRelease",
  "type": "object"
}
