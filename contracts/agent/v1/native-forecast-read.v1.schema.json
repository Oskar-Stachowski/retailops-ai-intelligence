{
  "$defs": {
    "ForecastFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "latest_complete_observation_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Complete Observation Date"
        },
        "max_observation_lag_days": {
          "const": 1,
          "default": 1,
          "title": "Max Observation Lag Days",
          "type": "integer"
        },
        "max_origin_age_seconds": {
          "const": 86400,
          "default": 86400,
          "title": "Max Origin Age Seconds",
          "type": "integer"
        },
        "max_source_watermark_origin_lag_seconds": {
          "const": 0,
          "default": 0,
          "title": "Max Source Watermark Origin Lag Seconds",
          "type": "integer"
        },
        "observation_lag_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Lag Days"
        },
        "origin_age_seconds": {
          "minimum": 0,
          "title": "Origin Age Seconds",
          "type": "number"
        },
        "policy_id": {
          "const": "forecast-read-v2",
          "default": "forecast-read-v2",
          "title": "Policy Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "source_watermark_unavailable",
            "source_watermark_policy_unsupported",
            "source_watermark_not_ready",
            "source_watermark_lag_exceeded",
            "source_observation_unavailable",
            "source_observation_lag_exceeded",
            "origin_age_exceeded",
            "newer_run_unpublished",
            "within_policy"
          ],
          "title": "Reason",
          "type": "string"
        },
        "source_completeness_status": {
          "enum": [
            "complete",
            "not_ready",
            "unavailable"
          ],
          "title": "Source Completeness Status",
          "type": "string"
        },
        "source_watermark": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark"
        },
        "source_watermark_age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark Age Seconds"
        },
        "source_watermark_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark As Of"
        },
        "source_watermark_origin_lag_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark Origin Lag Seconds"
        },
        "source_watermark_policy_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Watermark Policy Version"
        },
        "status": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "source_watermark",
        "source_watermark_as_of",
        "source_watermark_policy_version",
        "source_completeness_status",
        "source_watermark_age_seconds",
        "source_watermark_origin_lag_seconds",
        "latest_complete_observation_date",
        "observation_lag_days",
        "evaluated_at",
        "origin_age_seconds"
      ],
      "title": "ForecastFreshness",
      "type": "object"
    },
    "ForecastScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        },
        "target_from": {
          "format": "date",
          "title": "Target From",
          "type": "string"
        },
        "target_to": {
          "format": "date",
          "title": "Target To",
          "type": "string"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel",
        "target_from",
        "target_to"
      ],
      "title": "ForecastScope",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 2800,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "ReadPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_outputs": {
          "const": 32,
          "default": 32,
          "title": "Max Candidate Outputs",
          "type": "integer"
        },
        "max_observation_lag_days": {
          "const": 1,
          "default": 1,
          "title": "Max Observation Lag Days",
          "type": "integer"
        },
        "max_origin_age_seconds": {
          "const": 86400,
          "default": 86400,
          "title": "Max Origin Age Seconds",
          "type": "integer"
        },
        "max_source_watermark_origin_lag_seconds": {
          "const": 0,
          "default": 0,
          "title": "Max Source Watermark Origin Lag Seconds",
          "type": "integer"
        },
        "policy_id": {
          "const": "forecast-read-v2",
          "default": "forecast-read-v2",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.1",
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ReadPolicy",
      "type": "object"
    },
    "ToolRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "contract_type": {
          "const": "tool_request",
          "title": "Contract Type",
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ForecastScope"
        },
        "tool": {
          "const": "get_demand_forecast",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "tool",
        "as_of",
        "scope",
        "limit"
      ],
      "title": "ToolRequest",
      "type": "object"
    },
    "V12Forecast": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/V12Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "mean": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "median": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median"
        }
      },
      "required": [
        "median",
        "mean",
        "interval"
      ],
      "title": "V12Forecast",
      "type": "object"
    },
    "V12ForecastItem": {
      "additionalProperties": false,
      "properties": {
        "approval_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Sha256",
          "type": "string"
        },
        "approval_valid_until": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Approval Valid Until",
          "type": "string"
        },
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "execution_profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Execution Profile Id",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/ForecastFreshness"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "inference_run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Inference Run Id",
          "type": "string"
        },
        "model_name": {
          "enum": [
            "retailops-demand-forecast-v12",
            "retailops-demand-forecast-v12-mechanics",
            "retailops-demand-forecast-v12-development"
          ],
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Model Version",
          "type": "string"
        },
        "prediction": {
          "$ref": "#/$defs/V12Prediction"
        },
        "prediction_dataset_id": {
          "pattern": "^v12-forecasts-sha256-[0-9a-f]{64}$",
          "title": "Prediction Dataset Id",
          "type": "string"
        },
        "prediction_id": {
          "pattern": "^prediction-sha256-[0-9a-f]{64}$",
          "title": "Prediction Id",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "quality_status": {
          "const": "passed_at_publication",
          "default": "passed_at_publication",
          "title": "Quality Status",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^v12-computation-sha256-[0-9a-f]{64}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "release_id": {
          "pattern": "^v12-model-release-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "runtime_pin_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Pin Sha256",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "default": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        },
        "unit_of_measure": {
          "const": "unit",
          "default": "unit",
          "title": "Unit Of Measure",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days",
        "prediction",
        "execution_profile_id",
        "prediction_id",
        "prediction_dataset_id",
        "model_name",
        "model_version",
        "approval_sha256",
        "runtime_pin_sha256",
        "image_digest",
        "release_id",
        "receipt_id",
        "source_dataset_id",
        "curated_dataset_id",
        "feature_set_id",
        "inference_run_id",
        "profile_id",
        "generated_at",
        "approval_valid_until",
        "freshness"
      ],
      "title": "V12ForecastItem",
      "type": "object"
    },
    "V12ForecastPage": {
      "additionalProperties": false,
      "properties": {
        "data_status": {
          "enum": [
            "available",
            "no_data"
          ],
          "title": "Data Status",
          "type": "string"
        },
        "freshness_policy": {
          "$ref": "#/$defs/ReadPolicy",
          "default": {
            "max_candidate_outputs": 32,
            "max_observation_lag_days": 1,
            "max_origin_age_seconds": 86400,
            "max_source_watermark_origin_lag_seconds": 0,
            "policy_id": "forecast-read-v2",
            "schema_version": "1.1"
          }
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/V12ForecastItem"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "selection": {
          "enum": [
            "latest_per_series_horizon",
            "origin",
            "inference_run"
          ],
          "title": "Selection",
          "type": "string"
        },
        "version": {
          "const": "forecast-v12-read-page-1.0.0",
          "default": "forecast-v12-read-page-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "view_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "View Sha256",
          "type": "string"
        }
      },
      "required": [
        "items",
        "pagination",
        "generated_at",
        "data_status",
        "selection",
        "view_sha256"
      ],
      "title": "V12ForecastPage",
      "type": "object"
    },
    "V12Interval": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "minimum": 0,
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "V12Interval",
      "type": "object"
    },
    "V12Prediction": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/V12Forecast"
        },
        "candidate": {
          "$ref": "#/$defs/V12Forecast"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "const": "closed_target",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "key": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/V12PredictionMetadata"
        }
      },
      "required": [
        "key",
        "candidate",
        "baseline",
        "metadata"
      ],
      "title": "V12Prediction",
      "type": "object"
    },
    "V12PredictionMetadata": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "exact_reference_interval": {
          "const": true,
          "title": "Exact Reference Interval",
          "type": "boolean"
        },
        "exact_reference_median": {
          "const": true,
          "title": "Exact Reference Median",
          "type": "boolean"
        },
        "mean_source": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Mean Source",
          "type": "string"
        },
        "recipe_id": {
          "pattern": "^functional-v12-recipe-sha256-[0-9a-f]{64}$",
          "title": "Recipe Id",
          "type": "string"
        },
        "selected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected"
        }
      },
      "required": [
        "selected",
        "baseline",
        "mean_source",
        "exact_reference_median",
        "exact_reference_interval",
        "recipe_id"
      ],
      "title": "V12PredictionMetadata",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:native-forecast-read:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "forecast_v12_tool_result",
      "default": "forecast_v12_tool_result",
      "title": "Contract Type",
      "type": "string"
    },
    "environment": {
      "enum": [
        "local",
        "test"
      ],
      "title": "Environment",
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/V12ForecastPage"
    },
    "request": {
      "$ref": "#/$defs/ToolRequest"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request",
    "environment",
    "page"
  ],
  "title": "NativeForecastRead",
  "type": "object"
}
