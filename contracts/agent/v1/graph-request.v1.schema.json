{
  "$defs": {
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "DataScope",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:graph-request:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "As Of",
      "type": "string"
    },
    "comparison_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/DateWindow"
        },
        {
          "type": "null"
        }
      ]
    },
    "intent": {
      "enum": [
        "sales",
        "sales_comparison",
        "inventory",
        "forecast",
        "risk",
        "anomalies",
        "operations",
        "model",
        "documentation",
        "verified_state",
        "investigation",
        "refuse"
      ],
      "title": "Intent",
      "type": "string"
    },
    "limit": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/DataScope"
    },
    "window": {
      "$ref": "#/$defs/DateWindow"
    }
  },
  "required": [
    "schema_version",
    "question",
    "intent",
    "scope",
    "as_of",
    "window",
    "comparison_window"
  ],
  "title": "GraphRequest",
  "type": "object"
}
