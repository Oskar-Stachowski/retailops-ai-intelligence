{
  "$defs": {
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "DataScope",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "as_of": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "business_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Business Date",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online",
            "marketplace",
            "wholesale"
          ],
          "title": "Channel",
          "type": "string"
        },
        "currency": {
          "enum": [
            "PLN",
            "EUR"
          ],
          "title": "Currency",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "sale_completed",
            "return_completed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "missing_fact_keys": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fact Keys",
          "type": "array"
        },
        "observed_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Units"
        },
        "product_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Product Id",
          "type": "string"
        },
        "raw_dq_completeness": {
          "default": "not_qualified",
          "enum": [
            "qualified",
            "not_qualified"
          ],
          "title": "Raw Dq Completeness",
          "type": "string"
        },
        "rejected_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejected Units"
        },
        "score_eligible": {
          "default": false,
          "title": "Score Eligible",
          "type": "boolean"
        },
        "selling_location_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "no_declaration",
            "closure_unavailable",
            "source_incomplete",
            "location_closed",
            "dq_unattributed_quarantine",
            "dq_missing_facts",
            "qualified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "event_type",
        "business_date",
        "product_id",
        "selling_location_id",
        "channel",
        "currency",
        "as_of",
        "status"
      ],
      "title": "Point",
      "type": "object"
    },
    "QualifiedSalesEvidence": {
      "additionalProperties": false,
      "description": "Exact causal days and verified parents, retained with the accepted tool output.",
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "day_coverage_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Day Coverage Descriptor Sha256",
          "type": "string"
        },
        "day_coverage_id": {
          "pattern": "^day-coverage-sha256-[0-9a-f]{64}$",
          "title": "Day Coverage Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "local",
            "test"
          ],
          "title": "Environment",
          "type": "string"
        },
        "full_dq_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Full Dq Descriptor Sha256",
          "type": "string"
        },
        "full_dq_replay_id": {
          "pattern": "^full-dq-replay-sha256-[0-9a-f]{64}$",
          "title": "Full Dq Replay Id",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "qualification_runtime_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qualification Runtime Sha256",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/SalesRequest"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "version": {
          "const": "qualified-sales-days-v1",
          "default": "qualified-sales-days-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "request",
        "source_dataset_id",
        "curated_dataset_id",
        "full_dq_replay_id",
        "full_dq_descriptor_sha256",
        "day_coverage_id",
        "day_coverage_descriptor_sha256",
        "qualification_runtime_sha256",
        "points"
      ],
      "title": "QualifiedSalesEvidence",
      "type": "object"
    },
    "SalesItem": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "observed_sales_units": {
          "minimum": 0,
          "title": "Observed Sales Units",
          "type": "number"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "unit_of_measure": {
          "const": "unit",
          "title": "Unit Of Measure",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/DateWindow"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "window",
        "observed_sales_units",
        "unit_of_measure"
      ],
      "title": "SalesItem",
      "type": "object"
    },
    "SalesRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "contract_type": {
          "const": "tool_request",
          "title": "Contract Type",
          "type": "string"
        },
        "grain": {
          "const": "product_selling_location_channel_period",
          "title": "Grain",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "const": "get_sales_summary",
          "title": "Tool",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/DateWindow"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "scope",
        "as_of",
        "tool",
        "window",
        "grain"
      ],
      "title": "SalesRequest",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_scope",
            "unauthorized",
            "unavailable",
            "stale",
            "not_found",
            "unsupported_grain",
            "budget_exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "description": {
          "enum": [
            "The requested scope is invalid.",
            "The requested scope is not authorized.",
            "The required source is unavailable.",
            "The requested source is stale.",
            "The requested output was not found.",
            "The requested grain is unsupported.",
            "The tool budget was exceeded."
          ],
          "title": "Description",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "description",
        "retryable"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:get_sales_summary:result:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "As Of"
    },
    "contract_type": {
      "const": "agent_tool_result",
      "title": "Contract Type",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_status": {
      "enum": [
        "current",
        "stale",
        "missing",
        "unavailable"
      ],
      "title": "Freshness Status",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SalesItem"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "qualified_days": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualifiedSalesEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "fixture",
        "runtime"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "pattern": "^(?:[a-z][a-z0-9_-]{0,31}-sha256-[0-9a-f]{64}|fixture-[A-Za-z0-9_.-]{1,100})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Ref"
    },
    "status": {
      "enum": [
        "ok",
        "no_data",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool": {
      "const": "get_sales_summary",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "status",
    "as_of",
    "freshness_status",
    "source_ref",
    "items",
    "error",
    "source_kind",
    "tool"
  ],
  "title": "SalesResult",
  "type": "object"
}
