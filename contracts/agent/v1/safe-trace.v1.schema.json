{
  "$defs": {
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "DataScope",
      "type": "object"
    },
    "NodeAudit": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "invalid_scope",
                "unauthorized",
                "dependency_unavailable",
                "budget_exceeded",
                "deadline_exceeded",
                "provider_unavailable",
                "invalid_output",
                "invalid_evidence",
                "unauthorized_tool",
                "invalid_repair",
                "trace_unavailable",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "node": {
          "pattern": "^[a-z_]{1,32}$",
          "title": "Node",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "node",
        "status",
        "error_code",
        "duration_ms"
      ],
      "title": "NodeAudit",
      "type": "object"
    },
    "SafeToolAudit": {
      "additionalProperties": false,
      "properties": {
        "freshness_status": {
          "enum": [
            "current",
            "stale",
            "missing",
            "unavailable",
            "not_requested"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "name": {
          "pattern": "^get_[a-z_]+$|^search_knowledge$",
          "title": "Name",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "ok",
            "no_data",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "source_refs",
        "freshness_status"
      ],
      "title": "SafeToolAudit",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:safe-trace:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chat_config_id": {
      "pattern": "^agent-chat-config-sha256-[0-9a-f]{64}$",
      "title": "Chat Config Id",
      "type": "string"
    },
    "config_id": {
      "pattern": "^agent-graph-config-sha256-[0-9a-f]{64}$",
      "title": "Config Id",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^correlation-[0-9a-f]{32}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "invalid_scope",
            "unauthorized",
            "dependency_unavailable",
            "budget_exceeded",
            "deadline_exceeded",
            "provider_unavailable",
            "invalid_output",
            "invalid_evidence",
            "unauthorized_tool",
            "invalid_repair",
            "trace_unavailable",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "estimated_cost": {
      "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E-[0-9]+)?$",
      "title": "Estimated Cost",
      "type": "string"
    },
    "extra_evidence_rounds": {
      "maximum": 1,
      "minimum": 0,
      "title": "Extra Evidence Rounds",
      "type": "integer"
    },
    "fixture_only": {
      "title": "Fixture Only",
      "type": "boolean"
    },
    "index_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Index Id"
    },
    "input_tokens": {
      "maximum": 12000,
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model_calls": {
      "maximum": 6,
      "minimum": 0,
      "title": "Model Calls",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeAudit"
      },
      "maxItems": 20,
      "title": "Nodes",
      "type": "array"
    },
    "output_tokens": {
      "maximum": 1500,
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "owner_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Owner Id",
      "type": "string"
    },
    "release_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Release Refs",
      "type": "array"
    },
    "release_refs_total": {
      "minimum": 0,
      "title": "Release Refs Total",
      "type": "integer"
    },
    "repairs": {
      "maximum": 1,
      "minimum": 0,
      "title": "Repairs",
      "type": "integer"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/DataScope"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Source Refs",
      "type": "array"
    },
    "source_refs_total": {
      "minimum": 0,
      "title": "Source Refs Total",
      "type": "integer"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool_calls": {
      "maximum": 6,
      "minimum": 0,
      "title": "Tool Calls",
      "type": "integer"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/SafeToolAudit"
      },
      "maxItems": 6,
      "title": "Tools",
      "type": "array"
    },
    "trace_id": {
      "pattern": "^trace-[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trace_id",
    "correlation_id",
    "owner_id",
    "scope",
    "config_id",
    "chat_config_id",
    "request_sha256",
    "index_id",
    "release_refs",
    "source_refs",
    "release_refs_total",
    "source_refs_total",
    "status",
    "error_code",
    "nodes",
    "tool_calls",
    "model_calls",
    "extra_evidence_rounds",
    "repairs",
    "input_tokens",
    "output_tokens",
    "estimated_cost",
    "fixture_only",
    "created_at"
  ],
  "title": "SafeTrace",
  "type": "object"
}
