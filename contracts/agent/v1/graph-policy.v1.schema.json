{
  "$defs": {
    "DocumentEvidenceRule": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "enum": [
            "documentation",
            "verified_state"
          ],
          "title": "Intent",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/DocumentRequirement"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "question",
        "intent",
        "requirements"
      ],
      "title": "DocumentEvidenceRule",
      "type": "object"
    },
    "DocumentRequirement": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/DocumentSupport"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "description",
        "supports"
      ],
      "title": "DocumentRequirement",
      "type": "object"
    },
    "DocumentSupport": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "pattern": "^chunk-sha256-[0-9a-f]{64}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chunk Sha256",
          "type": "string"
        },
        "quote": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "chunk_sha256",
        "quote"
      ],
      "title": "DocumentSupport",
      "type": "object"
    },
    "SuggestionPolicy": {
      "additionalProperties": false,
      "properties": {
        "lifetime_seconds": {
          "default": 300,
          "maximum": 300,
          "minimum": 1,
          "title": "Lifetime Seconds",
          "type": "integer"
        },
        "max_candidates": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "minimum_stockout_probability": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0.8,
          "title": "Minimum Stockout Probability",
          "type": "number"
        },
        "native_stockout_review": {
          "default": false,
          "title": "Native Stockout Review",
          "type": "boolean"
        },
        "operations_lag_seconds": {
          "default": 60.0,
          "maximum": 3600,
          "minimum": 60,
          "title": "Operations Lag Seconds",
          "type": "number"
        },
        "policy_version": {
          "default": "read-only-review-v1",
          "enum": [
            "read-only-review-v1",
            "read-only-review-native-v2"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "SuggestionPolicy",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:graph-policy:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DocumentEvidenceRule"
      },
      "maxItems": 50,
      "title": "Document Rules",
      "type": "array"
    },
    "max_catalogue_facts": {
      "default": 40,
      "maximum": 40,
      "minimum": 5,
      "title": "Max Catalogue Facts",
      "type": "integer"
    },
    "max_extra_evidence_rounds": {
      "const": 1,
      "default": 1,
      "title": "Max Extra Evidence Rounds",
      "type": "integer"
    },
    "max_selected_facts": {
      "default": 5,
      "maximum": 5,
      "minimum": 1,
      "title": "Max Selected Facts",
      "type": "integer"
    },
    "max_steps": {
      "default": 20,
      "maximum": 20,
      "minimum": 15,
      "title": "Max Steps",
      "type": "integer"
    },
    "profile": {
      "const": "bounded-evidence-graph-v1",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suggestions": {
      "$ref": "#/$defs/SuggestionPolicy"
    },
    "trace_capacity": {
      "default": 100,
      "maximum": 100,
      "minimum": 1,
      "title": "Trace Capacity",
      "type": "integer"
    },
    "trace_retention_seconds": {
      "default": 900,
      "maximum": 900,
      "minimum": 1,
      "title": "Trace Retention Seconds",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "profile"
  ],
  "title": "GraphPolicy",
  "type": "object"
}
