{
  "$defs": {
    "ApprovedModelRelease": {
      "additionalProperties": false,
      "properties": {
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Model Version",
          "type": "string"
        },
        "release_id": {
          "pattern": "^(model-release|anomaly-release)-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "model_version",
        "image_digest"
      ],
      "title": "ApprovedModelRelease",
      "type": "object"
    },
    "CatalogFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason": {
          "const": "registry_and_runtime_not_observed",
          "default": "registry_and_runtime_not_observed",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_at"
      ],
      "title": "CatalogFreshness",
      "type": "object"
    },
    "CatalogModel": {
      "additionalProperties": false,
      "properties": {
        "approved_release": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovedModelRelease"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployed_model_version": {
          "default": null,
          "title": "Deployed Model Version",
          "type": "null"
        },
        "deployment_status": {
          "const": "not_attested",
          "default": "not_attested",
          "title": "Deployment Status",
          "type": "string"
        },
        "drift_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Drift Status",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/CatalogFreshness"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "model_name": {
          "default": "retailops-demand-forecast",
          "enum": [
            "retailops-demand-forecast",
            "retailops-sales-anomaly"
          ],
          "title": "Model Name",
          "type": "string"
        },
        "registry_aliases": {
          "default": null,
          "title": "Registry Aliases",
          "type": "null"
        },
        "visible_version_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Visible Version Count",
          "type": "integer"
        }
      },
      "required": [
        "visible_version_count",
        "approved_release",
        "freshness",
        "generated_at"
      ],
      "title": "CatalogModel",
      "type": "object"
    },
    "CatalogPagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "CatalogPagination",
      "type": "object"
    },
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "DataScope",
      "type": "object"
    },
    "ModelPage": {
      "additionalProperties": false,
      "properties": {
        "data_status": {
          "enum": [
            "available",
            "no_data"
          ],
          "title": "Data Status",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CatalogModel"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        },
        "pagination": {
          "$ref": "#/$defs/CatalogPagination"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "view_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "View Sha256",
          "type": "string"
        }
      },
      "required": [
        "items",
        "pagination",
        "generated_at",
        "data_status",
        "view_sha256"
      ],
      "title": "ModelPage",
      "type": "object"
    },
    "ModelStatusRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "contract_type": {
          "const": "tool_request",
          "title": "Contract Type",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "const": "get_model_status",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "scope",
        "as_of",
        "tool"
      ],
      "title": "ModelStatusRequest",
      "type": "object"
    },
    "V12ApprovedRelease": {
      "additionalProperties": false,
      "properties": {
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Model Version",
          "type": "string"
        },
        "release_id": {
          "pattern": "^v12-model-release-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "model_version",
        "image_digest"
      ],
      "title": "V12ApprovedRelease",
      "type": "object"
    },
    "V12CatalogModel": {
      "additionalProperties": false,
      "properties": {
        "approved_release": {
          "anyOf": [
            {
              "$ref": "#/$defs/V12ApprovedRelease"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployed_model_version": {
          "default": null,
          "title": "Deployed Model Version",
          "type": "null"
        },
        "deployment_status": {
          "const": "not_attested",
          "default": "not_attested",
          "title": "Deployment Status",
          "type": "string"
        },
        "drift_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Drift Status",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/CatalogFreshness"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "model_name": {
          "enum": [
            "retailops-demand-forecast-v12",
            "retailops-demand-forecast-v12-mechanics",
            "retailops-demand-forecast-v12-development"
          ],
          "title": "Model Name",
          "type": "string"
        },
        "registry_aliases": {
          "default": null,
          "title": "Registry Aliases",
          "type": "null"
        },
        "visible_version_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Visible Version Count",
          "type": "integer"
        }
      },
      "required": [
        "model_name",
        "visible_version_count",
        "approved_release",
        "freshness",
        "generated_at"
      ],
      "title": "V12CatalogModel",
      "type": "object"
    },
    "V12ModelPage": {
      "additionalProperties": false,
      "properties": {
        "data_status": {
          "enum": [
            "available",
            "no_data"
          ],
          "title": "Data Status",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/V12CatalogModel"
          },
          "maxItems": 200,
          "title": "Items",
          "type": "array"
        },
        "pagination": {
          "$ref": "#/$defs/CatalogPagination"
        },
        "version": {
          "const": "forecast-v12-model-page-1.0.0",
          "default": "forecast-v12-model-page-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "view_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "View Sha256",
          "type": "string"
        }
      },
      "required": [
        "items",
        "pagination",
        "generated_at",
        "data_status",
        "view_sha256"
      ],
      "title": "V12ModelPage",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:native-model-status-evidence:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anomaly": {
      "$ref": "#/$defs/ModelPage"
    },
    "covered_models": {
      "default": [
        "retailops-demand-forecast-v12",
        "retailops-sales-anomaly"
      ],
      "items": {
        "enum": [
          "retailops-demand-forecast-v12",
          "retailops-sales-anomaly"
        ],
        "type": "string"
      },
      "title": "Covered Models",
      "type": "array"
    },
    "environment": {
      "enum": [
        "local",
        "test"
      ],
      "title": "Environment",
      "type": "string"
    },
    "evidence_version": {
      "const": "native-model-status-read-v1",
      "default": "native-model-status-read-v1",
      "title": "Evidence Version",
      "type": "string"
    },
    "forecast": {
      "$ref": "#/$defs/V12ModelPage"
    },
    "request": {
      "$ref": "#/$defs/ModelStatusRequest"
    }
  },
  "required": [
    "environment",
    "request",
    "forecast",
    "anomaly"
  ],
  "title": "NativeModelStatusEvidence",
  "type": "object"
}
