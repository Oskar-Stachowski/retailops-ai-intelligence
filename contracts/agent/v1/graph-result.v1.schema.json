{
  "$defs": {
    "AnswerDraft": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/DraftCitation"
          },
          "maxItems": 5,
          "title": "Citations",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "data_freshness": {
          "$ref": "#/$defs/AnswerFreshness"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceClaim"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "const": "answer",
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Limitations",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "answered",
            "insufficient_evidence",
            "refused"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "recommended_actions": {
          "items": {
            "$ref": "#/$defs/DraftAction"
          },
          "maxItems": 5,
          "title": "Recommended Actions",
          "type": "array"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "outcome",
        "summary",
        "evidence",
        "recommended_actions",
        "confidence",
        "data_freshness",
        "citations",
        "limitations"
      ],
      "title": "AnswerDraft",
      "type": "object"
    },
    "AnswerFreshness": {
      "additionalProperties": false,
      "properties": {
        "inventory": {
          "$ref": "#/$defs/DomainFreshness"
        },
        "predictions": {
          "$ref": "#/$defs/DomainFreshness"
        },
        "sales": {
          "$ref": "#/$defs/DomainFreshness"
        }
      },
      "required": [
        "sales",
        "inventory",
        "predictions"
      ],
      "title": "AnswerFreshness",
      "type": "object"
    },
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "DataScope",
      "type": "object"
    },
    "DomainFreshness": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of"
        },
        "status": {
          "enum": [
            "current",
            "stale",
            "missing",
            "unavailable",
            "not_requested"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "as_of",
        "status"
      ],
      "title": "DomainFreshness",
      "type": "object"
    },
    "DraftAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "requires_human_review": {
          "const": true,
          "title": "Requires Human Review",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "priority",
        "rationale",
        "evidence_refs",
        "requires_human_review"
      ],
      "title": "DraftAction",
      "type": "object"
    },
    "DraftCitation": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "pattern": "^chunk-sha256-[0-9a-f]{64}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "document_status": {
          "enum": [
            "specified",
            "implemented",
            "verified",
            "deprecated",
            "historical"
          ],
          "title": "Document Status",
          "type": "string"
        },
        "heading": {
          "maxLength": 1200,
          "title": "Heading",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "enum": [
            "Oskar-Stachowski/retailops-cloud-native-platform",
            "Oskar-Stachowski/retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "heading",
        "chunk_id",
        "document_status",
        "source_ref"
      ],
      "title": "DraftCitation",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of"
        },
        "calculation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Id"
        },
        "claim": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "tool",
            "document",
            "calculation"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "supporting_refs": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Supporting Refs",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "source_type",
        "source_ref",
        "as_of",
        "supporting_refs"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "NodeAudit": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "invalid_scope",
                "unauthorized",
                "dependency_unavailable",
                "budget_exceeded",
                "deadline_exceeded",
                "provider_unavailable",
                "invalid_output",
                "invalid_evidence",
                "unauthorized_tool",
                "invalid_repair",
                "trace_unavailable",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "node": {
          "pattern": "^[a-z_]{1,32}$",
          "title": "Node",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "node",
        "status",
        "error_code",
        "duration_ms"
      ],
      "title": "NodeAudit",
      "type": "object"
    },
    "SafeToolAudit": {
      "additionalProperties": false,
      "properties": {
        "freshness_status": {
          "enum": [
            "current",
            "stale",
            "missing",
            "unavailable",
            "not_requested"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "name": {
          "pattern": "^get_[a-z_]+$|^search_knowledge$",
          "title": "Name",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "ok",
            "no_data",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "source_refs",
        "freshness_status"
      ],
      "title": "SafeToolAudit",
      "type": "object"
    },
    "SafeTrace": {
      "additionalProperties": false,
      "properties": {
        "chat_config_id": {
          "pattern": "^agent-chat-config-sha256-[0-9a-f]{64}$",
          "title": "Chat Config Id",
          "type": "string"
        },
        "config_id": {
          "pattern": "^agent-graph-config-sha256-[0-9a-f]{64}$",
          "title": "Config Id",
          "type": "string"
        },
        "correlation_id": {
          "pattern": "^correlation-[0-9a-f]{32}$",
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Created At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "invalid_scope",
                "unauthorized",
                "dependency_unavailable",
                "budget_exceeded",
                "deadline_exceeded",
                "provider_unavailable",
                "invalid_output",
                "invalid_evidence",
                "unauthorized_tool",
                "invalid_repair",
                "trace_unavailable",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "estimated_cost": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E-[0-9]+)?$",
          "title": "Estimated Cost",
          "type": "string"
        },
        "extra_evidence_rounds": {
          "maximum": 1,
          "minimum": 0,
          "title": "Extra Evidence Rounds",
          "type": "integer"
        },
        "fixture_only": {
          "title": "Fixture Only",
          "type": "boolean"
        },
        "index_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Index Id"
        },
        "input_tokens": {
          "maximum": 16000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_calls": {
          "maximum": 6,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeAudit"
          },
          "maxItems": 20,
          "title": "Nodes",
          "type": "array"
        },
        "output_tokens": {
          "maximum": 3000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "owner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Owner Id",
          "type": "string"
        },
        "release_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Release Refs",
          "type": "array"
        },
        "release_refs_total": {
          "minimum": 0,
          "title": "Release Refs Total",
          "type": "integer"
        },
        "repairs": {
          "maximum": 1,
          "minimum": 0,
          "title": "Repairs",
          "type": "integer"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/DataScope"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "source_refs_total": {
          "minimum": 0,
          "title": "Source Refs Total",
          "type": "integer"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_calls": {
          "maximum": 6,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/SafeToolAudit"
          },
          "maxItems": 6,
          "title": "Tools",
          "type": "array"
        },
        "trace_id": {
          "pattern": "^trace-[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "trace_id",
        "correlation_id",
        "owner_id",
        "scope",
        "config_id",
        "chat_config_id",
        "request_sha256",
        "index_id",
        "release_refs",
        "source_refs",
        "release_refs_total",
        "source_refs_total",
        "status",
        "error_code",
        "nodes",
        "tool_calls",
        "model_calls",
        "extra_evidence_rounds",
        "repairs",
        "input_tokens",
        "output_tokens",
        "estimated_cost",
        "fixture_only",
        "created_at"
      ],
      "title": "SafeTrace",
      "type": "object"
    },
    "SuggestionCandidate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^candidate-sha256-[0-9a-f]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Expires At",
          "type": "string"
        },
        "freshness_status": {
          "const": "current",
          "title": "Freshness Status",
          "type": "string"
        },
        "model_release_refs": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Model Release Refs",
          "type": "array"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "policy_version": {
          "const": "read-only-review-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommendation_type": {
          "enum": [
            "review_replenishment",
            "investigate_anomaly",
            "refresh_source_data"
          ],
          "title": "Recommendation Type",
          "type": "string"
        },
        "requires_human_review": {
          "const": true,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "source_as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Source As Of",
          "type": "string"
        },
        "status": {
          "const": "proposed",
          "title": "Status",
          "type": "string"
        },
        "stock_location_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stock Location Id"
        }
      },
      "required": [
        "candidate_id",
        "recommendation_type",
        "product_id",
        "selling_location_id",
        "stock_location_id",
        "channel",
        "action",
        "priority",
        "rationale",
        "evidence_refs",
        "model_release_refs",
        "policy_version",
        "policy_sha256",
        "source_as_of",
        "expires_at",
        "freshness_status",
        "requires_human_review",
        "status"
      ],
      "title": "SuggestionCandidate",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:graph-result:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "invalid_scope",
            "unauthorized",
            "dependency_unavailable",
            "budget_exceeded",
            "deadline_exceeded",
            "provider_unavailable",
            "invalid_output",
            "invalid_evidence",
            "unauthorized_tool",
            "invalid_repair",
            "trace_unavailable",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "suggestions": {
      "items": {
        "$ref": "#/$defs/SuggestionCandidate"
      },
      "maxItems": 5,
      "title": "Suggestions",
      "type": "array"
    },
    "trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafeTrace"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "error_code",
    "answer",
    "trace"
  ],
  "title": "GraphResult",
  "type": "object"
}
