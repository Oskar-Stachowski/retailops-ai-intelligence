{
  "$defs": {
    "CaseEvaluation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "estimated_cost": {
          "title": "Estimated Cost",
          "type": "string"
        },
        "failed_checks": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Failed Checks",
          "type": "array"
        },
        "input_tokens": {
          "maximum": 16000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_calls": {
          "maximum": 6,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 3000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "tool_calls": {
          "maximum": 6,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "critical",
        "passed",
        "failed_checks",
        "duration_ms",
        "tool_calls",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "estimated_cost"
      ],
      "title": "CaseEvaluation",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "passed",
        "total",
        "value"
      ],
      "title": "Rate",
      "type": "object"
    }
  },
  "$id": "urn:retailops:agent:agent-evaluation-report:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_scope": {
      "const": "canonical_fixture_invariants_only",
      "title": "Acceptance Scope",
      "type": "string"
    },
    "aws_executed": {
      "const": false,
      "title": "Aws Executed",
      "type": "boolean"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseEvaluation"
      },
      "maxItems": 50,
      "minItems": 30,
      "title": "Cases",
      "type": "array"
    },
    "estimated_cost_usd": {
      "title": "Estimated Cost Usd",
      "type": "string"
    },
    "evaluator_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Sha256",
      "type": "string"
    },
    "failed_gates": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
        "type": "string"
      },
      "title": "Failed Gates",
      "type": "array"
    },
    "fixture_only": {
      "const": true,
      "title": "Fixture Only",
      "type": "boolean"
    },
    "golden_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Golden Sha256",
      "type": "string"
    },
    "graph_config_id": {
      "title": "Graph Config Id",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "labels_state": {
      "const": "proposed",
      "title": "Labels State",
      "type": "string"
    },
    "latency_p95_ms": {
      "minimum": 0,
      "title": "Latency P95 Ms",
      "type": "number"
    },
    "metrics": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$": {
          "$ref": "#/$defs/Rate"
        }
      },
      "title": "Metrics",
      "type": "object"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "provider": {
      "const": "fake",
      "title": "Provider",
      "type": "string"
    },
    "rag_quality_remeasured": {
      "const": false,
      "title": "Rag Quality Remeasured",
      "type": "boolean"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "unnecessary_tool_calls": {
      "minimum": 0,
      "title": "Unnecessary Tool Calls",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "status",
    "release_id",
    "graph_config_id",
    "golden_sha256",
    "evaluator_sha256",
    "provider",
    "fixture_only",
    "aws_executed",
    "rag_quality_remeasured",
    "labels_state",
    "acceptance_scope",
    "metrics",
    "unnecessary_tool_calls",
    "latency_p95_ms",
    "input_tokens",
    "output_tokens",
    "estimated_cost_usd",
    "failed_gates",
    "cases"
  ],
  "title": "AgentEvaluationReport",
  "type": "object"
}
