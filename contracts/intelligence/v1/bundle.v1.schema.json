{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "byte_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Byte Sha256",
          "type": "string"
        },
        "classification": {
          "enum": [
            "facts",
            "simulation_truth",
            "raw_events",
            "source_operational_output",
            "curated",
            "features",
            "labels",
            "split",
            "predictions"
          ],
          "title": "Classification",
          "type": "string"
        },
        "date_field": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Date Field",
          "type": "string"
        },
        "date_from": {
          "format": "date",
          "title": "Date From",
          "type": "string"
        },
        "date_to": {
          "format": "date",
          "title": "Date To",
          "type": "string"
        },
        "grain": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Grain",
          "type": "array"
        },
        "logical_table": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Logical Table",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "byte_sha256",
        "size_bytes",
        "rows",
        "schema_version",
        "logical_table",
        "classification",
        "grain",
        "date_field",
        "date_from",
        "date_to"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "DataLineage": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id"
      ],
      "title": "DataLineage",
      "type": "object"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "classification": {
          "enum": [
            "facts",
            "simulation_truth",
            "raw_events",
            "source_operational_output",
            "curated",
            "features",
            "labels",
            "split",
            "predictions"
          ],
          "title": "Classification",
          "type": "string"
        },
        "contract_type": {
          "const": "dataset",
          "title": "Contract Type",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^(source|curated|features|labels|split|predictions)-sha256-[0-9a-f]{64}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/IdentityDescriptor"
        },
        "readiness": {
          "$ref": "#/$defs/ReadinessFlags"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "watermarks": {
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$": {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            }
          },
          "title": "Watermarks",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "dataset_id",
        "identity",
        "classification",
        "generated_at",
        "watermarks",
        "artifacts",
        "readiness"
      ],
      "title": "DatasetManifest",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "FeatureRecord": {
      "additionalProperties": false,
      "properties": {
        "allowlist_version": {
          "const": "forecast-observed-sales-v1",
          "title": "Allowlist Version",
          "type": "string"
        },
        "contract_type": {
          "const": "feature",
          "title": "Contract Type",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/ForecastKey"
        },
        "lineage": {
          "$ref": "#/$defs/DataLineage"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/FeatureValue"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "feature_set_id",
        "lineage",
        "key",
        "allowlist_version",
        "values"
      ],
      "title": "FeatureRecord",
      "type": "object"
    },
    "FeatureValue": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "anyOf": [
            {
              "enum": [
                "PLN",
                "EUR"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Date"
        },
        "kind": {
          "enum": [
            "observed",
            "known_plan",
            "calendar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "enum": [
            "lag_1_units",
            "rolling_mean_7_units",
            "target_weekday",
            "planned_price_minor_units",
            "planned_promotion"
          ],
          "title": "Name",
          "type": "string"
        },
        "observed_through_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Through Date"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "source_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Available At"
        },
        "source_class": {
          "enum": [
            "facts",
            "known_plan",
            "calendar"
          ],
          "title": "Source Class",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "kind",
        "source_class",
        "source_dataset_id",
        "status",
        "value",
        "source_available_at",
        "observed_through_date",
        "effective_date",
        "currency",
        "reason"
      ],
      "title": "FeatureValue",
      "type": "object"
    },
    "ForecastKey": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days"
      ],
      "title": "ForecastKey",
      "type": "object"
    },
    "ForecastScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        },
        "target_from": {
          "format": "date",
          "title": "Target From",
          "type": "string"
        },
        "target_to": {
          "format": "date",
          "title": "Target To",
          "type": "string"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel",
        "target_from",
        "target_to"
      ],
      "title": "ForecastScope",
      "type": "object"
    },
    "IdentityDescriptor": {
      "additionalProperties": false,
      "properties": {
        "canonicalization_version": {
          "const": "retailops-canonical-json-v1",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "classification": {
          "enum": [
            "facts",
            "simulation_truth",
            "raw_events",
            "source_operational_output",
            "curated",
            "features",
            "labels",
            "split",
            "predictions"
          ],
          "title": "Classification",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/SemanticConfig"
        },
        "logical_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Content Sha256",
          "type": "string"
        },
        "parents": {
          "$ref": "#/$defs/Parents"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "role": {
          "enum": [
            "source",
            "curated",
            "features",
            "labels",
            "split",
            "predictions"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "canonicalization_version",
        "role",
        "classification",
        "parents",
        "config",
        "provenance",
        "logical_content_sha256"
      ],
      "title": "IdentityDescriptor",
      "type": "object"
    },
    "JsonValue": {},
    "LabelRecord": {
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "const": "label",
          "title": "Contract Type",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/ForecastKey"
        },
        "label_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Available At"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/DataLineage"
        },
        "observed_sales_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Sales Units"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "incomplete_window",
                "missing_source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "eligible",
            "censored"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "label_dataset_id",
        "lineage",
        "key",
        "target_type",
        "status",
        "observed_sales_units",
        "label_available_at",
        "reason"
      ],
      "title": "LabelRecord",
      "type": "object"
    },
    "MLRunError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_input",
            "dependency_unavailable",
            "execution_failed",
            "cancelled"
          ],
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "title": "MLRunError",
      "type": "object"
    },
    "MLRunRecord": {
      "additionalProperties": false,
      "description": "Closed data bundles contain ML lineage; index runs use the shared standalone Run.",
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At"
        },
        "contract_type": {
          "const": "run",
          "title": "Contract Type",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/MLRunError"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_ref": {
          "$ref": "#/$defs/RunInput"
        },
        "output_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunOutput"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Requested At",
          "type": "string"
        },
        "requested_by": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Requested By",
          "type": "string"
        },
        "resolved_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "run_type": {
          "enum": [
            "training",
            "forecast_batch"
          ],
          "title": "Run Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "run_id",
        "run_type",
        "status",
        "attempt",
        "requested_at",
        "started_at",
        "completed_at",
        "requested_by",
        "input_ref",
        "resolved_model",
        "output_ref",
        "error"
      ],
      "title": "MLRunRecord",
      "type": "object"
    },
    "ModelRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "contract_type": {
          "const": "model",
          "title": "Contract Type",
          "type": "string"
        },
        "feature_allowlist_version": {
          "const": "forecast-observed-sales-v1",
          "title": "Feature Allowlist Version",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "1.0",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "model_family": {
          "enum": [
            "baseline",
            "random_forest",
            "hist_gradient_boosting"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_id": {
          "pattern": "^model-sha256-[0-9a-f]{64}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_name": {
          "const": "retailops-demand-forecast",
          "title": "Model Name",
          "type": "string"
        },
        "model_seed": {
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Model Version",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        },
        "training_cutoff": {
          "format": "date-time",
