{
  "$defs": {
    "DataLineage": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id"
      ],
      "title": "DataLineage",
      "type": "object"
    },
    "ForecastKey": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days"
      ],
      "title": "ForecastKey",
      "type": "object"
    },
    "ModelRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "contract_type": {
          "const": "model",
          "title": "Contract Type",
          "type": "string"
        },
        "feature_allowlist_version": {
          "const": "forecast-observed-sales-v1",
          "title": "Feature Allowlist Version",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "1.0",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "model_family": {
          "enum": [
            "baseline",
            "random_forest",
            "hist_gradient_boosting"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_id": {
          "pattern": "^model-sha256-[0-9a-f]{64}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_name": {
          "const": "retailops-demand-forecast",
          "title": "Model Name",
          "type": "string"
        },
        "model_seed": {
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Model Version",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        },
        "training_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Training Cutoff",
          "type": "string"
        },
        "training_lineage": {
          "$ref": "#/$defs/DataLineage"
        },
        "training_run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Training Run Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "model_id",
        "model_name",
        "model_version",
        "target_type",
        "feature_schema_version",
        "feature_allowlist_version",
        "model_family",
        "training_run_id",
        "training_lineage",
        "feature_set_id",
        "label_dataset_id",
        "split_id",
        "training_cutoff",
        "selection_cutoff",
        "model_seed",
        "artifact_sha256",
        "config_sha256",
        "provenance"
      ],
      "title": "ModelRecord",
      "type": "object"
    },
    "PredictionInterval": {
      "additionalProperties": false,
      "properties": {
        "calibration_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Calibration Version",
          "type": "string"
        },
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "method": {
          "const": "validation_residual_quantiles",
          "title": "Method",
          "type": "string"
        },
        "nominal_coverage": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Nominal Coverage",
          "type": "number"
        },
        "upper": {
          "minimum": 0,
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "nominal_coverage",
        "method",
        "calibration_version"
      ],
      "title": "PredictionInterval",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "code_state": {
          "enum": [
            "clean",
            "dirty"
          ],
          "title": "Code State",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "dirty_patch_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty Patch Sha256"
        },
        "repository": {
          "enum": [
            "retailops-cloud-native-platform",
            "retailops-ai-intelligence"
          ],
          "title": "Repository",
          "type": "string"
        },
        "transform_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Transform Version",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "code_state",
        "dirty_patch_sha256",
        "dependency_lock_sha256",
        "transform_version"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "urn:retailops:intelligence:prediction:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "prediction",
      "title": "Contract Type",
      "type": "string"
    },
    "feature_set_id": {
      "pattern": "^features-sha256-[0-9a-f]{64}$",
      "title": "Feature Set Id",
      "type": "string"
    },
    "freshness_status": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ],
      "title": "Freshness Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "inference_run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Inference Run Id",
      "type": "string"
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/PredictionInterval"
        },
        {
          "type": "null"
        }
      ]
    },
    "interval_reason": {
      "anyOf": [
        {
          "enum": [
            "not_calibrated",
            "insufficient_calibration"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interval Reason"
    },
    "key": {
      "$ref": "#/$defs/ForecastKey"
    },
    "lineage": {
      "$ref": "#/$defs/DataLineage"
    },
    "model": {
      "$ref": "#/$defs/ModelRecord"
    },
    "predicted_units": {
      "minimum": 0,
      "title": "Predicted Units",
      "type": "number"
    },
    "prediction_dataset_id": {
      "pattern": "^predictions-sha256-[0-9a-f]{64}$",
      "title": "Prediction Dataset Id",
      "type": "string"
    },
    "prediction_id": {
      "pattern": "^prediction-sha256-[0-9a-f]{64}$",
      "title": "Prediction Id",
      "type": "string"
    },
    "quality_status": {
      "enum": [
        "passed",
        "warning",
        "not_evaluable"
      ],
      "title": "Quality Status",
      "type": "string"
    },
    "release_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_type": {
      "const": "observed_sales_units",
      "title": "Target Type",
      "type": "string"
    },
    "unit_of_measure": {
      "const": "unit",
      "title": "Unit Of Measure",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "prediction_id",
    "prediction_dataset_id",
    "key",
    "target_type",
    "unit_of_measure",
    "predicted_units",
    "interval",
    "interval_reason",
    "lineage",
    "feature_set_id",
    "inference_run_id",
    "model",
    "release_id",
    "generated_at",
    "freshness_status",
    "quality_status"
  ],
  "title": "PredictionRecord",
  "type": "object"
}
