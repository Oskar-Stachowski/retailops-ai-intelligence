{
  "$defs": {
    "DataLineage": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id"
      ],
      "title": "DataLineage",
      "type": "object"
    },
    "ForecastKey": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days"
      ],
      "title": "ForecastKey",
      "type": "object"
    }
  },
  "$id": "urn:retailops:intelligence:label:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "label",
      "title": "Contract Type",
      "type": "string"
    },
    "key": {
      "$ref": "#/$defs/ForecastKey"
    },
    "label_available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Label Available At"
    },
    "label_dataset_id": {
      "pattern": "^labels-sha256-[0-9a-f]{64}$",
      "title": "Label Dataset Id",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/DataLineage"
    },
    "observed_sales_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Sales Units"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "incomplete_window",
            "missing_source"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "eligible",
        "censored"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_type": {
      "const": "observed_sales_units",
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "label_dataset_id",
    "lineage",
    "key",
    "target_type",
    "status",
    "observed_sales_units",
    "label_available_at",
    "reason"
  ],
  "title": "LabelRecord",
  "type": "object"
}
