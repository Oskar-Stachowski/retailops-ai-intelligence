{
  "components": {
    "schemas": {
      "AccessDecision": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "const": true,
            "default": true,
            "title": "Allowed",
            "type": "boolean"
          },
          "capability": {
            "const": "forecast:read",
            "default": "forecast:read",
            "title": "Capability",
            "type": "string"
          },
          "principal_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "title": "Principal Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/ForecastCheckRequest"
          }
        },
        "required": [
          "principal_id",
          "scope"
        ],
        "title": "AccessDecision",
        "type": "object"
      },
      "DependencyStatus": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "title": "Name",
            "type": "string"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "up",
              "down",
              "timeout"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "required",
          "status"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ForecastCheckRequest": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "enum": [
              "store",
              "online"
            ],
            "title": "Channel",
            "type": "string"
          },
          "product_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Product Ids",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "selling_location_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Selling Location Ids",
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "product_ids",
          "selling_location_ids",
          "channel"
        ],
        "title": "ForecastCheckRequest",
        "type": "object"
      },
      "IdentityResponse": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "forecast:read",
                "access:admin"
              ],
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "principal_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "title": "Principal Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "viewer",
                "operator",
                "admin"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResourceScope"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "principal_id",
          "roles",
          "capabilities",
          "scope"
        ],
        "title": "IdentityResponse",
        "type": "object"
      },
      "PolicyMetadata": {
        "additionalProperties": false,
        "properties": {
          "credential_count": {
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Credential Count",
            "type": "integer"
          },
          "policy_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "title": "Policy Id",
            "type": "string"
          },
          "principal_count": {
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Principal Count",
            "type": "integer"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "policy_id",
          "principal_count",
          "credential_count"
        ],
        "title": "PolicyMetadata",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "correlation_id": {
            "format": "uuid",
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "pattern": "^urn:uuid:[0-9a-f-]{36}$",
            "title": "Instance",
            "type": "string"
          },
          "readiness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ready"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "maximum": 599.0,
            "minimum": 400.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "const": "about:blank",
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "correlation_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Ready": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "role": {
            "default": "foundation",
            "enum": [
              "foundation",
              "ai_api"
            ],
            "title": "Role",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "degraded",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "Ready",
        "type": "object"
      },
      "ResourceScope": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "items": {
              "enum": [
                "store",
                "online"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Channels",
            "type": "array"
          },
          "product_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Product Ids",
            "type": "array"
          },
          "selling_location_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Selling Location Ids",
            "type": "array"
          }
        },
        "required": [
          "product_ids",
          "selling_location_ids",
          "channels"
        ],
        "title": "ResourceScope",
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RetailOps AI local access",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/access/forecast-check": {
      "post": {
        "operationId": "forecast_check_api_v1_access_forecast_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForecastCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessDecision"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "408": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Timeout"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "apiBearer": []
          }
        ],
        "summary": "Forecast Check"
      }
    },
