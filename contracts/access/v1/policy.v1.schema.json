{
  "$defs": {
    "AccessGrant": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "enum": [
              "forecast:read",
              "access:admin"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "principal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Principal Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "viewer",
              "operator",
              "admin"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "principal_id",
        "roles",
        "capabilities",
        "scope"
      ],
      "title": "AccessGrant",
      "type": "object"
    },
    "Credential": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Expires At",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Not Before",
          "type": "string"
        },
        "principal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Principal Id",
          "type": "string"
        },
        "revoked": {
          "title": "Revoked",
          "type": "boolean"
        },
        "token_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Token Sha256",
          "type": "string"
        }
      },
      "required": [
        "token_sha256",
        "principal_id",
        "not_before",
        "expires_at",
        "revoked"
      ],
      "title": "Credential",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "store",
              "online"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channels"
      ],
      "title": "ResourceScope",
      "type": "object"
    }
  },
  "$id": "urn:retailops:access:policy:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credentials": {
      "items": {
        "$ref": "#/$defs/Credential"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Credentials",
      "type": "array"
    },
    "grants": {
      "items": {
        "$ref": "#/$defs/AccessGrant"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Grants",
      "type": "array"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "grants",
    "credentials"
  ],
  "title": "AccessPolicy",
  "type": "object"
}
