{
  "$id": "urn:retailops:access:forecast-check:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "enum": [
        "store",
        "online"
      ],
      "title": "Channel",
      "type": "string"
    },
    "product_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Product Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selling_location_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Selling Location Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "product_ids",
    "selling_location_ids",
    "channel"
  ],
  "title": "ForecastCheckRequest",
  "type": "object"
}
