{
  "$defs": {
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "store",
              "online"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channels"
      ],
      "title": "ResourceScope",
      "type": "object"
    }
  },
  "$id": "urn:retailops:access:identity:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "enum": [
          "forecast:read",
          "access:admin"
        ],
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "principal_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Principal Id",
      "type": "string"
    },
    "roles": {
      "items": {
        "enum": [
          "viewer",
          "operator",
          "admin"
        ],
        "type": "string"
      },
      "title": "Roles",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceScope"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "principal_id",
    "roles",
    "capabilities",
    "scope"
  ],
  "title": "IdentityResponse",
  "type": "object"
}
