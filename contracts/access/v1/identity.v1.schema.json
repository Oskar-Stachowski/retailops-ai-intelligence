{
  "$defs": {
    "KnowledgeResourceScope": {
      "additionalProperties": false,
      "properties": {
        "access_classes": {
          "items": {
            "enum": [
              "public_project",
              "project_internal",
              "restricted"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Access Classes",
          "type": "array"
        },
        "document_statuses": {
          "items": {
            "enum": [
              "specified",
              "implemented",
              "verified",
              "deprecated",
              "historical"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Document Statuses",
          "type": "array"
        },
        "environment": {
          "enum": [
            "local",
            "test"
          ],
          "title": "Environment",
          "type": "string"
        },
        "repositories": {
          "items": {
            "enum": [
              "Oskar-Stachowski/retailops-cloud-native-platform",
              "Oskar-Stachowski/retailops-ai-intelligence"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Repositories",
          "type": "array"
        }
      },
      "required": [
        "environment",
        "repositories",
        "access_classes",
        "document_statuses"
      ],
      "title": "KnowledgeResourceScope",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "store",
              "online"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channels"
      ],
      "title": "ResourceScope",
      "type": "object"
    },
    "StockoutResourceScope": {
      "additionalProperties": false,
      "properties": {
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "stock_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Stock Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "stock_location_ids"
      ],
      "title": "StockoutResourceScope",
      "type": "object"
    }
  },
  "$id": "urn:retailops:access:identity:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "enum": [
          "forecast:read",
          "access:admin",
          "knowledge:read",
          "knowledge:index",
          "model:decide",
          "forecast:run",
          "stockout:read",
          "stockout:run"
        ],
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "knowledge_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeResourceScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "principal_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Principal Id",
      "type": "string"
    },
    "roles": {
      "items": {
        "enum": [
          "viewer",
          "operator",
          "admin",
          "promoter",
          "pipeline"
        ],
        "type": "string"
      },
      "title": "Roles",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "stockout_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/StockoutResourceScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "principal_id",
    "roles",
    "capabilities",
    "scope"
  ],
  "title": "IdentityResponse",
  "type": "object"
}
