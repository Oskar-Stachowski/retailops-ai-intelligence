{
  "$defs": {
    "AccessGrant": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "enum": [
              "forecast:read",
              "access:admin"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "principal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Principal Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "viewer",
              "operator",
              "admin"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "principal_id",
        "roles",
        "capabilities",
        "scope"
      ],
      "title": "AccessGrant",
      "type": "object"
    },
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "store",
              "online"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channels"
      ],
      "title": "ResourceScope",
      "type": "object"
    }
  },
  "$id": "urn:retailops:access:grant-template:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grants": {
      "items": {
        "$ref": "#/$defs/AccessGrant"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Grants",
      "type": "array"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "grants"
  ],
  "title": "GrantTemplate",
  "type": "object"
}
