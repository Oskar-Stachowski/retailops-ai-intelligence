{
  "$defs": {
    "BacktestCode": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelCode"
        },
        "version": {
          "const": "forecast-backtest-1.0.0",
          "default": "forecast-backtest-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "model"
      ],
      "title": "BacktestCode",
      "type": "object"
    },
    "BacktestDescriptor": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/BacktestCode"
        },
        "comparison_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Comparison Descriptor Sha256",
          "type": "string"
        },
        "comparison_id": {
          "pattern": "^forecast-model-comparison-sha256-[0-9a-f]{64}$",
          "title": "Comparison Id",
          "type": "string"
        },
        "comparison_status": {
          "enum": [
            "passed",
            "not_ready"
          ],
          "title": "Comparison Status",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "folds": {
          "items": {
            "$ref": "#/$defs/FoldAudit"
          },
          "title": "Folds",
          "type": "array"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "origin_window": {
          "$ref": "#/$defs/OriginWindow"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "policy": {
          "$ref": "#/$defs/BacktestPolicy"
        },
        "pooled_metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Pooled Metrics",
          "type": "object"
        },
        "resolved_split": {
          "$ref": "#/$defs/SplitPolicy"
        },
        "role": {
          "const": "chronological_development_backtest",
          "default": "chronological_development_backtest",
          "title": "Role",
          "type": "string"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "default": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "feature_set_id",
        "parent",
        "origin_window",
        "policy",
        "resolved_split",
        "split_id",
        "label_dataset_id",
        "comparison_id",
        "comparison_descriptor_sha256",
        "comparison_status",
        "code",
        "folds",
        "pooled_metrics",
        "status"
      ],
      "title": "BacktestDescriptor",
      "type": "object"
    },
    "BacktestPolicy": {
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "const": "pool_error_and_actual_sums_no_mean_of_wape",
          "default": "pool_error_and_actual_sums_no_mean_of_wape",
          "title": "Aggregate",
          "type": "string"
        },
        "anchoring": {
          "const": "calendar_start_unused_origins_retained_as_purged",
          "default": "calendar_start_unused_origins_retained_as_purged",
          "title": "Anchoring",
          "type": "string"
        },
        "development_holdout_days": {
          "default": 6,
          "maximum": 90,
          "minimum": 1,
          "title": "Development Holdout Days",
          "type": "integer"
        },
        "development_holdout_use": {
          "const": "diagnostic_previously_observed_data_not_fresh_final_test",
          "default": "diagnostic_previously_observed_data_not_fresh_final_test",
          "title": "Development Holdout Use",
          "type": "string"
        },
        "evaluation_overlap": {
          "const": "same_role_origins_must_not_repeat_across_folds",
          "default": "same_role_origins_must_not_repeat_across_folds",
          "title": "Evaluation Overlap",
          "type": "string"
        },
        "folds": {
          "default": 3,
          "maximum": 10,
          "minimum": 2,
          "title": "Folds",
          "type": "integer"
        },
        "history": {
          "const": "earlier_observations_allowed_as_of_each_origin",
          "default": "earlier_observations_allowed_as_of_each_origin",
          "title": "History",
          "type": "string"
        },
        "initial_train_days": {
          "default": 6,
          "maximum": 300,
          "minimum": 1,
          "title": "Initial Train Days",
          "type": "integer"
        },
        "label_tail_days": {
          "default": 15,
          "maximum": 90,
          "minimum": 15,
          "title": "Label Tail Days",
          "type": "integer"
        },
        "minimum_eligible_rows_per_role": {
          "default": 1,
          "maximum": 100000,
          "minimum": 1,
          "title": "Minimum Eligible Rows Per Role",
          "type": "integer"
        },
        "mode": {
          "default": "expanding",
          "enum": [
            "expanding",
            "rolling"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelPolicy",
          "default": {
            "baseline": {
              "candidates": [
                "last_observed",
                "moving_average",
                "seasonal_naive7"
              ],
              "closed_history": "confirmed_closed_zero_is_observed",
              "common_keys": "all_split_memberships_no_model_specific_drops",
              "incomplete_candidate": "not_ready_no_selection_no_partial_metrics",
              "missing_history": "skip_unknown_never_impute_zero",
              "moving_average_calendar_days": 7,
              "moving_average_minimum_known_days": 1,
              "origin_mode": "fixed_origin_no_recursive_actuals",
              "portfolio_final_test": "not_included_not_opened",
              "required_prediction_coverage": 1.0,
              "schema_version": "1.0.0",
              "seasonal_missing": "last_known_same_weekday_within_28_days_or_insufficient_data",
              "selection_metric": "mae",
              "selection_role": "validation_only_per_fold",
              "tie_break": "candidate_order"
            },
            "cpu_threads": 1,
            "fit_cpu_seconds": 90.0,
            "fit_rss_bytes": 1073741824,
            "fit_wall_seconds": 120.0,
            "grid": "one_frozen_configuration_per_family",
            "hgb": {
              "categorical_features": null,
              "early_stopping": false,
              "l2_regularization": 0.0,
              "learning_rate": 0.1,
              "loss": "squared_error",
              "max_bins": 255,
              "max_iter": 100,
              "max_leaf_nodes": 31,
              "min_samples_leaf": 20,
              "validation_fraction": null
            },
            "legacy_retailops_serving": "unchanged_rejection_not_overridden",
            "max_matrix_bytes": 67108864,
            "max_train_rows": 50000,
            "minimum_relative_improvement": 0.05,
            "monitor_interval_seconds": 0.05,
            "portfolio_final_test": "not_included_not_opened",
            "postprocessing": "clip_negative_to_zero_no_rounding",
            "primary_metric": "validation_mae",
            "random_state": 42,
            "rf": {
              "bootstrap": true,
              "criterion": "squared_error",
              "max_depth": 12,
              "max_features": 1.0,
              "min_samples_leaf": 2,
              "min_samples_split": 2,
              "n_estimators": 64,
              "n_jobs": 1
            },
            "schema_version": "1.0.0",
            "selection_use": "diagnostic_only_pending_04_6_to_04_8",
            "strategy": "direct_global_with_horizon_feature",
            "target_type": "observed_sales_units",
            "tie_break": "baseline_then_rf_then_hgb"
          }
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "purge_days": {
          "default": 15,
          "maximum": 90,
          "minimum": 15,
          "title": "Purge Days",
          "type": "integer"
        },
        "selection": {
          "const": "validation_only_independently_per_fold",
          "default": "validation_only_independently_per_fold",
          "title": "Selection",
          "type": "string"
        },
        "step_days": {
          "default": 6,
          "maximum": 90,
          "minimum": 1,
          "title": "Step Days",
          "type": "integer"
        },
        "validation_days": {
          "default": 6,
          "maximum": 90,
          "minimum": 1,
          "title": "Validation Days",
          "type": "integer"
        },
        "version": {
          "const": "forecast-chronological-backtest-1.0.0",
          "default": "forecast-chronological-backtest-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "BacktestPolicy",
      "type": "object"
    },
    "BaselinePolicy": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "default": [
            "last_observed",
            "moving_average",
            "seasonal_naive7"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "last_observed",
              "type": "string"
            },
            {
              "const": "moving_average",
              "type": "string"
            },
            {
              "const": "seasonal_naive7",
              "type": "string"
            }
          ],
          "title": "Candidates",
          "type": "array"
        },
        "closed_history": {
          "const": "confirmed_closed_zero_is_observed",
          "default": "confirmed_closed_zero_is_observed",
          "title": "Closed History",
          "type": "string"
        },
        "common_keys": {
          "const": "all_split_memberships_no_model_specific_drops",
          "default": "all_split_memberships_no_model_specific_drops",
          "title": "Common Keys",
          "type": "string"
        },
        "incomplete_candidate": {
          "const": "not_ready_no_selection_no_partial_metrics",
          "default": "not_ready_no_selection_no_partial_metrics",
          "title": "Incomplete Candidate",
          "type": "string"
        },
        "missing_history": {
          "const": "skip_unknown_never_impute_zero",
          "default": "skip_unknown_never_impute_zero",
          "title": "Missing History",
          "type": "string"
        },
        "moving_average_calendar_days": {
          "default": 7,
          "enum": [
            7,
            14,
            28
          ],
          "title": "Moving Average Calendar Days",
          "type": "integer"
        },
        "moving_average_minimum_known_days": {
          "default": 1,
          "maximum": 28,
          "minimum": 1,
          "title": "Moving Average Minimum Known Days",
          "type": "integer"
        },
        "origin_mode": {
          "const": "fixed_origin_no_recursive_actuals",
          "default": "fixed_origin_no_recursive_actuals",
          "title": "Origin Mode",
          "type": "string"
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "required_prediction_coverage": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 1,
          "title": "Required Prediction Coverage",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seasonal_missing": {
          "const": "last_known_same_weekday_within_28_days_or_insufficient_data",
          "default": "last_known_same_weekday_within_28_days_or_insufficient_data",
          "title": "Seasonal Missing",
          "type": "string"
        },
        "selection_metric": {
          "const": "mae",
          "default": "mae",
          "title": "Selection Metric",
          "type": "string"
        },
        "selection_role": {
          "const": "validation_only_per_fold",
          "default": "validation_only_per_fold",
          "title": "Selection Role",
          "type": "string"
        },
        "tie_break": {
          "const": "candidate_order",
          "default": "candidate_order",
          "title": "Tie Break",
          "type": "string"
        }
      },
      "title": "BaselinePolicy",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "FoldAudit": {
      "additionalProperties": false,
      "properties": {
        "common_grain_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Common Grain Sha256",
          "type": "string"
        },
        "common_prediction_keys": {
          "minimum": 1,
          "title": "Common Prediction Keys",
          "type": "integer"
        },
        "eligible_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Eligible Counts",
          "type": "object"
        },
        "eligible_train_rows": {
          "minimum": 1,
          "title": "Eligible Train Rows",
          "type": "integer"
        },
        "future_training_labels": {
          "const": 0,
          "default": 0,
          "title": "Future Training Labels",
          "type": "integer"
        },
        "latest_train_label_available_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Latest Train Label Available At",
          "type": "string"
        },
        "model_ids": {
          "additionalProperties": {
            "pattern": "^model-sha256-[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Model Ids",
          "type": "object"
        },
        "model_specific_key_drops": {
          "const": 0,
          "default": 0,
          "title": "Model Specific Key Drops",
          "type": "integer"
        },
        "plan": {
          "$ref": "#/$defs/FoldPlan"
        },
        "status": {
          "const": "passed",
          "default": "passed",
          "title": "Status",
          "type": "string"
        },
        "train_labels_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Train Labels Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "plan",
        "eligible_train_rows",
        "latest_train_label_available_at",
        "train_labels_content_sha256",
        "model_ids",
        "common_prediction_keys",
        "common_grain_sha256",
        "eligible_counts"
      ],
      "title": "FoldAudit",
      "type": "object"
    },
    "FoldPlan": {
      "additionalProperties": false,
      "properties": {
        "development_holdout": {
          "$ref": "#/$defs/DateWindow"
        },
        "evaluation_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluation Cutoff",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "purge_days": {
          "default": 15,
          "maximum": 90,
          "minimum": 14,
          "title": "Purge Days",
          "type": "integer"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "train": {
          "$ref": "#/$defs/DateWindow"
        },
        "training_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Training Cutoff",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/DateWindow"
        }
      },
      "required": [
        "name",
        "train",
        "validation",
        "development_holdout",
        "training_cutoff",
        "selection_cutoff",
        "evaluation_cutoff"
      ],
      "title": "FoldPlan",
      "type": "object"
    },
    "HGBConfig": {
      "additionalProperties": false,
      "properties": {
        "categorical_features": {
          "default": null,
          "title": "Categorical Features",
          "type": "null"
        },
        "early_stopping": {
          "const": false,
          "default": false,
          "title": "Early Stopping",
          "type": "boolean"
        },
        "l2_regularization": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "L2 Regularization",
          "type": "number"
        },
        "learning_rate": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Learning Rate",
          "type": "number"
        },
        "loss": {
          "const": "squared_error",
          "default": "squared_error",
          "title": "Loss",
          "type": "string"
        },
        "max_bins": {
          "const": 255,
          "default": 255,
          "title": "Max Bins",
          "type": "integer"
        },
        "max_iter": {
          "default": 100,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Iter",
          "type": "integer"
        },
        "max_leaf_nodes": {
          "default": 31,
          "maximum": 63,
          "minimum": 2,
          "title": "Max Leaf Nodes",
          "type": "integer"
        },
        "min_samples_leaf": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "validation_fraction": {
          "default": null,
          "title": "Validation Fraction",
          "type": "null"
        }
      },
      "title": "HGBConfig",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "absolute_actual_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Actual Sum"
        },
        "absolute_error_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Error Sum"
        },
        "eligible_rows": {
          "minimum": 0,
          "title": "Eligible Rows",
          "type": "integer"
        },
        "mae": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mae"
        },
        "predicted_rows": {
          "minimum": 0,
          "title": "Predicted Rows",
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "incomplete",
            "not_evaluable",
            "selection_not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "wape": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wape"
        },
        "wape_status": {
          "enum": [
            "passed",
            "zero_denominator",
            "incomplete",
            "no_rows",
            "selection_not_ready"
          ],
          "title": "Wape Status",
          "type": "string"
        }
      },
      "required": [
        "eligible_rows",
        "predicted_rows",
        "status",
        "mae",
        "wape",
        "absolute_error_sum",
        "absolute_actual_sum",
        "wape_status"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "ModelCode": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "machine": {
          "title": "Machine",
          "type": "string"
        },
        "system": {
          "title": "System",
          "type": "string"
        },
        "version": {
          "const": "forecast-models-1.0.0",
          "default": "forecast-models-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "dependency_lock_sha256",
        "versions",
        "system",
        "machine"
      ],
      "title": "ModelCode",
      "type": "object"
    },
    "ModelPolicy": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/BaselinePolicy",
          "default": {
            "candidates": [
              "last_observed",
              "moving_average",
              "seasonal_naive7"
            ],
            "closed_history": "confirmed_closed_zero_is_observed",
            "common_keys": "all_split_memberships_no_model_specific_drops",
            "incomplete_candidate": "not_ready_no_selection_no_partial_metrics",
            "missing_history": "skip_unknown_never_impute_zero",
            "moving_average_calendar_days": 7,
            "moving_average_minimum_known_days": 1,
            "origin_mode": "fixed_origin_no_recursive_actuals",
            "portfolio_final_test": "not_included_not_opened",
            "required_prediction_coverage": 1.0,
            "schema_version": "1.0.0",
