{
  "$defs": {
    "BaselinePolicy": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "default": [
            "last_observed",
            "moving_average",
            "seasonal_naive7"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "last_observed",
              "type": "string"
            },
            {
              "const": "moving_average",
              "type": "string"
            },
            {
              "const": "seasonal_naive7",
              "type": "string"
            }
          ],
          "title": "Candidates",
          "type": "array"
        },
        "closed_history": {
          "const": "confirmed_closed_zero_is_observed",
          "default": "confirmed_closed_zero_is_observed",
          "title": "Closed History",
          "type": "string"
        },
        "common_keys": {
          "const": "all_split_memberships_no_model_specific_drops",
          "default": "all_split_memberships_no_model_specific_drops",
          "title": "Common Keys",
          "type": "string"
        },
        "incomplete_candidate": {
          "const": "not_ready_no_selection_no_partial_metrics",
          "default": "not_ready_no_selection_no_partial_metrics",
          "title": "Incomplete Candidate",
          "type": "string"
        },
        "missing_history": {
          "const": "skip_unknown_never_impute_zero",
          "default": "skip_unknown_never_impute_zero",
          "title": "Missing History",
          "type": "string"
        },
        "moving_average_calendar_days": {
          "default": 7,
          "enum": [
            7,
            14,
            28
          ],
          "title": "Moving Average Calendar Days",
          "type": "integer"
        },
        "moving_average_minimum_known_days": {
          "default": 1,
          "maximum": 28,
          "minimum": 1,
          "title": "Moving Average Minimum Known Days",
          "type": "integer"
        },
        "origin_mode": {
          "const": "fixed_origin_no_recursive_actuals",
          "default": "fixed_origin_no_recursive_actuals",
          "title": "Origin Mode",
          "type": "string"
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "required_prediction_coverage": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 1,
          "title": "Required Prediction Coverage",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seasonal_missing": {
          "const": "last_known_same_weekday_within_28_days_or_insufficient_data",
          "default": "last_known_same_weekday_within_28_days_or_insufficient_data",
          "title": "Seasonal Missing",
          "type": "string"
        },
        "selection_metric": {
          "const": "mae",
          "default": "mae",
          "title": "Selection Metric",
          "type": "string"
        },
        "selection_role": {
          "const": "validation_only_per_fold",
          "default": "validation_only_per_fold",
          "title": "Selection Role",
          "type": "string"
        },
        "tie_break": {
          "const": "candidate_order",
          "default": "candidate_order",
          "title": "Tie Break",
          "type": "string"
        }
      },
      "title": "BaselinePolicy",
      "type": "object"
    },
    "FileReceipt": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "row_count": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 2147483648,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "row_count"
      ],
      "title": "FileReceipt",
      "type": "object"
    },
    "HGBConfig": {
      "additionalProperties": false,
      "properties": {
        "categorical_features": {
          "default": null,
          "title": "Categorical Features",
          "type": "null"
        },
        "early_stopping": {
          "const": false,
          "default": false,
          "title": "Early Stopping",
          "type": "boolean"
        },
        "l2_regularization": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "L2 Regularization",
          "type": "number"
        },
        "learning_rate": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Learning Rate",
          "type": "number"
        },
        "loss": {
          "const": "squared_error",
          "default": "squared_error",
          "title": "Loss",
          "type": "string"
        },
        "max_bins": {
          "const": 255,
          "default": 255,
          "title": "Max Bins",
          "type": "integer"
        },
        "max_iter": {
          "default": 100,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Iter",
          "type": "integer"
        },
        "max_leaf_nodes": {
          "default": 31,
          "maximum": 63,
          "minimum": 2,
          "title": "Max Leaf Nodes",
          "type": "integer"
        },
        "min_samples_leaf": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "validation_fraction": {
          "default": null,
          "title": "Validation Fraction",
          "type": "null"
        }
      },
      "title": "HGBConfig",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "absolute_actual_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Actual Sum"
        },
        "absolute_error_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Error Sum"
        },
        "eligible_rows": {
          "minimum": 0,
          "title": "Eligible Rows",
          "type": "integer"
        },
        "mae": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mae"
        },
        "predicted_rows": {
          "minimum": 0,
          "title": "Predicted Rows",
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "incomplete",
            "not_evaluable",
            "selection_not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "wape": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wape"
        },
        "wape_status": {
          "enum": [
            "passed",
            "zero_denominator",
            "incomplete",
            "no_rows",
            "selection_not_ready"
          ],
          "title": "Wape Status",
          "type": "string"
        }
      },
      "required": [
        "eligible_rows",
        "predicted_rows",
        "status",
        "mae",
        "wape",
        "absolute_error_sum",
        "absolute_actual_sum",
        "wape_status"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "ModelCode": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "machine": {
          "title": "Machine",
          "type": "string"
        },
        "system": {
          "title": "System",
          "type": "string"
        },
        "version": {
          "const": "forecast-models-1.0.0",
          "default": "forecast-models-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "dependency_lock_sha256",
        "versions",
        "system",
        "machine"
      ],
      "title": "ModelCode",
      "type": "object"
    },
    "ModelPolicy": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/BaselinePolicy",
          "default": {
            "candidates": [
              "last_observed",
              "moving_average",
              "seasonal_naive7"
            ],
            "closed_history": "confirmed_closed_zero_is_observed",
            "common_keys": "all_split_memberships_no_model_specific_drops",
            "incomplete_candidate": "not_ready_no_selection_no_partial_metrics",
            "missing_history": "skip_unknown_never_impute_zero",
            "moving_average_calendar_days": 7,
            "moving_average_minimum_known_days": 1,
            "origin_mode": "fixed_origin_no_recursive_actuals",
            "portfolio_final_test": "not_included_not_opened",
            "required_prediction_coverage": 1.0,
            "schema_version": "1.0.0",
            "seasonal_missing": "last_known_same_weekday_within_28_days_or_insufficient_data",
            "selection_metric": "mae",
            "selection_role": "validation_only_per_fold",
            "tie_break": "candidate_order"
          }
        },
        "cpu_threads": {
          "const": 1,
          "default": 1,
          "title": "Cpu Threads",
          "type": "integer"
        },
        "fit_cpu_seconds": {
          "default": 90.0,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Fit Cpu Seconds",
          "type": "number"
        },
        "fit_rss_bytes": {
          "default": 1073741824,
          "maximum": 2147483648,
          "minimum": 1048576,
          "title": "Fit Rss Bytes",
          "type": "integer"
        },
        "fit_wall_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Fit Wall Seconds",
          "type": "number"
        },
        "grid": {
          "const": "one_frozen_configuration_per_family",
          "default": "one_frozen_configuration_per_family",
          "title": "Grid",
          "type": "string"
        },
        "hgb": {
          "$ref": "#/$defs/HGBConfig",
          "default": {
            "categorical_features": null,
            "early_stopping": false,
            "l2_regularization": 0.0,
            "learning_rate": 0.1,
            "loss": "squared_error",
            "max_bins": 255,
            "max_iter": 100,
            "max_leaf_nodes": 31,
            "min_samples_leaf": 20,
            "validation_fraction": null
          }
        },
        "legacy_retailops_serving": {
          "const": "unchanged_rejection_not_overridden",
          "default": "unchanged_rejection_not_overridden",
          "title": "Legacy Retailops Serving",
          "type": "string"
        },
        "max_matrix_bytes": {
          "default": 67108864,
          "maximum": 134217728,
          "minimum": 1024,
          "title": "Max Matrix Bytes",
          "type": "integer"
        },
        "max_train_rows": {
          "default": 50000,
          "maximum": 50000,
          "minimum": 1,
          "title": "Max Train Rows",
          "type": "integer"
        },
        "minimum_relative_improvement": {
          "default": 0.05,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Minimum Relative Improvement",
          "type": "number"
        },
        "monitor_interval_seconds": {
          "default": 0.05,
          "maximum": 0.05,
          "minimum": 0.05,
          "title": "Monitor Interval Seconds",
          "type": "number"
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "postprocessing": {
          "const": "clip_negative_to_zero_no_rounding",
          "default": "clip_negative_to_zero_no_rounding",
          "title": "Postprocessing",
          "type": "string"
        },
        "primary_metric": {
          "const": "validation_mae",
          "default": "validation_mae",
          "title": "Primary Metric",
          "type": "string"
        },
        "random_state": {
          "default": 42,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Random State",
          "type": "integer"
        },
        "rf": {
          "$ref": "#/$defs/RFConfig",
          "default": {
            "bootstrap": true,
            "criterion": "squared_error",
            "max_depth": 12,
            "max_features": 1.0,
            "min_samples_leaf": 2,
            "min_samples_split": 2,
            "n_estimators": 64,
            "n_jobs": 1
          }
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_use": {
          "const": "diagnostic_only_pending_04_6_to_04_8",
          "default": "diagnostic_only_pending_04_6_to_04_8",
          "title": "Selection Use",
          "type": "string"
        },
        "strategy": {
          "const": "direct_global_with_horizon_feature",
          "default": "direct_global_with_horizon_feature",
          "title": "Strategy",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "default": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        },
        "tie_break": {
          "const": "baseline_then_rf_then_hgb",
          "default": "baseline_then_rf_then_hgb",
          "title": "Tie Break",
          "type": "string"
        }
      },
      "title": "ModelPolicy",
      "type": "object"
    },
    "ModelRunDescriptor": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ModelCode"
        },
        "coverage_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Coverage Counts",
          "type": "object"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Metrics",
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "pattern": "^model-sha256-[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Models",
          "type": "object"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "policy": {
          "$ref": "#/$defs/ModelPolicy"
        },
        "prediction_rows": {
          "minimum": 1,
          "title": "Prediction Rows",
          "type": "integer"
        },
        "predictions_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Predictions Content Sha256",
          "type": "string"
        },
        "role": {
          "const": "supervised_model_comparison",
          "default": "supervised_model_comparison",
          "title": "Role",
          "type": "string"
        },
        "selections": {
          "items": {
            "$ref": "#/$defs/ModelSelection"
          },
          "title": "Selections",
          "type": "array"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "feature_set_id",
        "split_id",
        "parent",
        "label_dataset_id",
        "policy",
        "code",
        "models",
        "predictions_content_sha256",
        "prediction_rows",
        "coverage_counts",
        "selections",
        "metrics",
        "status"
      ],
      "title": "ModelRunDescriptor",
      "type": "object"
    },
    "ModelSelection": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "enum": [
                "last_observed",
                "moving_average",
                "seasonal_naive7"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "fold": {
          "title": "Fold",
          "type": "string"
        },
        "selected": {
          "anyOf": [
            {
              "enum": [
                "last_observed",
                "moving_average",
                "seasonal_naive7"
              ],
              "type": "string"
            },
            {
              "enum": [
                "random_forest",
                "hist_gradient_boosting"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected"
        },
        "selection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "selected",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation_grain_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Grain Sha256",
          "type": "string"
        },
        "validation_metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Validation Metrics",
          "type": "object"
        }
      },
      "required": [
        "fold",
        "baseline",
        "selected",
        "status",
        "validation_grain_sha256",
        "validation_metrics",
        "selection_sha256"
      ],
      "title": "ModelSelection",
      "type": "object"
    },
    "Parent": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "curated_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Curated Descriptor Sha256",
          "type": "string"
        },
        "forecast_source_status": {
          "const": "passed",
          "title": "Forecast Source Status",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snapshot-sha256-[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id",
        "snapshot_id",
        "curated_descriptor_sha256",
        "business_timezone",
        "forecast_source_status"
      ],
      "title": "Parent",
      "type": "object"
    },
    "RFConfig": {
      "additionalProperties": false,
      "properties": {
        "bootstrap": {
          "const": true,
          "default": true,
          "title": "Bootstrap",
          "type": "boolean"
        },
        "criterion": {
          "const": "squared_error",
          "default": "squared_error",
          "title": "Criterion",
          "type": "string"
        },
        "max_depth": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_features": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Features",
          "type": "number"
        },
        "min_samples_leaf": {
          "default": 2,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "min_samples_split": {
          "default": 2,
          "maximum": 200,
          "minimum": 2,
          "title": "Min Samples Split",
          "type": "integer"
        },
        "n_estimators": {
          "default": 64,
          "maximum": 128,
          "minimum": 1,
          "title": "N Estimators",
          "type": "integer"
        },
        "n_jobs": {
          "const": 1,
          "default": 1,
          "title": "N Jobs",
          "type": "integer"
        }
      },
      "title": "RFConfig",
      "type": "object"
    },
    "ResourceReceipt": {
      "additionalProperties": false,
      "properties": {
        "cpu_seconds": {
          "minimum": 0,
          "title": "Cpu Seconds",
          "type": "number"
        },
        "peak_rss_bytes": {
          "minimum": 0,
          "title": "Peak Rss Bytes",
          "type": "integer"
        },
        "status": {
          "const": "passed",
          "default": "passed",
          "title": "Status",
          "type": "string"
        },
        "threads": {
          "const": 1,
          "default": 1,
          "title": "Threads",
          "type": "integer"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "wall_seconds",
        "cpu_seconds",
        "peak_rss_bytes"
      ],
      "title": "ResourceReceipt",
      "type": "object"
    },
    "TableReceipt": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileReceipt"
          },
          "maxItems": 10000,
          "title": "Files",
          "type": "array"
        },
        "row_count": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "content_sha256",
        "row_count",
        "files"
      ],
      "title": "TableReceipt",
      "type": "object"
    }
  },
  "$id": "urn:retailops:forecast:model_comparison:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparison_id": {
