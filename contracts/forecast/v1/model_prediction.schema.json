{
  "$id": "urn:retailops:forecast:model_prediction:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "business_timezone": {
      "const": "UTC",
      "title": "Business Timezone",
      "type": "string"
    },
    "channel": {
      "enum": [
        "store",
        "online"
      ],
      "title": "Channel",
      "type": "string"
    },
    "cutoff_policy": {
      "const": "end_of_day_second_v1",
      "title": "Cutoff Policy",
      "type": "string"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "exclusion_reasons": {
      "items": {
        "enum": [
          "purged_origin",
          "insufficient_history",
          "stale_history",
          "unknown_calendar",
          "closed_target",
          "censored_label"
        ],
        "type": "string"
      },
      "title": "Exclusion Reasons",
      "type": "array"
    },
    "fold": {
      "title": "Fold",
      "type": "string"
    },
    "forecast_origin": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Forecast Origin",
      "type": "string"
    },
    "horizon_days": {
      "maximum": 14,
      "minimum": 1,
      "title": "Horizon Days",
      "type": "integer"
    },
    "model": {
      "enum": [
        "random_forest",
        "hist_gradient_boosting"
      ],
      "title": "Model",
      "type": "string"
    },
    "model_id": {
      "pattern": "^model-sha256-[0-9a-f]{64}$",
      "title": "Model Id",
      "type": "string"
    },
    "predicted_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Predicted Units"
    },
    "prediction_kind": {
      "enum": [
        "in_sample_diagnostic",
        "out_of_time_diagnostic",
        "excluded"
      ],
      "title": "Prediction Kind",
      "type": "string"
    },
    "product_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Product Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "train",
        "validation",
        "development_holdout",
        "purged"
      ],
      "title": "Role",
      "type": "string"
    },
    "selling_location_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Selling Location Id",
      "type": "string"
    },
    "target_date": {
      "format": "date",
      "title": "Target Date",
      "type": "string"
    },
    "target_type": {
      "const": "observed_sales_units",
      "default": "observed_sales_units",
      "title": "Target Type",
      "type": "string"
    },
    "training_knowledge_cutoff": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Training Knowledge Cutoff",
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "selling_location_id",
    "channel",
    "forecast_origin",
    "business_timezone",
    "cutoff_policy",
    "target_date",
    "horizon_days",
    "fold",
    "role",
    "model",
    "model_id",
    "eligible",
    "exclusion_reasons",
    "predicted_units",
    "prediction_kind",
    "training_knowledge_cutoff"
  ],
  "title": "ModelPrediction",
  "type": "object"
}
