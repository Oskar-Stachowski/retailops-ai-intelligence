{
  "$id": "urn:retailops:forecast:quality_policy:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_fallback": {
      "const": "retain_validation_baseline_without_improvement_requirement",
      "default": "retain_validation_baseline_without_improvement_requirement",
      "title": "Baseline Fallback",
      "type": "string"
    },
    "critical_dimensions": {
      "default": [
        "horizon",
        "category",
        "channel",
        "volume"
      ],
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "horizon",
          "type": "string"
        },
        {
          "const": "category",
          "type": "string"
        },
        {
          "const": "channel",
          "type": "string"
        },
        {
          "const": "volume",
          "type": "string"
        }
      ],
      "title": "Critical Dimensions",
      "type": "array"
    },
    "interval_lower_bound": {
      "const": "clip_at_zero_observed_sales_nonnegative",
      "default": "clip_at_zero_observed_sales_nonnegative",
      "title": "Interval Lower Bound",
      "type": "string"
    },
    "intervals": {
      "const": "per_fold_method_horizon_absolute_validation_residual_quantile",
      "default": "per_fold_method_horizon_absolute_validation_residual_quantile",
      "title": "Intervals",
      "type": "string"
    },
    "inventory_segments": {
      "const": "deferred_until_verified_inventory_after_ai06",
      "default": "deferred_until_verified_inventory_after_ai06",
      "title": "Inventory Segments",
      "type": "string"
    },
    "low_volume_upper_exclusive": {
      "default": 5.0,
      "exclusiveMinimum": 0,
      "title": "Low Volume Upper Exclusive",
      "type": "number"
    },
    "mape": {
      "const": "positive_actuals_only_diagnostic_with_coverage",
      "default": "positive_actuals_only_diagnostic_with_coverage",
      "title": "Mape",
      "type": "string"
    },
    "max_groups": {
      "default": 4000,
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Groups",
      "type": "integer"
    },
    "maximum_absolute_normalized_bias": {
      "default": 0.1,
      "maximum": 1,
      "minimum": 0,
      "title": "Maximum Absolute Normalized Bias",
      "type": "number"
    },
    "maximum_critical_segment_relative_regression": {
      "default": 0.1,
      "minimum": 0,
      "title": "Maximum Critical Segment Relative Regression",
      "type": "number"
    },
    "maximum_mean_width_to_mean_actual": {
      "default": 2.0,
      "exclusiveMinimum": 0,
      "title": "Maximum Mean Width To Mean Actual",
      "type": "number"
    },
    "medium_volume_upper_exclusive": {
      "default": 20.0,
      "exclusiveMinimum": 0,
      "title": "Medium Volume Upper Exclusive",
      "type": "number"
    },
    "minimum_calibration_rows": {
      "default": 50,
      "maximum": 100000,
      "minimum": 1,
      "title": "Minimum Calibration Rows",
      "type": "integer"
    },
    "minimum_eligibility_coverage": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Eligibility Coverage",
      "type": "number"
    },
    "minimum_empirical_coverage": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Empirical Coverage",
      "type": "number"
    },
    "minimum_global_rows": {
      "default": 100,
      "maximum": 100000,
      "minimum": 1,
      "title": "Minimum Global Rows",
      "type": "integer"
    },
    "minimum_prediction_coverage": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 1,
      "title": "Minimum Prediction Coverage",
      "type": "number"
    },
    "minimum_relative_improvement": {
      "default": 0.05,
      "exclusiveMaximum": 1,
      "minimum": 0,
      "title": "Minimum Relative Improvement",
      "type": "number"
    },
    "minimum_segment_rows": {
      "default": 30,
      "maximum": 100000,
      "minimum": 1,
      "title": "Minimum Segment Rows",
      "type": "integer"
    },
    "nominal_coverage": {
      "default": 0.9,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Nominal Coverage",
      "type": "number"
    },
    "portfolio_final_test": {
      "const": "not_included_not_opened",
      "default": "not_included_not_opened",
      "title": "Portfolio Final Test",
      "type": "string"
    },
    "primary_metric": {
      "const": "mae",
      "default": "mae",
      "title": "Primary Metric",
      "type": "string"
    },
    "quantile": {
      "const": "ceil_n_plus_1_times_nominal_unattainable_rank_not_ready",
      "default": "ceil_n_plus_1_times_nominal_unattainable_rank_not_ready",
      "title": "Quantile",
      "type": "string"
    },
    "required_volume_bins": {
      "default": [
        "zero",
        "low",
        "medium",
        "high"
      ],
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "const": "zero",
          "type": "string"
        },
        {
          "const": "low",
          "type": "string"
        },
        {
          "const": "medium",
          "type": "string"
        },
        {
          "const": "high",
          "type": "string"
        }
      ],
      "title": "Required Volume Bins",
      "type": "array"
    },
    "use": {
      "const": "development_diagnostics_on_previously_observed_data",
      "default": "development_diagnostics_on_previously_observed_data",
      "title": "Use",
      "type": "string"
    },
    "version": {
      "const": "forecast-development-quality-1.0.0",
      "default": "forecast-development-quality-1.0.0",
      "title": "Version",
      "type": "string"
    },
    "volume_basis": {
      "const": "origin_known_rolling_28_mean_not_target_outcome",
      "default": "origin_known_rolling_28_mean_not_target_outcome",
      "title": "Volume Basis",
      "type": "string"
    },
    "zero_denominator": {
      "const": "null_not_evaluable_blocks_quality_gate",
      "default": "null_not_evaluable_blocks_quality_gate",
      "title": "Zero Denominator",
      "type": "string"
    }
  },
  "title": "QualityPolicy",
  "type": "object"
}
