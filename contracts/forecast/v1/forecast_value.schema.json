{
  "$id": "urn:retailops:forecast:forecast_value:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "business_timezone": {
      "const": "UTC",
      "title": "Business Timezone",
      "type": "string"
    },
    "channel": {
      "enum": [
        "store",
        "online"
      ],
      "title": "Channel",
      "type": "string"
    },
    "cutoff_policy": {
      "const": "end_of_day_second_v1",
      "title": "Cutoff Policy",
      "type": "string"
    },
    "deployment_status": {
      "const": "not_ready",
      "default": "not_ready",
      "title": "Deployment Status",
      "type": "string"
    },
    "forecast_origin": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Forecast Origin",
      "type": "string"
    },
    "horizon_days": {
      "maximum": 14,
      "minimum": 1,
      "title": "Horizon Days",
      "type": "integer"
    },
    "model_id": {
      "pattern": "^model-sha256-[0-9a-f]{64}$",
      "title": "Model Id",
      "type": "string"
    },
    "predicted_units": {
      "minimum": 0,
      "title": "Predicted Units",
      "type": "number"
    },
    "product_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Product Id",
      "type": "string"
    },
    "selling_location_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Selling Location Id",
      "type": "string"
    },
    "target_date": {
      "format": "date",
      "title": "Target Date",
      "type": "string"
    },
    "target_type": {
      "const": "observed_sales_units",
      "default": "observed_sales_units",
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "selling_location_id",
    "channel",
    "forecast_origin",
    "business_timezone",
    "cutoff_policy",
    "target_date",
    "horizon_days",
    "model_id",
    "predicted_units"
  ],
  "title": "ForecastValue",
  "type": "object"
}
