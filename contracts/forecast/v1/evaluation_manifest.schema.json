{
  "$defs": {
    "BaselinePolicy": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "default": [
            "last_observed",
            "moving_average",
            "seasonal_naive7"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "last_observed",
              "type": "string"
            },
            {
              "const": "moving_average",
              "type": "string"
            },
            {
              "const": "seasonal_naive7",
              "type": "string"
            }
          ],
          "title": "Candidates",
          "type": "array"
        },
        "closed_history": {
          "const": "confirmed_closed_zero_is_observed",
          "default": "confirmed_closed_zero_is_observed",
          "title": "Closed History",
          "type": "string"
        },
        "common_keys": {
          "const": "all_split_memberships_no_model_specific_drops",
          "default": "all_split_memberships_no_model_specific_drops",
          "title": "Common Keys",
          "type": "string"
        },
        "incomplete_candidate": {
          "const": "not_ready_no_selection_no_partial_metrics",
          "default": "not_ready_no_selection_no_partial_metrics",
          "title": "Incomplete Candidate",
          "type": "string"
        },
        "missing_history": {
          "const": "skip_unknown_never_impute_zero",
          "default": "skip_unknown_never_impute_zero",
          "title": "Missing History",
          "type": "string"
        },
        "moving_average_calendar_days": {
          "default": 7,
          "enum": [
            7,
            14,
            28
          ],
          "title": "Moving Average Calendar Days",
          "type": "integer"
        },
        "moving_average_minimum_known_days": {
          "default": 1,
          "maximum": 28,
          "minimum": 1,
          "title": "Moving Average Minimum Known Days",
          "type": "integer"
        },
        "origin_mode": {
          "const": "fixed_origin_no_recursive_actuals",
          "default": "fixed_origin_no_recursive_actuals",
          "title": "Origin Mode",
          "type": "string"
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "required_prediction_coverage": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 1,
          "title": "Required Prediction Coverage",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seasonal_missing": {
          "const": "last_known_same_weekday_within_28_days_or_insufficient_data",
          "default": "last_known_same_weekday_within_28_days_or_insufficient_data",
          "title": "Seasonal Missing",
          "type": "string"
        },
        "selection_metric": {
          "const": "mae",
          "default": "mae",
          "title": "Selection Metric",
          "type": "string"
        },
        "selection_role": {
          "const": "validation_only_per_fold",
          "default": "validation_only_per_fold",
          "title": "Selection Role",
          "type": "string"
        },
        "tie_break": {
          "const": "candidate_order",
          "default": "candidate_order",
          "title": "Tie Break",
          "type": "string"
        }
      },
      "title": "BaselinePolicy",
      "type": "object"
    },
    "BaselineSelection": {
      "additionalProperties": false,
      "properties": {
        "fold": {
          "title": "Fold",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "enum": [
                "last_observed",
                "moving_average",
                "seasonal_naive7"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "selection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "selected",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation_grain_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Grain Sha256",
          "type": "string"
        },
        "validation_metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricResult"
          },
          "propertyNames": {
            "enum": [
              "last_observed",
              "moving_average",
              "seasonal_naive7"
            ]
          },
          "title": "Validation Metrics",
          "type": "object"
        }
      },
      "required": [
        "fold",
        "status",
        "model",
        "validation_metrics",
        "validation_grain_sha256",
        "selection_sha256"
      ],
      "title": "BaselineSelection",
      "type": "object"
    },
    "EvaluationCode": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "pyarrow_version": {
          "title": "Pyarrow Version",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "version": {
          "const": "forecast-baselines-1.0.0",
          "default": "forecast-baselines-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "dependency_lock_sha256",
        "python_version",
        "pyarrow_version"
      ],
      "title": "EvaluationCode",
      "type": "object"
    },
    "EvaluationDescriptor": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/EvaluationCode"
        },
        "coverage_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Coverage Counts",
          "type": "object"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Metrics",
          "type": "object"
        },
        "prediction_rows": {
          "minimum": 1,
          "title": "Prediction Rows",
          "type": "integer"
        },
        "predictions_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Predictions Content Sha256",
          "type": "string"
        },
        "requested_policy": {
          "$ref": "#/$defs/BaselinePolicy"
        },
        "resolved_policy": {
          "$ref": "#/$defs/BaselinePolicy"
        },
        "role": {
          "const": "baseline_evaluation",
          "default": "baseline_evaluation",
          "title": "Role",
          "type": "string"
        },
        "selections": {
          "items": {
            "$ref": "#/$defs/BaselineSelection"
          },
          "title": "Selections",
          "type": "array"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "feature_set_id",
        "split_id",
        "label_dataset_id",
        "requested_policy",
        "resolved_policy",
        "code",
        "predictions_content_sha256",
        "prediction_rows",
        "coverage_counts",
        "selections",
        "metrics",
        "status"
      ],
      "title": "EvaluationDescriptor",
      "type": "object"
    },
    "FileReceipt": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "row_count": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 2147483648,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "row_count"
      ],
      "title": "FileReceipt",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "absolute_actual_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Actual Sum"
        },
        "absolute_error_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Error Sum"
        },
        "eligible_rows": {
          "minimum": 0,
          "title": "Eligible Rows",
          "type": "integer"
        },
        "mae": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mae"
        },
        "predicted_rows": {
          "minimum": 0,
          "title": "Predicted Rows",
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "incomplete",
            "not_evaluable",
            "selection_not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "wape": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wape"
        },
        "wape_status": {
          "enum": [
            "passed",
            "zero_denominator",
            "incomplete",
            "no_rows",
            "selection_not_ready"
          ],
          "title": "Wape Status",
          "type": "string"
        }
      },
      "required": [
        "eligible_rows",
        "predicted_rows",
        "status",
        "mae",
        "wape",
        "absolute_error_sum",
        "absolute_actual_sum",
        "wape_status"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "TableReceipt": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileReceipt"
          },
          "maxItems": 10000,
          "title": "Files",
          "type": "array"
        },
        "row_count": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "content_sha256",
        "row_count",
        "files"
      ],
      "title": "TableReceipt",
      "type": "object"
    }
  },
  "$id": "urn:retailops:forecast:evaluation_manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/EvaluationDescriptor"
    },
    "evaluation_id": {
      "pattern": "^forecast-evaluation-sha256-[0-9a-f]{64}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "forecast_model_status": {
      "const": "not_ready",
      "default": "not_ready",
      "title": "Forecast Model Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "predictions": {
      "$ref": "#/$defs/TableReceipt"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "evaluation_id",
    "descriptor",
    "predictions",
    "generated_at"
  ],
  "title": "EvaluationManifest",
  "type": "object"
}
