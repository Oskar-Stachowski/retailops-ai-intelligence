{
  "$defs": {
    "InputValue": {
      "additionalProperties": false,
      "properties": {
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "kind": {
          "enum": [
            "observed",
            "calendar",
            "categorical",
            "known_plan"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^(origin_lag_1_units|origin_lag_7_units|origin_lag_14_units|origin_lag_28_units|rolling_mean_7|rolling_std_7|rolling_count_7|rolling_mean_14|rolling_std_14|rolling_count_14|rolling_mean_28|rolling_std_28|rolling_count_28|target_weekday|target_week_of_year|target_month|target_quarter|target_is_weekend|target_is_public_holiday|target_is_easter|target_is_christmas|target_is_black_friday|target_is_cyber_monday|target_location_open|target_is_category_season|category_id|brand|country_code|calendar_jurisdiction|channel|planned_regular_price_minor_units|currency|planned_promotion_offered|planned_promotion_type|planned_promotion_discount_basis_points|planned_promotion_minimum_quantity)$",
          "title": "Name",
          "type": "string"
        },
        "observed_through_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Through Date"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "source_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Available At"
        },
        "status": {
          "enum": [
            "available",
            "missing",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "kind",
        "value",
        "status",
        "source_available_at",
        "reason"
      ],
      "title": "InputValue",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Available At",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "table",
        "record_id",
        "record_sha256",
        "available_at"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "$id": "urn:retailops:forecast:input_row:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "business_timezone": {
      "const": "UTC",
      "title": "Business Timezone",
      "type": "string"
    },
    "channel": {
      "enum": [
        "store",
        "online"
      ],
      "title": "Channel",
      "type": "string"
    },
    "cutoff_policy": {
      "const": "end_of_day_second_v1",
      "title": "Cutoff Policy",
      "type": "string"
    },
    "forecast_origin": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Forecast Origin",
      "type": "string"
    },
    "history_active_days": {
      "maximum": 28,
      "minimum": 0,
      "title": "History Active Days",
      "type": "integer"
    },
    "history_closed_days": {
      "maximum": 28,
      "minimum": 0,
      "title": "History Closed Days",
      "type": "integer"
    },
    "history_context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "History Context Sha256",
      "type": "string"
    },
    "history_known_days": {
      "maximum": 28,
      "minimum": 0,
      "title": "History Known Days",
      "type": "integer"
    },
    "history_missing_days": {
      "maximum": 28,
      "minimum": 0,
      "title": "History Missing Days",
      "type": "integer"
    },
    "horizon_days": {
      "maximum": 14,
      "minimum": 1,
      "title": "Horizon Days",
      "type": "integer"
    },
    "insufficient_history": {
      "title": "Insufficient History",
      "type": "boolean"
    },
    "is_active_assortment": {
      "const": true,
      "default": true,
      "title": "Is Active Assortment",
      "type": "boolean"
    },
    "product_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Product Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selling_location_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Selling Location Id",
      "type": "string"
    },
    "target_calendar_eligible": {
      "title": "Target Calendar Eligible",
      "type": "boolean"
    },
    "target_date": {
      "format": "date",
      "title": "Target Date",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/InputValue"
      },
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "product_id",
    "selling_location_id",
    "channel",
    "forecast_origin",
    "business_timezone",
    "cutoff_policy",
    "target_date",
    "horizon_days",
    "history_context_sha256",
    "history_active_days",
    "history_known_days",
    "history_missing_days",
    "history_closed_days",
    "insufficient_history",
    "target_calendar_eligible",
    "values"
  ],
  "title": "InputRow",
  "type": "object"
}
