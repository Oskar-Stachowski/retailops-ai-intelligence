  "$id": "urn:retailops:forecast:functional_pipeline:2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Code Sha256",
      "type": "string"
    },
    "estimator": {
      "$ref": "#/$defs/LearnedEstimator"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "head": {
      "enum": [
        "rf_mean",
        "hgb_mean",
        "hgb_median",
        "hgb_lower",
        "hgb_upper"
      ],
      "title": "Head",
      "type": "string"
    },
    "model_id": {
      "pattern": "^model-sha256-[0-9a-f]{64}$",
      "title": "Model Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/FunctionalPolicy"
    },
    "preprocessing": {
      "$ref": "#/$defs/FittedState"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "train_labels_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Train Labels Sha256",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "head",
    "policy",
    "preprocessing",
    "train_labels_sha256",
    "estimator",
    "code_sha256",
    "generated_at"
  ],
  "title": "FunctionalPipeline",
  "type": "object"
}
