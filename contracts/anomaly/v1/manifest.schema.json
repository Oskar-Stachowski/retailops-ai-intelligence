{
  "$defs": {
    "Descriptor": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "detector_readiness": {
          "const": "not_qualified",
          "default": "not_qualified",
          "title": "Detector Readiness",
          "type": "string"
        },
        "evaluation_truth": {
          "const": "excluded",
          "default": "excluded",
          "title": "Evaluation Truth",
          "type": "string"
        },
        "implementation": {
          "$ref": "#/$defs/Implementation"
        },
        "input_tables": {
          "items": {
            "type": "string"
          },
          "title": "Input Tables",
          "type": "array"
        },
        "model_feature_allowlist": {
          "items": {
            "type": "string"
          },
          "title": "Model Feature Allowlist",
          "type": "array"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "role": {
          "const": "features",
          "default": "features",
          "title": "Role",
          "type": "string"
        },
        "row_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Status Counts",
          "type": "object"
        }
      },
      "required": [
        "parent",
        "policy",
        "policy_sha256",
        "implementation",
        "input_tables",
        "model_feature_allowlist",
        "row_count",
        "content_sha256",
        "status_counts"
      ],
      "title": "Descriptor",
      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "contract_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Contract Files",
          "type": "object"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "input_byte_limit": {
          "const": 134217728,
          "title": "Input Byte Limit",
          "type": "integer"
        },
        "input_row_limit": {
          "const": 100000,
          "title": "Input Row Limit",
          "type": "integer"
        },
        "output_byte_limit": {
          "const": 268435456,
          "title": "Output Byte Limit",
          "type": "integer"
        },
        "output_row_limit": {
          "const": 100000,
          "title": "Output Row Limit",
          "type": "integer"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "version": {
          "const": "anomaly-demand-inputs-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "code_files",
        "code_sha256",
        "contract_files",
        "dependency_lock_sha256",
        "python_version",
        "input_row_limit",
        "input_byte_limit",
        "output_row_limit",
        "output_byte_limit"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "Parent": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
