{
  "$defs": {
    "MechanicsPrediction": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "predicted_units": {
          "minimum": 0,
          "title": "Predicted Units",
          "type": "number"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days",
        "predicted_units"
      ],
      "title": "MechanicsPrediction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^predictions-sha256-[0-9a-f]{64}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "complete": {
      "const": true,
      "default": true,
      "title": "Complete",
      "type": "boolean"
    },
    "forecast_quality_approved": {
      "const": false,
      "default": false,
      "title": "Forecast Quality Approved",
      "type": "boolean"
    },
    "kind": {
      "const": "predictions",
      "default": "predictions",
      "title": "Kind",
      "type": "string"
    },
    "predictions": {
      "items": {
        "$ref": "#/$defs/MechanicsPrediction"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Predictions",
      "type": "array"
    },
    "profile_id": {
      "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
      "title": "Profile Id",
      "type": "string"
    },
    "purpose": {
      "const": "lifecycle_mechanics_only",
      "default": "lifecycle_mechanics_only",
      "title": "Purpose",
      "type": "string"
    },
    "release_id": {
      "pattern": "^model-release-sha256-[0-9a-f]{64}$",
      "title": "Release Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "run_id",
    "release_id",
    "profile_id",
    "predictions"
  ],
  "title": "MechanicsOutput",
  "type": "object"
}
