{
  "$defs": {
    "BatchScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "BatchScope",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "mlflow_run_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Mlflow Run Id",
          "type": "string"
        },
        "model_name": {
          "enum": [
            "retailops-demand-forecast",
            "retailops-demand-forecast-mechanics"
          ],
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Model Version",
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "qualification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qualification Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "model_name",
        "model_version",
        "mlflow_run_id",
        "source_uri",
        "qualification_sha256",
        "qualification"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "$ref": "#/$defs/Receipt"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_ready",
            "not_evaluable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "report"
      ],
      "title": "Gate",
      "type": "object"
    },
    "MechanicsPrediction": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "predicted_units": {
          "minimum": 0,
          "title": "Predicted Units",
          "type": "number"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days",
        "predicted_units"
      ],
      "title": "MechanicsPrediction",
      "type": "object"
    },
    "OutputManifest": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^predictions-sha256-[0-9a-f]{64}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "as_of_time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of Time",
          "type": "string"
        },
        "cold_load_seconds": {
          "minimum": 0,
          "title": "Cold Load Seconds",
          "type": "number"
        },
        "complete": {
          "const": true,
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "compute_seconds": {
          "minimum": 0,
          "title": "Compute Seconds",
          "type": "number"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "execution_profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Execution Profile Id",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "forecast_quality_approved": {
          "const": true,
          "default": true,
          "title": "Forecast Quality Approved",
          "type": "boolean"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "horizon_days": {
          "enum": [
            7,
            14
          ],
          "title": "Horizon Days",
          "type": "integer"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "kind": {
          "const": "predictions",
          "default": "predictions",
          "title": "Kind",
          "type": "string"
        },
        "partitions": {
          "items": {
            "$ref": "#/$defs/PartitionReceipt"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Partitions",
          "type": "array"
        },
        "peak_rss_bytes": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Peak Rss Bytes",
          "type": "integer"
        },
        "predictions_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Predictions Sha256",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "purpose": {
          "const": "qualified_forecast",
          "default": "qualified_forecast",
          "title": "Purpose",
          "type": "string"
        },
        "release_id": {
          "pattern": "^model-release-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "resolved_model": {
          "$ref": "#/$defs/Binding"
        },
        "row_count": {
          "maximum": 1400,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/BatchScope"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "run_id",
        "release_id",
        "profile_id",
        "execution_profile_id",
        "source_dataset_id",
        "curated_dataset_id",
        "feature_set_id",
        "resolved_model",
        "image_digest",
        "as_of_time",
        "generated_at",
        "scope",
        "horizon_days",
        "row_count",
        "predictions_sha256",
        "partitions",
        "cold_load_seconds",
        "compute_seconds",
        "peak_rss_bytes"
      ],
      "title": "OutputManifest",
      "type": "object"
    },
    "Partition": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "maximum": 5,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "predictions": {
          "items": {
            "$ref": "#/$defs/MechanicsPrediction"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Predictions",
          "type": "array"
        }
      },
      "required": [
        "ordinal",
        "predictions"
      ],
      "title": "Partition",
      "type": "object"
    },
    "PartitionReceipt": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "maximum": 5,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "rows": {
          "maximum": 256,
          "minimum": 1,
          "title": "Rows",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "rows",
        "sha256"
      ],
      "title": "PartitionReceipt",
      "type": "object"
    },
    "Qualification": {
      "additionalProperties": false,
      "properties": {
        "ai_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Ai Code Commit",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/Receipt"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "data_seed": {
          "minimum": 0,
          "title": "Data Seed",
          "type": "integer"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "expected_output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Output Sha256",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "forecast-features-v1",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "flavor": {
          "enum": [
            "forecast-json-v1",
            "baseline-json-v1",
            "mechanics-json-v1"
          ],
          "title": "Flavor",
          "type": "string"
        },
        "gates": {
          "additionalProperties": {
            "$ref": "#/$defs/Gate"
          },
          "maxProperties": 10,
          "minProperties": 10,
          "propertyNames": {
            "enum": [
              "features",
              "freshness_drift_compatibility",
              "model_card",
              "pit",
              "protocol",
              "resources",
              "security_license",
              "segments",
              "signature",
              "source"
            ]
          },
          "title": "Gates",
          "type": "object"
        },
        "input_example": {
          "$ref": "#/$defs/Receipt"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/Receipt"
        },
        "model_family": {
          "enum": [
            "baseline",
            "random_forest",
            "hist_gradient_boosting",
            "mechanics"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_seed": {
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "original_completed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Original Completed At",
          "type": "string"
        },
        "original_run_kind": {
          "enum": [
            "historical_evidence",
            "training",
            "mechanics_fixture"
          ],
          "title": "Original Run Kind",
          "type": "string"
        },
        "original_started_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Original Started At",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "qualified_forecast",
            "lifecycle_mechanics_only"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/Receipt"
        },
        "source_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Code Commit",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "evidence_id",
        "evaluation_id",
        "reference_id",
        "original_run_kind",
        "original_started_at",
        "original_completed_at",
        "source_dataset_id",
        "curated_dataset_id",
        "label_dataset_id",
        "split_id",
        "feature_set_id",
        "feature_schema_version",
        "config_sha256",
        "config",
        "source_code_commit",
        "ai_code_commit",
        "dependency_lock_sha256",
        "model_seed",
        "data_seed",
        "model_family",
        "flavor",
        "model",
        "signature",
        "input_example",
        "expected_output_sha256",
        "gates"
      ],
      "title": "Qualification",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 268435456,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "title": "Receipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "#/$defs/OutputManifest"
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/Partition"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Partitions",
      "type": "array"
    }
  },
  "required": [
    "manifest",
    "partitions"
  ],
  "title": "Publication",
  "type": "object"
}
