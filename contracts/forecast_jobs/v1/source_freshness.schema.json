{
  "$defs": {
    "JsonValue": {},
    "SourceObservation": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "latest_complete_observation_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Complete Observation Date"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "latest_complete_observation_date"
      ],
      "title": "SourceObservation",
      "type": "object"
    },
    "SourceWatermark": {
      "additionalProperties": false,
      "properties": {
        "as_of_time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of Time",
          "type": "string"
        },
        "complete_through": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Complete Through"
        },
        "completeness_status": {
          "enum": [
            "complete",
            "not_ready"
          ],
          "title": "Completeness Status",
          "type": "string"
        },
        "meaning": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Meaning",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "as_of_time",
        "complete_through",
        "completeness_status",
        "meaning",
        "policy_version"
      ],
      "title": "SourceWatermark",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_time": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "As Of Time",
      "type": "string"
    },
    "curated_descriptor": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Curated Descriptor",
      "type": "object"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/SourceObservation"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "policy_id": {
      "const": "forecast-source-watermark-v1",
      "default": "forecast-source-watermark-v1",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stream": {
      "const": "daily_demand_observations",
      "default": "daily_demand_observations",
      "title": "Stream",
      "type": "string"
    },
    "watermark": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceWatermark"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "as_of_time",
    "curated_descriptor",
    "watermark",
    "observations"
  ],
  "title": "SourceFreshness",
  "type": "object"
}
