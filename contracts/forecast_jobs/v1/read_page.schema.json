{
  "$defs": {
    "ForecastFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "max_origin_age_seconds": {
          "const": 86400,
          "default": 86400,
          "title": "Max Origin Age Seconds",
          "type": "integer"
        },
        "origin_age_seconds": {
          "minimum": 0,
          "title": "Origin Age Seconds",
          "type": "number"
        },
        "policy_id": {
          "const": "forecast-read-v1",
          "default": "forecast-read-v1",
          "title": "Policy Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "source_watermark_unavailable",
            "origin_age_exceeded",
            "newer_run_unpublished"
          ],
          "title": "Reason",
          "type": "string"
        },
        "source_watermark": {
          "default": null,
          "title": "Source Watermark",
          "type": "null"
        },
        "status": {
          "enum": [
            "stale",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "evaluated_at",
        "origin_age_seconds"
      ],
      "title": "ForecastFreshness",
      "type": "object"
    },
    "ForecastItem": {
      "additionalProperties": false,
      "description": "Public projection has its own identity and exposes no artifact URI or other scope.",
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "execution_profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Execution Profile Id",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "forecast-features-v1",
          "default": "forecast-features-v1",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/ForecastFreshness"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "inference_run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Inference Run Id",
          "type": "string"
        },
        "interval_unavailable_reason": {
          "const": "not_published",
          "default": "not_published",
          "title": "Interval Unavailable Reason",
          "type": "string"
        },
        "model_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Artifact Sha256",
          "type": "string"
        },
        "model_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Config Sha256",
          "type": "string"
        },
        "model_name": {
          "const": "retailops-demand-forecast",
          "default": "retailops-demand-forecast",
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]*$",
          "title": "Model Version",
          "type": "string"
        },
        "predicted_units": {
          "minimum": 0,
          "title": "Predicted Units",
          "type": "number"
        },
        "prediction_dataset_id": {
          "pattern": "^predictions-sha256-[0-9a-f]{64}$",
          "title": "Prediction Dataset Id",
          "type": "string"
        },
        "prediction_id": {
          "pattern": "^prediction-sha256-[0-9a-f]{64}$",
          "title": "Prediction Id",
          "type": "string"
        },
        "prediction_interval": {
          "default": null,
          "title": "Prediction Interval",
          "type": "null"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "qualification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qualification Sha256",
          "type": "string"
        },
        "quality_status": {
          "const": "passed",
          "default": "passed",
          "title": "Quality Status",
          "type": "string"
        },
        "release_id": {
          "pattern": "^model-release-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "default": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        },
        "unit_of_measure": {
          "const": "unit",
          "default": "unit",
          "title": "Unit Of Measure",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days",
        "predicted_units",
        "prediction_id",
        "prediction_dataset_id",
        "model_version",
        "qualification_sha256",
        "model_artifact_sha256",
        "model_config_sha256",
        "evaluation_id",
        "image_digest",
        "release_id",
        "source_dataset_id",
        "curated_dataset_id",
        "feature_set_id",
        "inference_run_id",
        "profile_id",
        "execution_profile_id",
        "generated_at",
        "freshness"
      ],
      "title": "ForecastItem",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 2800,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 2800,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "ReadPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_outputs": {
          "const": 32,
          "default": 32,
          "title": "Max Candidate Outputs",
          "type": "integer"
        },
        "max_origin_age_seconds": {
          "const": 86400,
          "default": 86400,
          "title": "Max Origin Age Seconds",
          "type": "integer"
        },
        "policy_id": {
          "const": "forecast-read-v1",
          "default": "forecast-read-v1",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ReadPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_status": {
      "enum": [
        "available",
        "no_data"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "freshness_policy": {
      "$ref": "#/$defs/ReadPolicy",
      "default": {
        "max_candidate_outputs": 32,
        "max_origin_age_seconds": 86400,
        "policy_id": "forecast-read-v1",
        "schema_version": "1.0"
      }
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ForecastItem"
      },
      "maxItems": 200,
      "title": "Items",
      "type": "array"
    },
    "pagination": {
      "$ref": "#/$defs/Pagination"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection": {
      "enum": [
        "latest_per_series_horizon",
        "origin",
        "inference_run"
      ],
      "title": "Selection",
      "type": "string"
    },
    "view_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "View Sha256",
      "type": "string"
    }
  },
  "required": [
    "items",
    "pagination",
    "generated_at",
    "data_status",
    "selection",
    "view_sha256"
  ],
  "title": "ForecastPage",
  "type": "object"
}
