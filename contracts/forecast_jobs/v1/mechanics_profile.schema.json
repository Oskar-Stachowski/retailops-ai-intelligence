{
  "$defs": {
    "MechanicsInput": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "cutoff_policy": {
          "const": "end_of_day_second_v1",
          "title": "Cutoff Policy",
          "type": "string"
        },
        "forecast_origin": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Forecast Origin",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "forecast_origin",
        "business_timezone",
        "cutoff_policy",
        "target_date",
        "horizon_days",
        "value"
      ],
      "title": "MechanicsInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Private test fixture registration, never a substitute for a qualified feature package.",
  "properties": {
    "as_of_time": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "As Of Time",
      "type": "string"
    },
    "curated_dataset_id": {
      "pattern": "^curated-sha256-[0-9a-f]{64}$",
      "title": "Curated Dataset Id",
      "type": "string"
    },
    "environment": {
      "const": "test",
      "default": "test",
      "title": "Environment",
      "type": "string"
    },
    "feature_set_id": {
      "pattern": "^features-sha256-[0-9a-f]{64}$",
      "title": "Feature Set Id",
      "type": "string"
    },
    "label_dataset_id": {
      "default": null,
      "title": "Label Dataset Id",
      "type": "null"
    },
    "profile_id": {
      "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
      "title": "Profile Id",
      "type": "string"
    },
    "purpose": {
      "const": "lifecycle_mechanics_only",
      "default": "lifecycle_mechanics_only",
      "title": "Purpose",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/MechanicsInput"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "source_dataset_id": {
      "pattern": "^source-sha256-[0-9a-f]{64}$",
      "title": "Source Dataset Id",
      "type": "string"
    },
    "split_id": {
      "default": null,
      "title": "Split Id",
      "type": "null"
    }
  },
  "required": [
    "source_dataset_id",
    "curated_dataset_id",
    "feature_set_id",
    "as_of_time",
    "profile_id",
    "rows"
  ],
  "title": "MechanicsProfile",
  "type": "object"
}
