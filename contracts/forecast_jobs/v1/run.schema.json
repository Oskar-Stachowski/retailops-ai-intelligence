{
  "$defs": {
    "BatchInput": {
      "additionalProperties": false,
      "properties": {
        "as_of_time": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of Time",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "label_dataset_id": {
          "default": null,
          "title": "Label Dataset Id",
          "type": "null"
        },
        "profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/BatchRequest"
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Hash",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/BatchScope"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "split_id": {
          "default": null,
          "title": "Split Id",
          "type": "null"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id",
        "feature_set_id",
        "as_of_time",
        "profile_id",
        "request_hash",
        "request",
        "scope"
      ],
      "title": "BatchInput",
      "type": "object"
    },
    "BatchRequest": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "horizons_days": {
          "default": [
            7,
            14
          ],
          "items": {
            "enum": [
              7,
              14
            ],
            "type": "integer"
          },
          "title": "Horizons Days",
          "type": "array"
        },
        "model_alias": {
          "const": "champion",
          "default": "champion",
          "title": "Model Alias",
          "type": "string"
        },
        "product_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Product Ids",
          "type": "array"
        },
        "profile_id": {
          "pattern": "^batch-profile-sha256-[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selling_location_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "as_of",
        "channel"
      ],
      "title": "BatchRequest",
      "type": "object"
    },
    "BatchScope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channel"
      ],
      "title": "BatchScope",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "mlflow_run_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Mlflow Run Id",
          "type": "string"
        },
        "model_name": {
          "enum": [
            "retailops-demand-forecast",
            "retailops-demand-forecast-mechanics"
          ],
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Model Version",
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "qualification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qualification Sha256",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        }
      },
      "required": [
        "model_name",
        "model_version",
        "mlflow_run_id",
        "source_uri",
        "qualification_sha256",
        "qualification"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "$ref": "#/$defs/Receipt"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_ready",
            "not_evaluable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "report"
      ],
      "title": "Gate",
      "type": "object"
    },
    "Qualification": {
      "additionalProperties": false,
      "properties": {
        "ai_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Ai Code Commit",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/Receipt"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "data_seed": {
          "minimum": 0,
          "title": "Data Seed",
          "type": "integer"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "expected_output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Output Sha256",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "forecast-features-v1",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "flavor": {
          "enum": [
            "forecast-json-v1",
            "baseline-json-v1",
            "mechanics-json-v1"
          ],
          "title": "Flavor",
          "type": "string"
        },
        "gates": {
          "additionalProperties": {
            "$ref": "#/$defs/Gate"
          },
          "maxProperties": 10,
          "minProperties": 10,
          "propertyNames": {
            "enum": [
              "features",
              "freshness_drift_compatibility",
              "model_card",
              "pit",
              "protocol",
              "resources",
              "security_license",
              "segments",
              "signature",
              "source"
            ]
          },
          "title": "Gates",
          "type": "object"
        },
        "input_example": {
          "$ref": "#/$defs/Receipt"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/Receipt"
        },
        "model_family": {
          "enum": [
            "baseline",
            "random_forest",
            "hist_gradient_boosting",
            "mechanics"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_seed": {
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "original_completed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Original Completed At",
          "type": "string"
        },
        "original_run_kind": {
          "enum": [
            "historical_evidence",
            "training",
            "mechanics_fixture"
          ],
          "title": "Original Run Kind",
          "type": "string"
        },
        "original_started_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Original Started At",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "qualified_forecast",
            "lifecycle_mechanics_only"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/Receipt"
        },
        "source_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Code Commit",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "evidence_id",
        "evaluation_id",
        "reference_id",
        "original_run_kind",
        "original_started_at",
        "original_completed_at",
        "source_dataset_id",
        "curated_dataset_id",
        "label_dataset_id",
        "split_id",
        "feature_set_id",
        "feature_schema_version",
        "config_sha256",
        "config",
        "source_code_commit",
        "ai_code_commit",
        "dependency_lock_sha256",
        "model_seed",
        "data_seed",
        "model_family",
        "flavor",
        "model",
        "signature",
        "input_example",
        "expected_output_sha256",
        "gates"
      ],
      "title": "Qualification",
      "type": "object"
    },
    "QueuePolicy": {
      "additionalProperties": false,
      "properties": {
        "attempt_timeout_seconds": {
          "default": 120,
          "maximum": 300,
          "minimum": 2,
          "title": "Attempt Timeout Seconds",
          "type": "integer"
        },
        "heartbeat_seconds": {
          "default": 5.0,
          "maximum": 10,
          "minimum": 0.1,
          "title": "Heartbeat Seconds",
          "type": "number"
        },
        "lease_seconds": {
          "default": 30,
          "maximum": 60,
          "minimum": 2,
          "title": "Lease Seconds",
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_pending": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Pending",
          "type": "integer"
        },
        "max_pending_per_principal": {
          "default": 20,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Pending Per Principal",
          "type": "integer"
        },
        "retry_backoff_seconds": {
          "default": 5,
          "maximum": 30,
          "minimum": 0,
          "title": "Retry Backoff Seconds",
          "type": "integer"
        },
        "run_timeout_seconds": {
          "default": 600,
          "maximum": 900,
          "minimum": 2,
          "title": "Run Timeout Seconds",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "QueuePolicy",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 268435456,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "RunError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_input",
            "dependency_unavailable",
            "execution_failed",
            "cancelled",
            "gate_failed"
          ],
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "title": "RunError",
      "type": "object"
    },
    "RunOutput": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "pattern": "^model-sha256-[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "pattern": "^predictions-sha256-[0-9a-f]{64}$",
              "type": "string"
            }
          ],
          "title": "Artifact Id"
        },
        "complete": {
          "const": true,
          "title": "Complete",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "model",
            "predictions"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_id",
        "complete"
      ],
      "title": "RunOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Keep MLRunRecord v1 closed; serving uses a namespaced extension of the same state machine.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "contract_type": {
      "const": "run",
      "title": "Contract Type",
      "type": "string"
    },
    "environment": {
      "enum": [
        "local",
        "test"
      ],
      "title": "Environment",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunError"
        },
        {
          "type": "null"
        }
      ]
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "input_ref": {
      "$ref": "#/$defs/BatchInput"
    },
    "output_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "$ref": "#/$defs/QueuePolicy"
    },
    "purpose": {
      "enum": [
        "qualified_forecast",
        "lifecycle_mechanics_only"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "release_id": {
      "pattern": "^model-release-sha256-[0-9a-f]{64}$",
      "title": "Release Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Requested By",
      "type": "string"
    },
    "resolved_model": {
      "$ref": "#/$defs/Binding"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_type": {
      "const": "forecast_batch",
      "default": "forecast_batch",
      "title": "Run Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "run_id",
    "status",
    "attempt",
    "requested_at",
    "started_at",
    "completed_at",
    "requested_by",
    "input_ref",
    "resolved_model",
    "output_ref",
    "error",
    "release_id",
    "image_digest",
    "environment",
    "purpose",
    "policy"
  ],
  "title": "BatchRun",
  "type": "object"
}
