{
  "$defs": {
    "CampaignParentBudget": {
      "additionalProperties": false,
      "properties": {
        "batch_rows": {
          "default": 256,
          "maximum": 8192,
          "minimum": 1,
          "title": "Batch Rows",
          "type": "integer"
        },
        "max_parent_bytes": {
          "default": 2147483648,
          "maximum": 2147483648,
          "minimum": 1024,
          "title": "Max Parent Bytes",
          "type": "integer"
        },
        "max_parent_files": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 2,
          "title": "Max Parent Files",
          "type": "integer"
        },
        "max_rows_per_parent": {
          "default": 20000000,
          "maximum": 20000000,
          "minimum": 1,
          "title": "Max Rows Per Parent",
          "type": "integer"
        }
      },
      "title": "CampaignParentBudget",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "FeaturePolicy": {
      "additionalProperties": false,
      "properties": {
        "closed_target": {
          "const": "retain_in_coverage_exclude_from_scoring",
          "default": "retain_in_coverage_exclude_from_scoring",
          "title": "Closed Target",
          "type": "string"
        },
        "cold_start": {
          "const": "insufficient_data_no_prediction",
          "default": "insufficient_data_no_prediction",
          "title": "Cold Start",
          "type": "string"
        },
        "columns": {
          "default": [
            "origin_lag_1_units",
            "origin_lag_7_units",
            "origin_lag_14_units",
            "origin_lag_28_units",
            "rolling_mean_7",
            "rolling_std_7",
            "rolling_count_7",
            "rolling_mean_14",
            "rolling_std_14",
            "rolling_count_14",
            "rolling_mean_28",
            "rolling_std_28",
            "rolling_count_28",
            "target_weekday",
            "target_week_of_year",
            "target_month",
            "target_quarter",
            "target_is_weekend",
            "target_is_public_holiday",
            "target_is_easter",
            "target_is_christmas",
            "target_is_black_friday",
            "target_is_cyber_monday",
            "target_location_open",
            "target_is_category_season",
            "category_id",
            "brand",
            "country_code",
            "calendar_jurisdiction",
            "channel",
            "planned_regular_price_minor_units",
            "currency",
            "planned_promotion_offered",
            "planned_promotion_type",
            "planned_promotion_discount_basis_points",
            "planned_promotion_minimum_quantity"
          ],
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "inventory": {
          "const": "excluded",
          "default": "excluded",
          "title": "Inventory",
          "type": "string"
        },
        "maximum_observation_age_days": {
          "default": 3,
          "maximum": 28,
          "minimum": 1,
          "title": "Maximum Observation Age Days",
          "type": "integer"
        },
        "minimum_active_history_days": {
          "default": 28,
          "maximum": 28,
          "minimum": 1,
          "title": "Minimum Active History Days",
          "type": "integer"
        },
        "minimum_known_history_days": {
          "default": 7,
          "maximum": 28,
          "minimum": 1,
          "title": "Minimum Known History Days",
          "type": "integer"
        },
        "missing_features": {
          "const": "retain_nullable_values_and_fit_train_only",
          "default": "retain_nullable_values_and_fit_train_only",
          "title": "Missing Features",
          "type": "string"
        },
        "preprocessing": {
          "$ref": "#/$defs/PreprocessingRecipe",
          "default": {
            "boolean_missing": "train_mode_tie_false_with_indicator",
            "categorical": "train_vocabulary_one_hot_with_missing_and_unknown",
            "entirely_missing": "constant_zero_with_indicator",
            "fit_scope": "eligible_train_rows_of_one_fold_only",
            "numeric_missing": "train_median_with_indicator",
            "output_numbers": "float64_model_inputs_raw_money_remains_exact",
            "scaling": "none",
            "version": "forecast-train-only-1.0.0"
          }
        },
        "stale_history": {
          "const": "block_run_no_partial_success",
          "default": "block_run_no_partial_success",
          "title": "Stale History",
          "type": "string"
        },
        "truth": {
          "const": "excluded",
          "default": "excluded",
          "title": "Truth",
          "type": "string"
        },
        "version": {
          "const": "forecast-features-1.0.0",
          "default": "forecast-features-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "FeaturePolicy",
      "type": "object"
    },
    "OriginWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "OriginWindow",
      "type": "object"
    },
    "PreprocessingRecipe": {
      "additionalProperties": false,
      "properties": {
        "boolean_missing": {
          "const": "train_mode_tie_false_with_indicator",
          "default": "train_mode_tie_false_with_indicator",
          "title": "Boolean Missing",
          "type": "string"
        },
        "categorical": {
          "const": "train_vocabulary_one_hot_with_missing_and_unknown",
          "default": "train_vocabulary_one_hot_with_missing_and_unknown",
          "title": "Categorical",
          "type": "string"
        },
        "entirely_missing": {
          "const": "constant_zero_with_indicator",
          "default": "constant_zero_with_indicator",
          "title": "Entirely Missing",
          "type": "string"
        },
        "fit_scope": {
          "const": "eligible_train_rows_of_one_fold_only",
          "default": "eligible_train_rows_of_one_fold_only",
          "title": "Fit Scope",
          "type": "string"
        },
        "numeric_missing": {
          "const": "train_median_with_indicator",
          "default": "train_median_with_indicator",
          "title": "Numeric Missing",
          "type": "string"
        },
        "output_numbers": {
          "const": "float64_model_inputs_raw_money_remains_exact",
          "default": "float64_model_inputs_raw_money_remains_exact",
          "title": "Output Numbers",
          "type": "string"
        },
        "scaling": {
          "const": "none",
          "default": "none",
          "title": "Scaling",
          "type": "string"
        },
        "version": {
          "const": "forecast-train-only-1.0.0",
          "default": "forecast-train-only-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "PreprocessingRecipe",
      "type": "object"
    },
    "RoleWindow": {
      "additionalProperties": false,
      "properties": {
        "label_knowledge_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Label Knowledge Cutoff",
          "type": "string"
        },
        "origins": {
          "$ref": "#/$defs/DateWindow"
        },
        "role": {
          "enum": [
            "train",
            "early_stopping",
            "tune",
            "calibration",
            "development_evaluation"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "origins",
        "label_knowledge_cutoff"
      ],
      "title": "RoleWindow",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:campaign_development_export_plan:12.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Freeze temporal/features/resource policy before parent IDs are generated.",
  "properties": {
    "exposure": {
      "const": "complete_parent_including_late_and_out_of_role_rows",
      "default": "complete_parent_including_late_and_out_of_role_rows",
      "title": "Exposure",
      "type": "string"
    },
    "features": {
      "$ref": "#/$defs/FeaturePolicy",
      "default": {
        "closed_target": "retain_in_coverage_exclude_from_scoring",
        "cold_start": "insufficient_data_no_prediction",
        "columns": [
          "origin_lag_1_units",
          "origin_lag_7_units",
          "origin_lag_14_units",
          "origin_lag_28_units",
          "rolling_mean_7",
          "rolling_std_7",
          "rolling_count_7",
          "rolling_mean_14",
          "rolling_std_14",
          "rolling_count_14",
          "rolling_mean_28",
          "rolling_std_28",
          "rolling_count_28",
          "target_weekday",
          "target_week_of_year",
          "target_month",
          "target_quarter",
          "target_is_weekend",
          "target_is_public_holiday",
          "target_is_easter",
          "target_is_christmas",
          "target_is_black_friday",
          "target_is_cyber_monday",
          "target_location_open",
          "target_is_category_season",
          "category_id",
          "brand",
          "country_code",
          "calendar_jurisdiction",
          "channel",
          "planned_regular_price_minor_units",
          "currency",
          "planned_promotion_offered",
          "planned_promotion_type",
          "planned_promotion_discount_basis_points",
          "planned_promotion_minimum_quantity"
        ],
        "inventory": "excluded",
        "maximum_observation_age_days": 3,
        "minimum_active_history_days": 28,
        "minimum_known_history_days": 7,
        "missing_features": "retain_nullable_values_and_fit_train_only",
        "preprocessing": {
          "boolean_missing": "train_mode_tie_false_with_indicator",
          "categorical": "train_vocabulary_one_hot_with_missing_and_unknown",
          "entirely_missing": "constant_zero_with_indicator",
          "fit_scope": "eligible_train_rows_of_one_fold_only",
          "numeric_missing": "train_median_with_indicator",
          "output_numbers": "float64_model_inputs_raw_money_remains_exact",
          "scaling": "none",
          "version": "forecast-train-only-1.0.0"
        },
        "stale_history": "block_run_no_partial_success",
        "truth": "excluded",
        "version": "forecast-features-1.0.0"
      }
    },
    "final_test_access_authorized": {
      "const": false,
      "default": false,
      "title": "Final Test Access Authorized",
      "type": "boolean"
    },
    "generation_operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Generation Operation Id",
      "type": "string"
    },
    "label_delay_days": {
      "default": 1,
      "maximum": 30,
      "minimum": 1,
      "title": "Label Delay Days",
      "type": "integer"
    },
    "max_artifact_bytes": {
      "default": 8589934592,
      "maximum": 34359738368,
      "minimum": 1024,
      "title": "Max Artifact Bytes",
      "type": "integer"
    },
    "max_index_bytes": {
      "default": 2147483648,
      "maximum": 8589934592,
      "minimum": 4096,
      "title": "Max Index Bytes",
      "type": "integer"
    },
    "max_population_rows": {
      "default": 10000000,
      "maximum": 10000000,
      "minimum": 5,
      "title": "Max Population Rows",
      "type": "integer"
    },
    "max_record_bytes": {
      "default": 32768,
      "maximum": 65536,
      "minimum": 4096,
      "title": "Max Record Bytes",
      "type": "integer"
    },
    "origins": {
      "$ref": "#/$defs/OriginWindow"
    },
    "parent_budget": {
      "$ref": "#/$defs/CampaignParentBudget",
      "default": {
        "batch_rows": 256,
        "max_parent_bytes": 2147483648,
        "max_parent_files": 10000,
        "max_rows_per_parent": 20000000
      }
    },
    "phase": {
      "const": "development",
      "default": "development",
      "title": "Phase",
      "type": "string"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "purge_days": {
      "default": 15,
      "maximum": 90,
      "minimum": 15,
      "title": "Purge Days",
      "type": "integer"
    },
    "resource_qualified": {
      "const": false,
      "default": false,
      "title": "Resource Qualified",
      "type": "boolean"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/RoleWindow"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Roles",
      "type": "array"
    },
    "source_recipe_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Recipe Sha256",
      "type": "string"
    },
    "version": {
      "const": "ai09-campaign-development-export-plan-1.0.0",
      "default": "ai09-campaign-development-export-plan-1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "source_recipe_sha256",
    "generation_operation_id",
    "origins",
    "roles"
  ],
  "title": "CampaignDevelopmentExportPlan",
  "type": "object"
}
