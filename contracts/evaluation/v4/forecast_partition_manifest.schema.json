{
  "$defs": {
    "CodePin": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "pyarrow_version": {
          "title": "Pyarrow Version",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "version": {
          "const": "forecast-manifests-1.0.0",
          "default": "forecast-manifests-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "dependency_lock_sha256",
        "python_version",
        "pyarrow_version"
      ],
      "title": "CodePin",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "FeatureDescriptor": {
      "additionalProperties": false,
      "properties": {
        "calendar_id": {
          "pattern": "^forecast-calendar-sha256-[0-9a-f]{64}$",
          "title": "Calendar Id",
          "type": "string"
        },
        "canonicalization": {
          "const": "retailops-canonical-json-v1",
          "default": "retailops-canonical-json-v1",
          "title": "Canonicalization",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/CodePin"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "feature_types": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Feature Types",
          "type": "object"
        },
        "history_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "History Content Sha256",
          "type": "string"
        },
        "input_code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Code Sha256",
          "type": "string"
        },
        "inputs_id": {
          "pattern": "^forecast-inputs-sha256-[0-9a-f]{64}$",
          "title": "Inputs Id",
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "requested_policy": {
          "$ref": "#/$defs/FeaturePolicy"
        },
        "resolved_policy": {
          "$ref": "#/$defs/FeaturePolicy"
        },
        "role": {
          "const": "features",
          "default": "features",
          "title": "Role",
          "type": "string"
        },
        "row_count": {
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Source Parameters",
          "type": "object"
        }
      },
      "required": [
        "parent",
        "calendar_id",
        "inputs_id",
        "source_parameters",
        "requested_policy",
        "resolved_policy",
        "feature_types",
        "code",
        "input_code_sha256",
        "content_sha256",
        "history_content_sha256",
        "row_count"
      ],
      "title": "FeatureDescriptor",
      "type": "object"
    },
    "FeaturePolicy": {
      "additionalProperties": false,
      "properties": {
        "closed_target": {
          "const": "retain_in_coverage_exclude_from_scoring",
          "default": "retain_in_coverage_exclude_from_scoring",
          "title": "Closed Target",
          "type": "string"
        },
        "cold_start": {
          "const": "insufficient_data_no_prediction",
          "default": "insufficient_data_no_prediction",
          "title": "Cold Start",
          "type": "string"
        },
        "columns": {
          "default": [
            "origin_lag_1_units",
            "origin_lag_7_units",
            "origin_lag_14_units",
            "origin_lag_28_units",
            "rolling_mean_7",
            "rolling_std_7",
            "rolling_count_7",
            "rolling_mean_14",
            "rolling_std_14",
            "rolling_count_14",
            "rolling_mean_28",
            "rolling_std_28",
            "rolling_count_28",
            "target_weekday",
            "target_week_of_year",
            "target_month",
            "target_quarter",
            "target_is_weekend",
            "target_is_public_holiday",
            "target_is_easter",
            "target_is_christmas",
            "target_is_black_friday",
            "target_is_cyber_monday",
            "target_location_open",
            "target_is_category_season",
            "category_id",
            "brand",
            "country_code",
            "calendar_jurisdiction",
            "channel",
            "planned_regular_price_minor_units",
            "currency",
            "planned_promotion_offered",
            "planned_promotion_type",
            "planned_promotion_discount_basis_points",
            "planned_promotion_minimum_quantity"
          ],
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "inventory": {
          "const": "excluded",
          "default": "excluded",
          "title": "Inventory",
          "type": "string"
        },
        "maximum_observation_age_days": {
          "default": 3,
          "maximum": 28,
          "minimum": 1,
          "title": "Maximum Observation Age Days",
          "type": "integer"
        },
        "minimum_active_history_days": {
          "default": 28,
          "maximum": 28,
          "minimum": 1,
          "title": "Minimum Active History Days",
          "type": "integer"
        },
        "minimum_known_history_days": {
          "default": 7,
          "maximum": 28,
          "minimum": 1,
          "title": "Minimum Known History Days",
          "type": "integer"
        },
        "missing_features": {
          "const": "retain_nullable_values_and_fit_train_only",
          "default": "retain_nullable_values_and_fit_train_only",
          "title": "Missing Features",
          "type": "string"
        },
        "preprocessing": {
          "$ref": "#/$defs/PreprocessingRecipe",
          "default": {
            "boolean_missing": "train_mode_tie_false_with_indicator",
            "categorical": "train_vocabulary_one_hot_with_missing_and_unknown",
            "entirely_missing": "constant_zero_with_indicator",
            "fit_scope": "eligible_train_rows_of_one_fold_only",
            "numeric_missing": "train_median_with_indicator",
            "output_numbers": "float64_model_inputs_raw_money_remains_exact",
            "scaling": "none",
            "version": "forecast-train-only-1.0.0"
          }
        },
        "stale_history": {
          "const": "block_run_no_partial_success",
          "default": "block_run_no_partial_success",
          "title": "Stale History",
          "type": "string"
        },
        "truth": {
          "const": "excluded",
          "default": "excluded",
          "title": "Truth",
          "type": "string"
        },
        "version": {
          "const": "forecast-features-1.0.0",
          "default": "forecast-features-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "FeaturePolicy",
      "type": "object"
    },
    "ForecastPartitionPolicy": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "const": "fit_after_recipe_selection_on_calibration_only",
          "default": "fit_after_recipe_selection_on_calibration_only",
          "title": "Calibration",
          "type": "string"
        },
        "development_evaluation_access_authorized": {
          "const": false,
          "default": false,
          "title": "Development Evaluation Access Authorized",
          "type": "boolean"
        },
        "final_test_access_authorized": {
          "const": false,
          "default": false,
          "title": "Final Test Access Authorized",
          "type": "boolean"
        },
        "holdout_freshness": {
          "const": "not_asserted_requires_outcome_access_audit",
          "default": "not_asserted_requires_outcome_access_audit",
          "title": "Holdout Freshness",
          "type": "string"
        },
        "independence": {
          "const": "chronological_roles_not_a_statistical_independence_claim",
          "default": "chronological_roles_not_a_statistical_independence_claim",
          "title": "Independence",
          "type": "string"
        },
        "label_delay_days": {
          "default": 1,
          "maximum": 30,
          "minimum": 1,
          "title": "Label Delay Days",
          "type": "integer"
        },
        "max_artifact_bytes": {
          "default": 134217728,
          "maximum": 134217728,
          "minimum": 1024,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "max_horizon_days": {
          "const": 14,
          "default": 14,
          "title": "Max Horizon Days",
          "type": "integer"
        },
        "max_index_bytes": {
          "default": 134217728,
          "maximum": 134217728,
          "minimum": 4096,
          "title": "Max Index Bytes",
          "type": "integer"
        },
        "max_population_rows": {
          "default": 100000,
          "maximum": 100000,
          "minimum": 5,
          "title": "Max Population Rows",
          "type": "integer"
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "preprocessing": {
          "const": "fit_on_train_only",
          "default": "fit_on_train_only",
          "title": "Preprocessing",
          "type": "string"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "purge_days": {
          "default": 15,
          "maximum": 90,
          "minimum": 15,
          "title": "Purge Days",
          "type": "integer"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleWindow"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Roles",
          "type": "array"
        },
        "version": {
          "const": "ai09-independent-forecast-partitions-1.0.0",
          "default": "ai09-independent-forecast-partitions-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "roles"
      ],
      "title": "ForecastPartitionPolicy",
      "type": "object"
    },
    "JsonValue": {},
    "Parent": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "curated_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Curated Descriptor Sha256",
          "type": "string"
        },
        "forecast_source_status": {
          "const": "passed",
          "title": "Forecast Source Status",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snapshot-sha256-[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id",
        "snapshot_id",
        "curated_descriptor_sha256",
        "business_timezone",
        "forecast_source_status"
      ],
      "title": "Parent",
      "type": "object"
    },
    "PartitionDescriptor": {
      "additionalProperties": false,
      "properties": {
        "evaluation_status": {
          "const": "not_ready",
          "default": "not_ready",
          "title": "Evaluation Status",
          "type": "string"
        },
        "feature_descriptor": {
          "$ref": "#/$defs/FeatureDescriptor"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "outcome_eligibility": {
          "const": "not_checked_no_label_files_read",
          "default": "not_checked_no_label_files_read",
          "title": "Outcome Eligibility",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/ForecastPartitionPolicy"
        },
        "populations": {
          "additionalProperties": {
            "$ref": "#/$defs/PartitionFile"
          },
          "propertyNames": {
            "enum": [
              "train",
              "early_stopping",
              "tune",
              "calibration",
              "development_evaluation",
              "purged"
            ]
          },
          "title": "Populations",
          "type": "object"
        },
        "runtime": {
          "$ref": "#/$defs/PreparationRuntime"
        }
      },
      "required": [
        "policy",
        "feature_set_id",
        "feature_descriptor",
        "runtime",
        "populations"
      ],
      "title": "PartitionDescriptor",
      "type": "object"
    },
    "PartitionFile": {
      "additionalProperties": false,
      "properties": {
        "keys_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Keys Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "row_count",
        "size_bytes",
        "sha256",
        "keys_sha256"
      ],
      "title": "PartitionFile",
      "type": "object"
    },
    "PreparationRuntime": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "python_version": {
          "pattern": "^3\\.11\\.[0-9]+$",
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "dependency_lock_sha256",
        "python_version"
      ],
      "title": "PreparationRuntime",
      "type": "object"
    },
    "PreprocessingRecipe": {
      "additionalProperties": false,
      "properties": {
        "boolean_missing": {
          "const": "train_mode_tie_false_with_indicator",
          "default": "train_mode_tie_false_with_indicator",
          "title": "Boolean Missing",
          "type": "string"
        },
        "categorical": {
          "const": "train_vocabulary_one_hot_with_missing_and_unknown",
          "default": "train_vocabulary_one_hot_with_missing_and_unknown",
          "title": "Categorical",
          "type": "string"
        },
        "entirely_missing": {
          "const": "constant_zero_with_indicator",
          "default": "constant_zero_with_indicator",
          "title": "Entirely Missing",
          "type": "string"
        },
        "fit_scope": {
          "const": "eligible_train_rows_of_one_fold_only",
          "default": "eligible_train_rows_of_one_fold_only",
          "title": "Fit Scope",
          "type": "string"
        },
        "numeric_missing": {
          "const": "train_median_with_indicator",
          "default": "train_median_with_indicator",
          "title": "Numeric Missing",
          "type": "string"
        },
        "output_numbers": {
          "const": "float64_model_inputs_raw_money_remains_exact",
          "default": "float64_model_inputs_raw_money_remains_exact",
          "title": "Output Numbers",
          "type": "string"
        },
        "scaling": {
          "const": "none",
          "default": "none",
          "title": "Scaling",
          "type": "string"
        },
        "version": {
          "const": "forecast-train-only-1.0.0",
          "default": "forecast-train-only-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "PreprocessingRecipe",
      "type": "object"
    },
    "RoleWindow": {
      "additionalProperties": false,
      "properties": {
        "label_knowledge_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Label Knowledge Cutoff",
          "type": "string"
        },
        "origins": {
          "$ref": "#/$defs/DateWindow"
        },
        "role": {
          "enum": [
            "train",
            "early_stopping",
            "tune",
            "calibration",
            "development_evaluation"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "origins",
        "label_knowledge_cutoff"
      ],
      "title": "RoleWindow",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:forecast_partition_manifest:4.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/PartitionDescriptor"
    },
    "development_evaluation_access_authorized": {
      "const": false,
      "default": false,
      "title": "Development Evaluation Access Authorized",
      "type": "boolean"
    },
    "final_test_access_authorized": {
      "const": false,
      "default": false,
      "title": "Final Test Access Authorized",
      "type": "boolean"
    },
    "labels_accessed": {
      "const": false,
      "default": false,
      "title": "Labels Accessed",
      "type": "boolean"
    },
    "partition_id": {
      "pattern": "^ai09-partitions-sha256-[0-9a-f]{64}$",
      "title": "Partition Id",
      "type": "string"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "ai09-independent-forecast-partitions-1.0.0",
      "default": "ai09-independent-forecast-partitions-1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "partition_id",
    "descriptor"
  ],
  "title": "ForecastPartitionManifest",
  "type": "object"
}
