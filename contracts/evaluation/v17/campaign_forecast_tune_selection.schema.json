        {
          "type": "null"
        }
      ],
      "title": "Baseline Interval"
    },
    "baseline_mean": {
      "anyOf": [
        {
          "enum": [
            "history7",
            "history28",
            "weekday28"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Mean"
    },
    "baseline_median": {
      "anyOf": [
        {
          "enum": [
            "history7",
            "history28",
            "weekday28"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Median"
