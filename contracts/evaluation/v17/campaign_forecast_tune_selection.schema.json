        {
          "$ref": "#/$defs/CampaignForecastChoice"
        },
        {
          "type": "null"
        }
      ]
    },
    "eligible_rows": {
      "minimum": 0,
      "title": "Eligible Rows",
      "type": "integer"
    },
    "final_test_accessed": {
      "const": false,
      "default": false,
      "title": "Final Test Accessed",
      "type": "boolean"
    },
    "independent_evaluation_accessed": {
      "const": false,
      "default": false,
      "title": "Independent Evaluation Accessed",
      "type": "boolean"
    },
    "mean": {
      "anyOf": [
        {
          "$ref": "#/$defs/CampaignForecastChoice"
        },
        {
          "type": "null"
        }
      ]
    },
    "median": {
      "anyOf": [
        {
          "$ref": "#/$defs/CampaignForecastChoice"
        },
        {
          "type": "null"
        }
      ]
