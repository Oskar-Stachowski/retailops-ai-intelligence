  "$id": "urn:retailops:evaluation:development_policy_set:38.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One prospective rule set, shared by every development scale and final seed.\n\nThe anomaly reference is the existing AI07 numerical policy, not a claim\nthat new data belong to its original campaign. Current evaluation still\nrequires a separately bound AI09 report and original source evidence.",
  "properties": {
    "actual_source_catalog_verified": {
      "const": false,
      "default": false,
      "title": "Actual Source Catalog Verified",
      "type": "boolean"
    },
    "anomaly_metrics": {
      "$ref": "#/$defs/EvaluationPolicy",
      "default": {
        "average_precision": "score_ties_grouped_stepwise_average_precision",
        "early_lead_days": 0,
        "episode_coverage": "all_mature_episodes_in_complete_requested_census",
        "false_alert_denominator": "scored_mature_truth_clean_observations",
        "late_tolerance_days": 1,
        "overlap": "reject_truth_overlap_then_earliest_end_id_for_tolerance",
        "repeat_alerts": "report_without_increasing_episode_recall",
        "unknown_truth": "excluded_and_counted",
        "version": "anomaly-evaluation-1.0.0",
        "zero_prediction_precision": "not_evaluable"
      }
    },
    "anomaly_reference_quality": {
      "$ref": "#/$defs/QualityPolicy"
    },
    "catalog": {
      "$ref": "#/$defs/SourceCatalogPolicyPin"
    },
    "final_test_access_authorized": {
      "const": false,
      "default": false,
      "title": "Final Test Access Authorized",
      "type": "boolean"
    },
    "forecast_quality": {
      "$ref": "#/$defs/CampaignForecastQualityPolicy",
      "default": {
        "evaluation_use": "independent_and_final_after_frozen_selection_no_reselection",
        "interval_objective": "central_interval_score_no_regression_against_baseline",
        "legacy_width_ratio_threshold": 2.0,
        "maximum_absolute_normalized_mean_bias": 0.1,
        "maximum_segment_mae_regression": 0.1,
        "minimum_calibration_rows_per_horizon": 100,
        "minimum_eligibility_coverage": 0.8,
        "minimum_empirical_coverage": 0.8,
        "minimum_global_rows": 100,
        "minimum_prediction_coverage": 1.0,
        "minimum_relative_mae_improvement": 0.05,
        "minimum_segment_rows": 30,
        "nominal_coverage": 0.9,
        "reference_functionals": "separate_tune_choices_not_a_joint_distribution",
        "version": "ai09-campaign-forecast-quality-1.0.0",
        "zero_actuals": "absolute_errors_and_false_positive_units_no_ratio_gate"
      }
    },
    "model_fit_authorized": {
      "const": false,
      "default": false,
      "title": "Model Fit Authorized",
      "type": "boolean"
    },
    "required_groups": {
      "$ref": "#/$defs/CampaignRequiredGroupRecipe"
    },
    "scenario_weights": {
      "additionalProperties": {
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "title": "Scenario Weights",
      "type": "object"
    },
    "seed_weights": {
      "additionalProperties": {
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "title": "Seed Weights",
      "type": "object"
    },
    "stage_ready": {
      "const": false,
      "default": false,
      "title": "Stage Ready",
      "type": "boolean"
    },
    "stockout_decision_reference": {
      "$ref": "#/$defs/PolicySpec"
    },
    "stockout_labels": {
      "$ref": "#/$defs/LabelPolicy",
      "default": {
        "episode_policy": "zero_after_event_including_instantaneous",
        "horizon_days": 7,
        "max_ledger_rows": 100000,
        "max_snapshot_age_seconds": 86400,
        "max_windows": 10000,
        "reservation_policy": "none",
        "stock_measure": "available_qty",
        "version": "incident-stockout-labels-1.0.0"
      }
    },
    "stockout_metric_rules": {
      "const": "native_AP_above_no_skill_Brier_below_train_constant_ECE_and_complete_segment_support",
      "default": "native_AP_above_no_skill_Brier_below_train_constant_ECE_and_complete_segment_support",
      "title": "Stockout Metric Rules",
      "type": "string"
    },
    "stockout_quality": {
      "additionalProperties": {
        "$ref": "#/$defs/QualityRequirements"
      },
      "propertyNames": {
        "enum": [
          "development",
          "final"
        ]
      },
      "title": "Stockout Quality",
      "type": "object"
    },
    "uncertainty": {
      "$ref": "#/$defs/CampaignForecastUncertaintyPolicy",
      "default": {
        "assumptions": [
          "time_blocks_approximate_weak_dependence_no_stationarity_guarantee",
          "series_clusters_assume_between_cluster_independence",
          "methods_are_separate_sensitivity_reports_not_joint_multiway_inference"
        ],
        "confidence_level": 0.95,
        "final_access_authorized": false,
        "independent_row_resampling": false,
        "max_cluster_cells": 100000,
        "max_index_bytes": 1073741824,
        "max_resampled_cluster_visits": 10000000,
        "max_rows": 10000000,
        "methods": [
          "time_block",
          "series_cluster"
        ],
        "minimum_eligible_series_clusters": 30,
        "minimum_eligible_time_blocks": 8,
        "nominal_coverage_guaranteed": false,
        "nominal_interval_coverage": 0.9,
        "pairing": "same_cluster_multiplicities_for_candidate_reference_and_actual",
        "partial_boundary_blocks": "retain_full_membership_never_drop_rows",
        "promotion_allowed": false,
        "quantile_method": "linear_percentile",
        "random_generator": "numpy_PCG64",
        "resamples": 999,
        "resampling_seed": 137,
        "series_clusters": "whole_product_selling_location_channel_all_origins_and_horizons",
        "stage_ready": false,
        "time_basis": "forecast_origin_utc_calendar_day",
        "time_block_anchor": "2000-01-03",
        "time_block_days": 28,
        "time_blocks": "fixed_disjoint_calendar_blocks_all_series_jointly",
        "version": "ai09-paired-cluster-uncertainty-1.0.0"
      }
    },
    "version": {
      "const": "ai09-prospective-development-policies-1.0.0",
      "default": "ai09-prospective-development-policies-1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "catalog",
    "required_groups",
    "anomaly_reference_quality",
    "stockout_quality",
    "stockout_decision_reference",
    "seed_weights",
    "scenario_weights"
  ],
  "title": "DevelopmentPolicySet",
  "type": "object"
}
