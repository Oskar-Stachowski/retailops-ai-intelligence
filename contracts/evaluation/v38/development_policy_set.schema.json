          "maxItems": 3,
          "minItems": 3,
          "title": "Variants",
          "type": "array"
        },
        "version": {
          "const": "ai09-prospective-required-group-recipe-1.0.0",
          "default": "ai09-prospective-required-group-recipe-1.0.0",
          "title": "Version",
          "type": "string"
