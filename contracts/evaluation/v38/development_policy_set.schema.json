{
  "$defs": {
    "AttentionCosts": {
      "additionalProperties": false,
      "properties": {
        "false_attention": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "False Attention",
          "type": "number"
        },
        "interpretation": {
          "const": "operator_proposal_not_validated_business_savings",
          "default": "operator_proposal_not_validated_business_savings",
          "title": "Interpretation",
          "type": "string"
        },
        "missed_incident": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Missed Incident",
          "type": "number"
        }
      },
      "required": [
        "false_attention",
        "missed_incident"
      ],
      "title": "AttentionCosts",
      "type": "object"
    },
    "CampaignForecastQualityPolicy": {
      "additionalProperties": false,
      "description": "The same numerical gates as v2, with an explicit campaign evaluation scope.",
      "properties": {
        "evaluation_use": {
          "const": "independent_and_final_after_frozen_selection_no_reselection",
          "default": "independent_and_final_after_frozen_selection_no_reselection",
          "title": "Evaluation Use",
          "type": "string"
        },
        "interval_objective": {
          "const": "central_interval_score_no_regression_against_baseline",
          "default": "central_interval_score_no_regression_against_baseline",
          "title": "Interval Objective",
          "type": "string"
        },
        "legacy_width_ratio_threshold": {
          "default": 2.0,
          "maximum": 2.0,
          "minimum": 2.0,
          "title": "Legacy Width Ratio Threshold",
          "type": "number"
        },
        "maximum_absolute_normalized_mean_bias": {
          "default": 0.1,
          "maximum": 0.1,
          "minimum": 0.1,
          "title": "Maximum Absolute Normalized Mean Bias",
          "type": "number"
        },
        "maximum_segment_mae_regression": {
          "default": 0.1,
          "maximum": 0.1,
          "minimum": 0.1,
          "title": "Maximum Segment Mae Regression",
          "type": "number"
        },
        "minimum_calibration_rows_per_horizon": {
          "const": 100,
          "default": 100,
          "title": "Minimum Calibration Rows Per Horizon",
          "type": "integer"
        },
        "minimum_eligibility_coverage": {
          "default": 0.8,
          "maximum": 0.8,
          "minimum": 0.8,
          "title": "Minimum Eligibility Coverage",
          "type": "number"
        },
        "minimum_empirical_coverage": {
          "default": 0.8,
          "maximum": 0.8,
          "minimum": 0.8,
          "title": "Minimum Empirical Coverage",
          "type": "number"
        },
        "minimum_global_rows": {
          "const": 100,
          "default": 100,
          "title": "Minimum Global Rows",
          "type": "integer"
        },
        "minimum_prediction_coverage": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Minimum Prediction Coverage",
          "type": "number"
        },
        "minimum_relative_mae_improvement": {
          "default": 0.05,
          "maximum": 0.05,
          "minimum": 0.05,
          "title": "Minimum Relative Mae Improvement",
          "type": "number"
        },
        "minimum_segment_rows": {
          "const": 30,
          "default": 30,
          "title": "Minimum Segment Rows",
          "type": "integer"
        },
        "nominal_coverage": {
          "default": 0.9,
          "maximum": 0.9,
          "minimum": 0.9,
          "title": "Nominal Coverage",
          "type": "number"
        },
        "reference_functionals": {
          "const": "separate_tune_choices_not_a_joint_distribution",
          "default": "separate_tune_choices_not_a_joint_distribution",
          "title": "Reference Functionals",
          "type": "string"
        },
        "version": {
          "const": "ai09-campaign-forecast-quality-1.0.0",
          "default": "ai09-campaign-forecast-quality-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "zero_actuals": {
          "const": "absolute_errors_and_false_positive_units_no_ratio_gate",
          "default": "absolute_errors_and_false_positive_units_no_ratio_gate",
          "title": "Zero Actuals",
          "type": "string"
        }
      },
      "title": "CampaignForecastQualityPolicy",
      "type": "object"
    },
    "CampaignForecastSegmentPolicy": {
      "additionalProperties": false,
      "properties": {
        "availability_membership": {
          "const": "independent_boolean_strata_overlap_not_a_partition",
          "default": "independent_boolean_strata_overlap_not_a_partition",
          "title": "Availability Membership",
          "type": "string"
        },
        "categories": {
          "const": "complete_verified_source_catalog_not_selected_from_outcomes",
          "default": "complete_verified_source_catalog_not_selected_from_outcomes",
          "title": "Categories",
          "type": "string"
        },
        "category_inventory": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Category Inventory",
          "type": "array"
        },
        "final_access_authorized": {
          "const": false,
          "default": false,
          "title": "Final Access Authorized",
          "type": "boolean"
        },
        "intermittency_basis": {
          "const": "known_open_history_days_missing_or_closed_are_not_sales_zeros",
          "default": "known_open_history_days_missing_or_closed_are_not_sales_zeros",
          "title": "Intermittency Basis",
          "type": "string"
        },
        "inventory_basis": {
          "const": "origin_known_unreserved_available_quantity_not_future_stock",
          "default": "origin_known_unreserved_available_quantity_not_future_stock",
          "title": "Inventory Basis",
          "type": "string"
        },
        "late_observation_hours": {
          "default": 24,
          "maximum": 168,
          "minimum": 1,
          "title": "Late Observation Hours",
          "type": "integer"
        },
        "lead_time_basis": {
          "const": "origin_known_supplier_quote_not_realized_delivery_or_truth",
          "default": "origin_known_supplier_quote_not_realized_delivery_or_truth",
          "title": "Lead Time Basis",
          "type": "string"
        },
        "lead_time_boundaries": {
          "default": [
            2,
            7
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": 2,
              "type": "integer"
            },
            {
              "const": 7,
              "type": "integer"
            }
          ],
          "title": "Lead Time Boundaries",
          "type": "array"
        },
        "max_rows": {
          "default": 10000000,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "max_segments": {
          "default": 512,
          "maximum": 4096,
          "minimum": 60,
          "title": "Max Segments",
          "type": "integer"
        },
        "maximum_inventory_snapshot_age_hours": {
          "const": 24,
          "default": 24,
          "title": "Maximum Inventory Snapshot Age Hours",
          "type": "integer"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "scenario_basis": {
          "const": "source_bound_preregistered_annotation_never_actual_target",
          "default": "source_bound_preregistered_annotation_never_actual_target",
          "title": "Scenario Basis",
          "type": "string"
        },
        "stage_ready": {
          "const": false,
          "default": false,
          "title": "Stage Ready",
          "type": "boolean"
        },
        "version": {
          "const": "ai09-complete-forecast-segments-1.0.0",
          "default": "ai09-complete-forecast-segments-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "volume_basis": {
          "const": "origin_known_rolling_28_mean_not_target_outcome",
          "default": "origin_known_rolling_28_mean_not_target_outcome",
          "title": "Volume Basis",
          "type": "string"
        },
        "volume_boundaries": {
          "default": [
            0,
            5,
            20
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": 0,
              "type": "integer"
            },
            {
              "const": 5,
              "type": "integer"
            },
            {
              "const": 20,
              "type": "integer"
            }
          ],
          "title": "Volume Boundaries",
          "type": "array"
        }
      },
      "required": [
        "category_inventory"
      ],
      "title": "CampaignForecastSegmentPolicy",
      "type": "object"
    },
    "CampaignForecastUncertaintyPolicy": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [
            "time_blocks_approximate_weak_dependence_no_stationarity_guarantee",
            "series_clusters_assume_between_cluster_independence",
            "methods_are_separate_sensitivity_reports_not_joint_multiway_inference"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "time_blocks_approximate_weak_dependence_no_stationarity_guarantee",
              "type": "string"
            },
            {
              "const": "series_clusters_assume_between_cluster_independence",
              "type": "string"
            },
            {
              "const": "methods_are_separate_sensitivity_reports_not_joint_multiway_inference",
              "type": "string"
            }
          ],
          "title": "Assumptions",
          "type": "array"
        },
        "confidence_level": {
          "default": 0.95,
          "maximum": 0.99,
          "minimum": 0.8,
          "title": "Confidence Level",
          "type": "number"
        },
        "final_access_authorized": {
          "const": false,
          "default": false,
          "title": "Final Access Authorized",
          "type": "boolean"
        },
        "independent_row_resampling": {
          "const": false,
          "default": false,
          "title": "Independent Row Resampling",
          "type": "boolean"
        },
        "max_cluster_cells": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 2,
          "title": "Max Cluster Cells",
          "type": "integer"
        },
        "max_index_bytes": {
          "default": 1073741824,
          "maximum": 8589934592,
          "minimum": 4096,
          "title": "Max Index Bytes",
          "type": "integer"
        },
        "max_resampled_cluster_visits": {
          "default": 10000000,
          "maximum": 100000000,
          "minimum": 398,
          "title": "Max Resampled Cluster Visits",
          "type": "integer"
        },
        "max_rows": {
          "default": 10000000,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "methods": {
          "default": [
            "time_block",
            "series_cluster"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "time_block",
              "type": "string"
            },
            {
              "const": "series_cluster",
              "type": "string"
            }
          ],
          "title": "Methods",
          "type": "array"
        },
        "minimum_eligible_series_clusters": {
          "default": 30,
          "maximum": 10000,
          "minimum": 2,
          "title": "Minimum Eligible Series Clusters",
          "type": "integer"
        },
        "minimum_eligible_time_blocks": {
          "default": 8,
          "maximum": 1000,
          "minimum": 2,
          "title": "Minimum Eligible Time Blocks",
          "type": "integer"
        },
        "nominal_coverage_guaranteed": {
          "const": false,
          "default": false,
          "title": "Nominal Coverage Guaranteed",
          "type": "boolean"
        },
        "nominal_interval_coverage": {
          "default": 0.9,
          "maximum": 0.9,
          "minimum": 0.9,
          "title": "Nominal Interval Coverage",
          "type": "number"
        },
        "pairing": {
          "const": "same_cluster_multiplicities_for_candidate_reference_and_actual",
          "default": "same_cluster_multiplicities_for_candidate_reference_and_actual",
          "title": "Pairing",
          "type": "string"
        },
        "partial_boundary_blocks": {
          "const": "retain_full_membership_never_drop_rows",
          "default": "retain_full_membership_never_drop_rows",
          "title": "Partial Boundary Blocks",
          "type": "string"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "quantile_method": {
          "const": "linear_percentile",
          "default": "linear_percentile",
          "title": "Quantile Method",
          "type": "string"
        },
        "random_generator": {
          "const": "numpy_PCG64",
          "default": "numpy_PCG64",
          "title": "Random Generator",
          "type": "string"
        },
        "resamples": {
          "default": 999,
          "maximum": 9999,
          "minimum": 199,
          "title": "Resamples",
          "type": "integer"
        },
        "resampling_seed": {
          "default": 137,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Resampling Seed",
          "type": "integer"
        },
        "series_clusters": {
          "const": "whole_product_selling_location_channel_all_origins_and_horizons",
          "default": "whole_product_selling_location_channel_all_origins_and_horizons",
          "title": "Series Clusters",
          "type": "string"
        },
        "stage_ready": {
          "const": false,
          "default": false,
          "title": "Stage Ready",
          "type": "boolean"
        },
        "time_basis": {
          "const": "forecast_origin_utc_calendar_day",
          "default": "forecast_origin_utc_calendar_day",
          "title": "Time Basis",
          "type": "string"
        },
        "time_block_anchor": {
          "default": "2000-01-03",
          "format": "date",
          "title": "Time Block Anchor",
          "type": "string"
        },
        "time_block_days": {
          "default": 28,
          "maximum": 365,
          "minimum": 14,
          "title": "Time Block Days",
          "type": "integer"
        },
        "time_blocks": {
          "const": "fixed_disjoint_calendar_blocks_all_series_jointly",
          "default": "fixed_disjoint_calendar_blocks_all_series_jointly",
          "title": "Time Blocks",
          "type": "string"
        },
        "version": {
          "const": "ai09-paired-cluster-uncertainty-1.0.0",
          "default": "ai09-paired-cluster-uncertainty-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "CampaignForecastUncertaintyPolicy",
      "type": "object"
    },
    "CampaignRequiredGroup": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "global",
            "horizon",
            "category",
            "channel",
            "volume",
            "scenario",
            "history",
            "availability",
            "inventory",
            "lead_time",
            "intermittency",
            "anomaly"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "CampaignRequiredGroup",
      "type": "object"
    },
