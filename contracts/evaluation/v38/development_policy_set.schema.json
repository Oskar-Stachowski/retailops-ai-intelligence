          "minItems": 1,
          "title": "Required",
          "type": "array"
        },
        "variant": {
          "enum": [
            "ordinary",
            "demand",
            "physical"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "variant",
        "required"
      ],
      "title": "CampaignVariantRequiredGroups",
      "type": "object"
    },
