          "type": "string"
        },
        "stage_ready": {
          "const": false,
          "default": false,
          "title": "Stage Ready",
          "type": "boolean"
        },
        "unknown_category_encoding_qualified": {
          "const": false,
          "default": false,
          "title": "Unknown Category Encoding Qualified",
          "type": "boolean"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/CampaignVariantRequiredGroups"
