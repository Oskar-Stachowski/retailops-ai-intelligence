    },
    "export_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Export Receipt Sha256",
      "type": "string"
    },
    "final_test_accessed": {
      "const": false,
      "default": false,
      "title": "Final Test Accessed",
      "type": "boolean"
    },
    "fit_receipt_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "rf",
          "hgb",
          "tensorflow"
        ]
      },
      "title": "Fit Receipt Sha256",
      "type": "object"
    },
    "keys_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Keys Sha256",
      "type": "string"
    },
    "model_artifact_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "rf",
          "hgb",
          "tensorflow"
        ]
      },
      "title": "Model Artifact Sha256",
      "type": "object"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Operation Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/CampaignForecastScorePlan"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "quality_qualified": {
      "const": false,
      "default": false,
      "title": "Quality Qualified",
      "type": "boolean"
    },
    "reservation_id": {
      "pattern": "^campaign-operation-[0-9a-f]{32}$",
      "title": "Reservation Id",
      "type": "string"
    },
    "role_population_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Role Population Sha256",
      "type": "string"
    },
    "rows": {
      "minimum": 1,
      "title": "Rows",
      "type": "integer"
    },
    "runtime_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Code Sha256",
      "type": "string"
    },
    "stage_ready": {
      "const": false,
      "default": false,
      "title": "Stage Ready",
      "type": "boolean"
    },
    "version": {
      "const": "ai09-campaign-raw-forecast-score-receipt-1.0.0",
      "default": "ai09-campaign-raw-forecast-score-receipt-1.0.0",
      "title": "Version",
      "type": "string"
