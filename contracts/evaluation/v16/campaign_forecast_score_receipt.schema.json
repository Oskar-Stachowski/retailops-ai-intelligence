    "artifact_bytes": {
      "minimum": 1,
      "title": "Artifact Bytes",
      "type": "integer"
    },
    "artifact_files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Artifact Files",
      "type": "object"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "calibration_fitted": {
      "const": false,
      "default": false,
