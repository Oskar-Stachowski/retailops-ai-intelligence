    "operation_id",
    "reservation_id",
    "plan",
    "export_receipt_sha256",
    "fit_receipt_sha256",
    "model_artifact_sha256",
    "dataset_id",
    "runtime_code_sha256",
    "role_population_sha256",
    "rows",
    "eligible_rows",
    "keys_sha256",
    "eligible_keys_sha256",
    "artifact_sha256",
    "artifact_bytes",
    "artifact_files",
