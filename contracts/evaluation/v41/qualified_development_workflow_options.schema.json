{
  "$defs": {
    "CampaignGenerationResources": {
      "additionalProperties": false,
      "properties": {
        "cpu_threads": {
          "const": 1,
          "default": 1,
          "title": "Cpu Threads",
          "type": "integer"
        },
        "max_log_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "minimum_available_memory_bytes": {
          "minimum": 1024,
          "title": "Minimum Available Memory Bytes",
          "type": "integer"
        },
        "minimum_free_disk_bytes": {
          "minimum": 1024,
          "title": "Minimum Free Disk Bytes",
          "type": "integer"
        },
        "sample_seconds": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0.01,
          "title": "Sample Seconds",
          "type": "number"
        },
        "scratch_bytes": {
          "maximum": 137438953472,
          "minimum": 1024,
          "title": "Scratch Bytes",
          "type": "integer"
        },
        "tree_rss_bytes": {
          "maximum": 68719476736,
          "minimum": 1024,
          "title": "Tree Rss Bytes",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "tree_rss_bytes",
        "scratch_bytes",
        "minimum_free_disk_bytes",
        "minimum_available_memory_bytes"
      ],
      "title": "CampaignGenerationResources",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "ForecastPartitionPolicy": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "const": "fit_after_recipe_selection_on_calibration_only",
          "default": "fit_after_recipe_selection_on_calibration_only",
          "title": "Calibration",
          "type": "string"
        },
        "development_evaluation_access_authorized": {
          "const": false,
          "default": false,
          "title": "Development Evaluation Access Authorized",
          "type": "boolean"
        },
        "final_test_access_authorized": {
          "const": false,
          "default": false,
          "title": "Final Test Access Authorized",
          "type": "boolean"
        },
        "holdout_freshness": {
          "const": "not_asserted_requires_outcome_access_audit",
          "default": "not_asserted_requires_outcome_access_audit",
          "title": "Holdout Freshness",
          "type": "string"
        },
        "independence": {
          "const": "chronological_roles_not_a_statistical_independence_claim",
          "default": "chronological_roles_not_a_statistical_independence_claim",
          "title": "Independence",
          "type": "string"
        },
        "label_delay_days": {
          "default": 1,
          "maximum": 30,
          "minimum": 1,
          "title": "Label Delay Days",
          "type": "integer"
        },
        "max_artifact_bytes": {
          "default": 134217728,
          "maximum": 134217728,
          "minimum": 1024,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "max_horizon_days": {
          "const": 14,
          "default": 14,
          "title": "Max Horizon Days",
          "type": "integer"
        },
        "max_index_bytes": {
          "default": 134217728,
          "maximum": 134217728,
          "minimum": 4096,
          "title": "Max Index Bytes",
          "type": "integer"
        },
        "max_population_rows": {
          "default": 100000,
          "maximum": 100000,
          "minimum": 5,
          "title": "Max Population Rows",
          "type": "integer"
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "preprocessing": {
          "const": "fit_on_train_only",
          "default": "fit_on_train_only",
          "title": "Preprocessing",
          "type": "string"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "purge_days": {
          "default": 15,
          "maximum": 90,
          "minimum": 15,
          "title": "Purge Days",
          "type": "integer"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleWindow"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Roles",
          "type": "array"
        },
        "version": {
          "const": "ai09-independent-forecast-partitions-1.0.0",
          "default": "ai09-independent-forecast-partitions-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "roles"
      ],
      "title": "ForecastPartitionPolicy",
      "type": "object"
    },
    "ForecastSearchRecipe": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "epochs": {
          "default": 25,
          "maximum": 25,
          "minimum": 1,
          "title": "Epochs",
          "type": "integer"
        },
        "family": {
          "enum": [
            "rf",
            "hgb",
            "tensorflow"
          ],
          "title": "Family",
          "type": "string"
        },
        "hgb": {
          "$ref": "#/$defs/HGBConfig",
          "default": {
            "categorical_features": null,
            "early_stopping": false,
            "l2_regularization": 0.0,
            "learning_rate": 0.1,
            "loss": "squared_error",
            "max_bins": 255,
            "max_iter": 100,
            "max_leaf_nodes": 31,
            "min_samples_leaf": 20,
            "validation_fraction": null
          }
        },
        "learning_rate": {
          "default": 0.001,
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "title": "Learning Rate",
          "type": "number"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "patience": {
          "default": 4,
          "maximum": 5,
          "minimum": 1,
          "title": "Patience",
          "type": "integer"
        },
        "rf": {
          "$ref": "#/$defs/RFConfig",
          "default": {
            "bootstrap": true,
            "criterion": "squared_error",
            "max_depth": 10,
            "max_features": 1.0,
            "min_samples_leaf": 4,
            "min_samples_split": 2,
            "n_estimators": 64,
            "n_jobs": 1
          }
        }
      },
      "required": [
        "name",
        "family"
      ],
      "title": "ForecastSearchRecipe",
      "type": "object"
    },
    "ForecastWorkflowResources": {
      "additionalProperties": false,
      "properties": {
        "fit": {
          "$ref": "#/$defs/CampaignGenerationResources"
        },
        "score": {
          "$ref": "#/$defs/CampaignGenerationResources"
        }
      },
      "required": [
        "fit",
        "score"
      ],
      "title": "ForecastWorkflowResources",
      "type": "object"
    },
    "HGBConfig": {
      "additionalProperties": false,
      "properties": {
        "categorical_features": {
          "default": null,
          "title": "Categorical Features",
          "type": "null"
        },
        "early_stopping": {
          "const": false,
          "default": false,
          "title": "Early Stopping",
          "type": "boolean"
        },
        "l2_regularization": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "L2 Regularization",
          "type": "number"
        },
        "learning_rate": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Learning Rate",
          "type": "number"
        },
        "loss": {
          "const": "squared_error",
          "default": "squared_error",
          "title": "Loss",
          "type": "string"
        },
        "max_bins": {
          "const": 255,
          "default": 255,
          "title": "Max Bins",
          "type": "integer"
        },
        "max_iter": {
          "default": 100,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Iter",
          "type": "integer"
        },
        "max_leaf_nodes": {
          "default": 31,
          "maximum": 63,
          "minimum": 2,
          "title": "Max Leaf Nodes",
          "type": "integer"
        },
        "min_samples_leaf": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "validation_fraction": {
          "default": null,
          "title": "Validation Fraction",
          "type": "null"
        }
      },
      "title": "HGBConfig",
      "type": "object"
    },
    "RFConfig": {
      "additionalProperties": false,
      "properties": {
        "bootstrap": {
          "const": true,
          "default": true,
          "title": "Bootstrap",
          "type": "boolean"
        },
        "criterion": {
          "const": "squared_error",
          "default": "squared_error",
          "title": "Criterion",
          "type": "string"
        },
        "max_depth": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_features": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Features",
          "type": "number"
        },
        "min_samples_leaf": {
          "default": 2,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "min_samples_split": {
          "default": 2,
          "maximum": 200,
          "minimum": 2,
          "title": "Min Samples Split",
          "type": "integer"
        },
        "n_estimators": {
          "default": 64,
          "maximum": 128,
          "minimum": 1,
          "title": "N Estimators",
          "type": "integer"
        },
        "n_jobs": {
          "const": 1,
          "default": 1,
          "title": "N Jobs",
          "type": "integer"
        }
      },
      "title": "RFConfig",
      "type": "object"
    },
    "RoleWindow": {
      "additionalProperties": false,
      "properties": {
        "label_knowledge_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Label Knowledge Cutoff",
          "type": "string"
        },
        "origins": {
          "$ref": "#/$defs/DateWindow"
        },
        "role": {
          "enum": [
            "train",
            "early_stopping",
            "tune",
            "calibration",
            "development_evaluation"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "origins",
        "label_knowledge_cutoff"
      ],
      "title": "RoleWindow",
      "type": "object"
    },
    "SourcePreparationOptions": {
      "additionalProperties": false,
      "properties": {
        "final_test_access_authorized": {
          "const": false,
          "default": false,
          "title": "Final Test Access Authorized",
          "type": "boolean"
        },
        "generation_resources": {
          "$ref": "#/$defs/CampaignGenerationResources"
        },
        "maximum_total_wall_seconds": {
          "default": 10800,
          "maximum": 10800,
          "minimum": 5,
          "title": "Maximum Total Wall Seconds",
          "type": "integer"
        },
        "partitions": {
          "$ref": "#/$defs/ForecastPartitionPolicy"
        },
        "planning_resources": {
          "$ref": "#/$defs/CampaignGenerationResources"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_python": {
          "title": "Producer Python",
          "type": "string"
        },
        "products": {
          "enum": [
            25,
            50,
            100
          ],
          "title": "Products",
          "type": "integer"
        },
        "reuse_resources": {
          "$ref": "#/$defs/CampaignGenerationResources"
        },
        "version": {
          "const": "ai09-original-source-preparation-options-1.0.0",
          "default": "ai09-original-source-preparation-options-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "products",
        "producer",
        "producer_python",
        "partitions",
        "generation_resources",
        "planning_resources",
        "reuse_resources"
      ],
      "title": "SourcePreparationOptions",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:qualified_development_workflow_options:41.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Freeze all 51 operations before Source, including separate calibration cost.",
  "properties": {
    "final_test_access_authorized": {
      "const": false,
      "default": false,
      "title": "Final Test Access Authorized",
      "type": "boolean"
    },
    "maximum_calibrator_fit_attempts": {
      "const": 1,
      "default": 1,
      "title": "Maximum Calibrator Fit Attempts",
      "type": "integer"
    },
    "maximum_fit_attempts": {
      "const": 12,
      "default": 12,
      "title": "Maximum Fit Attempts",
      "type": "integer"
    },
    "maximum_forecast_operations": {
      "const": 36,
      "default": 36,
      "title": "Maximum Forecast Operations",
      "type": "integer"
    },
    "maximum_source_operations": {
      "const": 15,
      "default": 15,
      "title": "Maximum Source Operations",
      "type": "integer"
    },
    "qualification_scope": {
      "const": "ordinary_demand_physical_after_original_calibration",
      "default": "ordinary_demand_physical_after_original_calibration",
      "title": "Qualification Scope",
      "type": "string"
    },
    "recipes": {
      "items": {
        "$ref": "#/$defs/ForecastSearchRecipe"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Recipes",
      "type": "array"
    },
    "resources": {
      "additionalProperties": {
        "$ref": "#/$defs/ForecastWorkflowResources"
      },
      "propertyNames": {
        "enum": [
          "25",
          "50",
          "100"
        ]
      },
      "title": "Resources",
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/SourcePreparationOptions"
    },
    "version": {
      "const": "ai09-qualified-development-workflow-options-1.0.0",
      "default": "ai09-qualified-development-workflow-options-1.0.0",
      "title": "Version",
      "type": "string"
    },
    "worker_environment_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Worker Environment Lock Sha256",
      "type": "string"
    },
    "worker_python": {
      "title": "Worker Python",
      "type": "string"
    }
  },
  "required": [
    "source",
    "worker_python",
    "worker_environment_lock_sha256",
    "recipes",
    "resources"
  ],
  "title": "QualifiedDevelopmentWorkflowOptions",
  "type": "object"
}
