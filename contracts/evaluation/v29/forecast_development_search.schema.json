{
  "$defs": {
    "CampaignForecastTunePolicy": {
      "additionalProperties": false,
      "properties": {
        "baseline_interval_objective": {
          "const": "central_interval_score",
          "default": "central_interval_score",
          "title": "Baseline Interval Objective",
          "type": "string"
        },
        "candidate_interval_center": {
          "const": "selected_median_then_fit_on_calibration_role",
          "default": "selected_median_then_fit_on_calibration_role",
          "title": "Candidate Interval Center",
          "type": "string"
        },
        "maximum_absolute_normalized_mean_bias": {
          "default": 0.1,
          "maximum": 0.1,
          "minimum": 0.1,
          "title": "Maximum Absolute Normalized Mean Bias",
          "type": "number"
        },
        "mean_objective": {
          "const": "mse_with_bias_guard",
          "default": "mse_with_bias_guard",
          "title": "Mean Objective",
          "type": "string"
        },
        "median_objective": {
          "const": "mae",
          "default": "mae",
          "title": "Median Objective",
          "type": "string"
        },
        "minimum_eligibility_coverage": {
          "default": 0.8,
          "maximum": 0.8,
          "minimum": 0.8,
          "title": "Minimum Eligibility Coverage",
          "type": "number"
        },
        "minimum_relative_median_improvement": {
          "default": 0.05,
          "maximum": 0.05,
          "minimum": 0.05,
          "title": "Minimum Relative Median Improvement",
          "type": "number"
        },
        "minimum_rows": {
          "const": 100,
          "default": 100,
          "title": "Minimum Rows",
          "type": "integer"
        },
        "model_order": {
          "default": [
            "history7",
            "history28",
            "weekday28",
            "rf_mean",
            "hgb",
            "tensorflow"
          ],
          "items": {
            "type": "string"
          },
          "title": "Model Order",
          "type": "array"
        },
        "nominal_coverage": {
          "default": 0.9,
          "maximum": 0.9,
          "minimum": 0.9,
          "title": "Nominal Coverage",
          "type": "number"
        },
        "tie_breaker": {
          "const": "baseline_first_then_model_order_then_frozen_trial_order",
          "default": "baseline_first_then_model_order_then_frozen_trial_order",
          "title": "Tie Breaker",
          "type": "string"
        },
        "version": {
          "const": "ai09-forecast-tune-policy-1.0.0",
          "default": "ai09-forecast-tune-policy-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "zero_denominator": {
          "const": "undefined_ratios_no_floor_or_ratio_gate",
          "default": "undefined_ratios_no_floor_or_ratio_gate",
          "title": "Zero Denominator",
          "type": "string"
        }
      },
      "title": "CampaignForecastTunePolicy",
      "type": "object"
    },
    "CampaignGenerationResources": {
      "additionalProperties": false,
      "properties": {
        "cpu_threads": {
          "const": 1,
          "default": 1,
          "title": "Cpu Threads",
          "type": "integer"
        },
        "max_log_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "minimum_available_memory_bytes": {
          "minimum": 1024,
          "title": "Minimum Available Memory Bytes",
          "type": "integer"
        },
        "minimum_free_disk_bytes": {
          "minimum": 1024,
          "title": "Minimum Free Disk Bytes",
          "type": "integer"
        },
        "sample_seconds": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0.01,
          "title": "Sample Seconds",
          "type": "number"
        },
        "scratch_bytes": {
          "maximum": 137438953472,
          "minimum": 1024,
          "title": "Scratch Bytes",
          "type": "integer"
        },
        "tree_rss_bytes": {
          "maximum": 68719476736,
          "minimum": 1024,
          "title": "Tree Rss Bytes",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "tree_rss_bytes",
        "scratch_bytes",
        "minimum_free_disk_bytes",
        "minimum_available_memory_bytes"
      ],
      "title": "CampaignGenerationResources",
      "type": "object"
    },
    "ForecastSearchRecipe": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "epochs": {
          "default": 25,
          "maximum": 25,
          "minimum": 1,
          "title": "Epochs",
          "type": "integer"
        },
        "family": {
          "enum": [
            "rf",
            "hgb",
            "tensorflow"
          ],
          "title": "Family",
          "type": "string"
        },
        "hgb": {
          "$ref": "#/$defs/HGBConfig",
          "default": {
            "categorical_features": null,
            "early_stopping": false,
            "l2_regularization": 0.0,
            "learning_rate": 0.1,
            "loss": "squared_error",
            "max_bins": 255,
            "max_iter": 100,
            "max_leaf_nodes": 31,
            "min_samples_leaf": 20,
            "validation_fraction": null
          }
        },
        "learning_rate": {
          "default": 0.001,
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "title": "Learning Rate",
          "type": "number"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "patience": {
          "default": 4,
          "maximum": 5,
          "minimum": 1,
          "title": "Patience",
          "type": "integer"
        },
        "rf": {
          "$ref": "#/$defs/RFConfig",
          "default": {
            "bootstrap": true,
            "criterion": "squared_error",
            "max_depth": 10,
            "max_features": 1.0,
            "min_samples_leaf": 4,
            "min_samples_split": 2,
            "n_estimators": 64,
            "n_jobs": 1
          }
        }
      },
      "required": [
        "name",
        "family"
      ],
      "title": "ForecastSearchRecipe",
      "type": "object"
    },
    "HGBConfig": {
      "additionalProperties": false,
      "properties": {
        "categorical_features": {
          "default": null,
          "title": "Categorical Features",
          "type": "null"
        },
        "early_stopping": {
          "const": false,
          "default": false,
          "title": "Early Stopping",
          "type": "boolean"
        },
        "l2_regularization": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "L2 Regularization",
          "type": "number"
        },
        "learning_rate": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Learning Rate",
          "type": "number"
        },
        "loss": {
          "const": "squared_error",
          "default": "squared_error",
          "title": "Loss",
          "type": "string"
        },
        "max_bins": {
          "const": 255,
          "default": 255,
          "title": "Max Bins",
          "type": "integer"
        },
        "max_iter": {
          "default": 100,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Iter",
          "type": "integer"
        },
        "max_leaf_nodes": {
          "default": 31,
          "maximum": 63,
          "minimum": 2,
          "title": "Max Leaf Nodes",
          "type": "integer"
        },
        "min_samples_leaf": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "validation_fraction": {
          "default": null,
          "title": "Validation Fraction",
          "type": "null"
        }
      },
      "title": "HGBConfig",
      "type": "object"
    },
    "RFConfig": {
      "additionalProperties": false,
      "properties": {
        "bootstrap": {
          "const": true,
          "default": true,
          "title": "Bootstrap",
          "type": "boolean"
        },
        "criterion": {
          "const": "squared_error",
          "default": "squared_error",
          "title": "Criterion",
          "type": "string"
        },
        "max_depth": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_features": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Features",
          "type": "number"
        },
        "min_samples_leaf": {
          "default": 2,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "min_samples_split": {
          "default": 2,
          "maximum": 200,
          "minimum": 2,
          "title": "Min Samples Split",
          "type": "integer"
        },
        "n_estimators": {
          "default": 64,
          "maximum": 128,
          "minimum": 1,
          "title": "N Estimators",
          "type": "integer"
        },
        "n_jobs": {
          "const": 1,
          "default": 1,
          "title": "N Jobs",
          "type": "integer"
        }
      },
      "title": "RFConfig",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:forecast_development_search:29.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts_per_recipe_and_scale": {
      "const": 1,
      "default": 1,
      "title": "Attempts Per Recipe And Scale",
      "type": "integer"
    },
    "canonical_portfolio_protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Portfolio Protocol Sha256",
      "type": "string"
    },
    "critical_group_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Critical Group Policy Sha256",
      "type": "string"
    },
    "data_seed": {
      "const": 42,
      "default": 42,
      "title": "Data Seed",
      "type": "integer"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "failed_attempts": {
      "const": "consume_slot_retain_cost_and_error_no_automatic_retry",
      "default": "consume_slot_retain_cost_and_error_no_automatic_retry",
      "title": "Failed Attempts",
      "type": "string"
    },
    "family_failure": {
      "const": "retain_failure_and_stop_advancement_if_any_family_has_no_valid_trial",
      "default": "retain_failure_and_stop_advancement_if_any_family_has_no_valid_trial",
      "title": "Family Failure",
      "type": "string"
    },
    "final_choice": {
      "const": "unchanged_native_tune_calibration_and_full_three_use_qualification",
      "default": "unchanged_native_tune_calibration_and_full_three_use_qualification",
      "title": "Final Choice",
      "type": "string"
    },
    "final_test_used_for_screening": {
      "const": false,
      "default": false,
      "title": "Final Test Used For Screening",
      "type": "boolean"
    },
    "finalist_rule": {
      "const": "same_one_recipe_per_family_at_50_and_100_no_new_hyperparameters",
      "default": "same_one_recipe_per_family_at_50_and_100_no_new_hyperparameters",
      "title": "Finalist Rule",
      "type": "string"
    },
    "independent_evaluation_used_for_screening": {
      "const": false,
      "default": false,
      "title": "Independent Evaluation Used For Screening",
      "type": "boolean"
    },
    "maximum_fit_attempts": {
      "const": 12,
      "default": 12,
      "title": "Maximum Fit Attempts",
      "type": "integer"
    },
    "order": {
      "default": [
        25,
        50,
        100
      ],
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": 25,
          "type": "integer"
        },
        {
          "const": 50,
          "type": "integer"
        },
        {
          "const": 100,
          "type": "integer"
        }
      ],
      "title": "Order",
      "type": "array"
    },
    "paired_population": {
      "const": "all_common_native_keys_per_scale_no_history_or_row_subsampling",
      "default": "all_common_native_keys_per_scale_no_history_or_row_subsampling",
      "title": "Paired Population",
      "type": "string"
    },
    "partition_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Partition Policy Sha256",
      "type": "string"
    },
    "preparation_25_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preparation 25 Sha256",
      "type": "string"
    },
    "preparation_50_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preparation 50 Sha256",
      "type": "string"
    },
    "preparation_cost": {
      "const": "prepare_once_per_variant_and_scale_report_cold_and_ready_costs",
      "default": "prepare_once_per_variant_and_scale_report_cold_and_ready_costs",
      "title": "Preparation Cost",
      "type": "string"
    },
    "recipes": {
      "items": {
        "$ref": "#/$defs/ForecastSearchRecipe"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Recipes",
      "type": "array"
    },
    "recipes_per_family_by_products": {
      "default": [
        2,
        1,
        1
      ],
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": 2,
          "type": "integer"
        },
        {
          "const": 1,
          "type": "integer"
        },
        {
          "const": 1,
          "type": "integer"
        }
      ],
      "title": "Recipes Per Family By Products",
      "type": "array"
    },
    "resources_by_products": {
      "additionalProperties": {
        "$ref": "#/$defs/CampaignGenerationResources"
      },
      "propertyNames": {
        "enum": [
          "25",
          "50",
          "100"
        ]
      },
      "title": "Resources By Products",
      "type": "object"
    },
    "screening": {
      "const": "per_family_tune_mean_mse_existing_bias_coverage_gates_then_frozen_recipe_order",
      "default": "per_family_tune_mean_mse_existing_bias_coverage_gates_then_frozen_recipe_order",
      "title": "Screening",
      "type": "string"
    },
    "screening_policy": {
      "$ref": "#/$defs/CampaignForecastTunePolicy",
      "default": {
        "baseline_interval_objective": "central_interval_score",
        "candidate_interval_center": "selected_median_then_fit_on_calibration_role",
        "maximum_absolute_normalized_mean_bias": 0.1,
        "mean_objective": "mse_with_bias_guard",
        "median_objective": "mae",
        "minimum_eligibility_coverage": 0.8,
        "minimum_relative_median_improvement": 0.05,
        "minimum_rows": 100,
        "model_order": [
          "history7",
          "history28",
          "weekday28",
          "rf_mean",
          "hgb",
          "tensorflow"
        ],
        "nominal_coverage": 0.9,
        "tie_breaker": "baseline_first_then_model_order_then_frozen_trial_order",
        "version": "ai09-forecast-tune-policy-1.0.0",
        "zero_denominator": "undefined_ratios_no_floor_or_ratio_gate"
      }
    },
    "stage_ready": {
      "const": false,
      "default": false,
      "title": "Stage Ready",
      "type": "boolean"
    },
    "training_initialization_seed": {
      "const": 42,
      "default": 42,
      "title": "Training Initialization Seed",
      "type": "integer"
    },
    "version": {
      "const": "ai09-fair-multiscale-forecast-search-1.0.0",
      "default": "ai09-fair-multiscale-forecast-search-1.0.0",
      "title": "Version",
      "type": "string"
    },
    "worker_environment_lock_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "rf",
          "hgb",
          "tensorflow"
        ]
      },
      "title": "Worker Environment Lock Sha256",
      "type": "object"
    }
  },
  "required": [
    "preparation_25_sha256",
    "preparation_50_sha256",
    "canonical_portfolio_protocol_sha256",
    "partition_policy_sha256",
    "critical_group_policy_sha256",
    "recipes",
    "worker_environment_lock_sha256",
    "resources_by_products"
  ],
  "title": "ForecastDevelopmentSearch",
  "type": "object"
}
