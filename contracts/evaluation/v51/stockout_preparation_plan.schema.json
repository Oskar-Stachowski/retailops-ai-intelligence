          "title": "Version",
          "type": "string"
        }
      },
      "title": "CampaignStockoutLabelStoragePolicy",
      "type": "object"
    },
    "CampaignStockoutMaturityPolicy": {
      "additionalProperties": false,
      "properties": {
        "final_test": {
          "const": "separate_frozen_campaign_not_included_or_authorized",
          "default": "separate_frozen_campaign_not_included_or_authorized",
          "title": "Final Test",
          "type": "string"
        },
        "full_population": {
          "const": "all_physical_origins_including_ineligible_and_purged",
          "default": "all_physical_origins_including_ineligible_and_purged",
          "title": "Full Population",
          "type": "string"
        },
        "horizon_days": {
          "const": 7,
          "default": 7,
          "title": "Horizon Days",
          "type": "integer"
        },
        "maturity": {
          "const": "available_by_role_cutoff_and_strictly_before_next_role",
          "default": "available_by_role_cutoff_and_strictly_before_next_role",
          "title": "Maturity",
          "type": "string"
        },
        "purge_days": {
          "default": 15,
          "maximum": 90,
          "minimum": 15,
          "title": "Purge Days",
          "type": "integer"
        },
        "stockout_purposes": {
          "default": [
            "base_train",
            "calibrator_fit",
            "recipe_selection",
            "threshold_assessment",
            "development_evaluation"
          ],
          "items": {
            "enum": [
              "base_train",
              "calibrator_fit",
              "recipe_selection",
              "threshold_assessment",
              "development_evaluation"
            ],
            "type": "string"
          },
          "title": "Stockout Purposes",
          "type": "array"
        },
        "version": {
          "const": "ai09-stockout-full-mature-development-roles-1.0.0",
          "default": "ai09-stockout-full-mature-development-roles-1.0.0",
          "title": "Version",
          "type": "string"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/RoleWindow"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Windows",
          "type": "array"
        }
      },
      "required": [
        "windows"
      ],
      "title": "CampaignStockoutMaturityPolicy",
      "type": "object"
    },
    "CampaignStockoutQualificationPolicy": {
      "additionalProperties": false,
      "properties": {
        "chunk_bytes": {
          "default": 8192,
          "maximum": 65536,
          "minimum": 1,
          "title": "Chunk Bytes",
          "type": "integer"
        },
        "max_bytes": {
          "default": 2147483648,
          "maximum": 4294967296,
          "minimum": 4096,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_record_bytes": {
          "default": 16384,
          "maximum": 65536,
          "minimum": 1024,
          "title": "Max Record Bytes",
          "type": "integer"
        },
        "max_windows": {
          "default": 1000000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Windows",
          "type": "integer"
        },
        "version": {
          "const": "ai09-stockout-full-qualification-read-1.0.0",
          "default": "ai09-stockout-full-qualification-read-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "CampaignStockoutQualificationPolicy",
      "type": "object"
    },
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "RoleWindow": {
      "additionalProperties": false,
      "properties": {
        "label_knowledge_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Label Knowledge Cutoff",
          "type": "string"
        },
        "origins": {
          "$ref": "#/$defs/DateWindow"
        },
        "role": {
          "enum": [
            "train",
            "early_stopping",
            "tune",
            "calibration",
            "development_evaluation"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "origins",
        "label_knowledge_cutoff"
      ],
      "title": "RoleWindow",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:stockout_preparation_plan:51.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "final_test_access_authorized": {
      "const": false,
      "default": false,
      "title": "Final Test Access Authorized",
      "type": "boolean"
    },
    "generation_operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Generation Operation Id",
      "type": "string"
    },
    "label_storage": {
      "$ref": "#/$defs/CampaignStockoutLabelStoragePolicy",
      "default": {
        "audited_source_read_proved_by_this_policy": false,
        "batch_rows": 256,
        "cache_kib": 8192,
        "final_access_authorized": false,
        "max_index_bytes": 2147483648,
        "max_parent_bytes": 2147483648,
