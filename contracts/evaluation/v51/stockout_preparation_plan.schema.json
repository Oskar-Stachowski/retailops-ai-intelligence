      "minimum": 4096,
      "title": "Max Index Bytes",
      "type": "integer"
    },
    "max_public_bytes": {
      "default": 2147483648,
      "maximum": 8589934592,
      "minimum": 4096,
      "title": "Max Public Bytes",
      "type": "integer"
    },
    "max_role_bytes": {
      "default": 2147483648,
      "maximum": 8589934592,
      "minimum": 4096,
      "title": "Max Role Bytes",
      "type": "integer"
    },
    "max_rows": {
      "default": 1000000,
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Rows",
      "type": "integer"
    },
    "max_stream_bytes": {
      "default": 2147483648,
      "maximum": 8589934592,
      "minimum": 4096,
      "title": "Max Stream Bytes",
      "type": "integer"
    },
    "parent_budget": {
      "$ref": "#/$defs/CampaignParentBudget",
