{
  "$defs": {
    "CampaignContextStoragePolicy": {
      "additionalProperties": false,
      "description": "Prospective AI09 limits; the closed AI08 storage wire is unchanged.",
      "properties": {
        "audited_source_read_proved_by_this_policy": {
          "const": false,
          "default": false,
          "title": "Audited Source Read Proved By This Policy",
          "type": "boolean"
        },
        "batch_rows": {
          "default": 256,
          "maximum": 512,
          "minimum": 1,
          "title": "Batch Rows",
          "type": "integer"
        },
        "cache_kib": {
          "const": 8192,
          "default": 8192,
          "title": "Cache Kib",
          "type": "integer"
        },
        "final_access_authorized": {
          "const": false,
          "default": false,
          "title": "Final Access Authorized",
          "type": "boolean"
        },
        "max_index_bytes": {
          "default": 2147483648,
          "maximum": 17179869184,
          "minimum": 4096,
          "title": "Max Index Bytes",
          "type": "integer"
        },
        "max_parent_bytes": {
          "default": 2147483648,
          "maximum": 68719476736,
          "minimum": 1,
          "title": "Max Parent Bytes",
          "type": "integer"
        },
        "max_parent_files": {
          "default": 10000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Parent Files",
          "type": "integer"
        },
        "max_parent_rows": {
          "default": 20000000,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Parent Rows",
          "type": "integer"
        },
        "max_selected_bytes": {
          "default": 67108864,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Max Selected Bytes",
          "type": "integer"
        },
        "max_selected_rows": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Selected Rows",
          "type": "integer"
        },
        "maximum_cached_physical_series": {
          "const": 1,
          "default": 1,
          "title": "Maximum Cached Physical Series",
          "type": "integer"
        },
        "projection": {
          "const": "closed_ai08_origin_pit_feature_point_unchanged",
          "default": "closed_ai08_origin_pit_feature_point_unchanged",
          "title": "Projection",
          "type": "string"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "retention": {
          "const": "private_disposable_all_versions_original_order",
          "default": "private_disposable_all_versions_original_order",
          "title": "Retention",
          "type": "string"
        },
        "series_index": {
          "const": "closed_ai08_fact_index_one_physical_series_clip_again_per_origin",
          "default": "closed_ai08_fact_index_one_physical_series_clip_again_per_origin",
          "title": "Series Index",
          "type": "string"
        },
        "stage_ready": {
          "const": false,
          "default": false,
          "title": "Stage Ready",
          "type": "boolean"
        },
        "supported_curated_versions": {
          "default": [
            "1.1.0",
            "1.2.0"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "1.1.0",
              "type": "string"
            },
            {
              "const": "1.2.0",
              "type": "string"
            }
          ],
          "title": "Supported Curated Versions",
          "type": "array"
        },
        "version": {
          "const": "ai09-source-context-disk-facts-1.0.0",
          "default": "ai09-source-context-disk-facts-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "CampaignContextStoragePolicy",
      "type": "object"
    },
    "CampaignGenerationResources": {
      "additionalProperties": false,
      "properties": {
        "cpu_threads": {
          "const": 1,
          "default": 1,
          "title": "Cpu Threads",
          "type": "integer"
        },
        "max_log_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "minimum_available_memory_bytes": {
          "minimum": 1024,
          "title": "Minimum Available Memory Bytes",
          "type": "integer"
        },
        "minimum_free_disk_bytes": {
          "minimum": 1024,
          "title": "Minimum Free Disk Bytes",
          "type": "integer"
        },
        "sample_seconds": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0.01,
          "title": "Sample Seconds",
          "type": "number"
        },
        "scratch_bytes": {
          "maximum": 137438953472,
          "minimum": 1024,
          "title": "Scratch Bytes",
          "type": "integer"
        },
        "tree_rss_bytes": {
          "maximum": 68719476736,
          "minimum": 1024,
          "title": "Tree Rss Bytes",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "tree_rss_bytes",
        "scratch_bytes",
        "minimum_free_disk_bytes",
        "minimum_available_memory_bytes"
      ],
      "title": "CampaignGenerationResources",
      "type": "object"
    },
    "CampaignParentBudget": {
      "additionalProperties": false,
      "properties": {
        "batch_rows": {
          "default": 256,
          "maximum": 8192,
          "minimum": 1,
          "title": "Batch Rows",
          "type": "integer"
        },
        "max_parent_bytes": {
          "default": 2147483648,
          "maximum": 2147483648,
          "minimum": 1024,
          "title": "Max Parent Bytes",
          "type": "integer"
        },
        "max_parent_files": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 2,
          "title": "Max Parent Files",
          "type": "integer"
        },
        "max_rows_per_parent": {
          "default": 20000000,
          "maximum": 20000000,
          "minimum": 1,
          "title": "Max Rows Per Parent",
          "type": "integer"
        }
      },
      "title": "CampaignParentBudget",
      "type": "object"
    },
    "CampaignStockoutLabelStoragePolicy": {
      "additionalProperties": false,
      "description": "Same bounded storage resources, explicitly for outcomes rather than PIT features.",
      "properties": {
