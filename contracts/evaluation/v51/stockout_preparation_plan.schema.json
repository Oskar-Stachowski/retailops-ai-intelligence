        "max_parent_files": 10000,
        "max_parent_rows": 20000000,
        "max_selected_bytes": 67108864,
        "max_selected_rows": 100000,
        "maximum_cached_physical_series": 1,
        "projection": "closed_ai08_origin_pit_feature_point_unchanged",
        "promotion_allowed": false,
        "retention": "private_disposable_all_versions_original_order",
        "series_index": "closed_ai08_fact_index_one_physical_series_clip_again_per_origin",
        "stage_ready": false,
        "supported_curated_versions": [
          "1.1.0",
          "1.2.0"
        ],
        "version": "ai09-source-context-disk-facts-1.0.0"
      }
    },
    "qualification": {
      "$ref": "#/$defs/CampaignStockoutQualificationPolicy",
      "default": {
        "chunk_bytes": 8192,
        "max_bytes": 2147483648,
        "max_record_bytes": 16384,
        "max_windows": 1000000,
        "version": "ai09-stockout-full-qualification-read-1.0.0"
      }
    },
    "resources": {
      "$ref": "#/$defs/CampaignGenerationResources"
