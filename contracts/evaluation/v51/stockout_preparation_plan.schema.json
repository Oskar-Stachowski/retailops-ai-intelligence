      "title": "Scope",
      "type": "string"
    },
    "source_recipe_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Recipe Sha256",
      "type": "string"
    },
    "version": {
      "const": "ai09-stockout-preparation-plan-1.0.0",
