        },
        "max_index_bytes": {
          "default": 2147483648,
          "maximum": 17179869184,
          "minimum": 4096,
          "title": "Max Index Bytes",
          "type": "integer"
        },
        "max_parent_bytes": {
          "default": 2147483648,
          "maximum": 68719476736,
          "minimum": 1,
          "title": "Max Parent Bytes",
          "type": "integer"
        },
        "max_parent_files": {
          "default": 10000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Parent Files",
          "type": "integer"
        },
        "max_parent_rows": {
          "default": 20000000,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Parent Rows",
          "type": "integer"
        },
        "max_selected_bytes": {
          "default": 67108864,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Max Selected Bytes",
          "type": "integer"
        },
        "max_selected_rows": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Selected Rows",
          "type": "integer"
        },
        "maximum_cached_physical_series": {
          "const": 1,
          "default": 1,
          "title": "Maximum Cached Physical Series",
          "type": "integer"
        },
        "projection": {
          "const": "closed_ai08_label_preparation_point_unchanged",
          "default": "closed_ai08_label_preparation_point_unchanged",
          "title": "Projection",
          "type": "string"
        },
        "promotion_allowed": {
          "const": false,
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "retention": {
          "const": "private_disposable_all_versions_original_order",
          "default": "private_disposable_all_versions_original_order",
          "title": "Retention",
          "type": "string"
        },
        "series_index": {
          "const": "one_complete_physical_ledger_no_origin_knowledge_clipping",
          "default": "one_complete_physical_ledger_no_origin_knowledge_clipping",
          "title": "Series Index",
          "type": "string"
        },
        "stage_ready": {
          "const": false,
          "default": false,
          "title": "Stage Ready",
          "type": "boolean"
        },
        "supported_curated_versions": {
          "default": [
            "1.1.0",
            "1.2.0"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "1.1.0",
              "type": "string"
            },
            {
              "const": "1.2.0",
              "type": "string"
            }
          ],
          "title": "Supported Curated Versions",
          "type": "array"
        },
        "version": {
          "const": "ai09-full-stockout-label-facts-1.0.0",
