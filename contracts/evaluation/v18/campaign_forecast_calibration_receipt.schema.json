  "required": [
    "protocol_sha256",
    "operation_id",
    "reservation_id",
    "plan",
    "export_receipt_sha256",
    "tune_receipt_sha256",
    "score_receipt_sha256",
    "dataset_id",
    "runtime_code_sha256",
    "role_population_sha256",
    "keys_sha256",
    "eligible_keys_sha256",
    "rows",
    "eligible_rows",
    "calibration",
    "artifact_sha256",
    "artifact_bytes",
    "artifact_files",
    "worker_evidence"
  ],
  "title": "CampaignForecastCalibrationReceipt",
  "type": "object"
}
