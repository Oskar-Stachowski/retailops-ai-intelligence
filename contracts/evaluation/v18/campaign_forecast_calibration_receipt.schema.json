    "artifact_bytes": {
      "minimum": 1,
      "title": "Artifact Bytes",
      "type": "integer"
    },
    "artifact_files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Artifact Files",
      "type": "object"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "calibration": {
      "$ref": "#/$defs/CampaignForecastCalibration"
    },
    "dataset_id": {
      "pattern": "^ai09-physical-forecast-sha256-[0-9a-f]{64}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "eligible_keys_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Eligible Keys Sha256",
      "type": "string"
    },
    "eligible_rows": {
      "minimum": 0,
      "title": "Eligible Rows",
      "type": "integer"
    },
    "export_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Export Receipt Sha256",
      "type": "string"
    },
    "final_test_accessed": {
      "const": false,
      "default": false,
      "title": "Final Test Accessed",
      "type": "boolean"
    },
    "independent_evaluation_accessed": {
      "const": false,
      "default": false,
      "title": "Independent Evaluation Accessed",
      "type": "boolean"
    },
    "keys_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Keys Sha256",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Operation Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/CampaignForecastCalibrationPlan"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "quality_qualified": {
      "const": false,
      "default": false,
      "title": "Quality Qualified",
      "type": "boolean"
    },
    "reservation_id": {
      "pattern": "^campaign-operation-[0-9a-f]{32}$",
      "title": "Reservation Id",
      "type": "string"
    },
    "role_population_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Role Population Sha256",
      "type": "string"
    },
    "rows": {
      "minimum": 1,
      "title": "Rows",
      "type": "integer"
    },
    "runtime_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Code Sha256",
      "type": "string"
    },
    "score_receipt_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Score Receipt Sha256",
      "type": "object"
    },
    "stage_ready": {
      "const": false,
      "default": false,
      "title": "Stage Ready",
      "type": "boolean"
    },
    "training_or_preprocessing_refitted": {
      "const": false,
      "default": false,
      "title": "Training Or Preprocessing Refitted",
      "type": "boolean"
    },
    "tune_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tune Receipt Sha256",
      "type": "string"
    },
    "version": {
      "const": "ai09-campaign-forecast-calibration-receipt-1.0.0",
      "default": "ai09-campaign-forecast-calibration-receipt-1.0.0",
      "title": "Version",
      "type": "string"
    },
    "worker_evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Worker Evidence",
      "type": "object"
    }
