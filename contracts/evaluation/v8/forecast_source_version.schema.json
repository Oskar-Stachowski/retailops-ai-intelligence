{
  "$defs": {
    "DemandVersion": {
      "additionalProperties": false,
      "description": "An explicitly declared curated version; a seal does not prove source truth.",
      "properties": {
        "business_date": {
          "format": "date",
          "title": "Business Date",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "curated_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Curated Available At"
        },
        "observation_status": {
          "enum": [
            "observed_positive",
            "observed_zero",
            "closed",
            "missing"
          ],
          "title": "Observation Status",
          "type": "string"
        },
        "observed_units": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Units"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "quality_status": {
          "enum": [
            "valid",
            "quarantined",
            "incomplete"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "record_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "source_data_complete": {
          "title": "Source Data Complete",
          "type": "boolean"
        },
        "source_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Record Sha256",
          "type": "string"
        },
        "version": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "product_id",
        "selling_location_id",
        "channel",
        "business_date",
        "record_id",
        "source_record_sha256",
        "version",
        "curated_available_at",
        "observed_units",
        "observation_status",
        "source_data_complete",
        "quality_status"
      ],
      "title": "DemandVersion",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:forecast_source_version:8.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A quantity version with separate quality knowledge; no implicit completeness.\n\nThis wire object is diagnostic metadata, not authority to open a source or\nevidence that arbitrary caller declarations have been physically replayed.\nOnly the context-bound source reader establishes its actual parent binding.",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/DemandVersion"
    },
    "history_policy_version": {
      "const": "observed-quantity-history-1.0.0",
      "default": "observed-quantity-history-1.0.0",
      "title": "History Policy Version",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "observation_source_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Observation Source Record Sha256",
      "type": "string"
    },
    "quality_available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality Available At"
    },
    "quality_basis": {
      "enum": [
        "exact_latest_observation",
        "historical_quality_not_established"
      ],
      "title": "Quality Basis",
      "type": "string"
    },
    "quality_status": {
      "anyOf": [
        {
          "enum": [
            "valid",
            "quarantined",
            "incomplete"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality Status"
    },
    "source_data_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Data Complete"
    }
  },
  "required": [
    "candidate",
    "observation_id",
    "observation_source_record_sha256",
    "quality_basis",
    "quality_available_at",
    "source_data_complete",
    "quality_status"
  ],
  "title": "ForecastSourceVersion",
  "type": "object"
}
