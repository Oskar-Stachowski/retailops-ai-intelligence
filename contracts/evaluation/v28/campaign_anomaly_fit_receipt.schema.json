{
  "$defs": {
    "CampaignAnomalyFitPlan": {
      "additionalProperties": false,
      "properties": {
        "capture_policy": {
          "const": "complete_native_public_parent_at_actual_fact_ingestion_time",
          "default": "complete_native_public_parent_at_actual_fact_ingestion_time",
          "title": "Capture Policy",
          "type": "string"
        },
        "event_capacities": {
          "items": {
            "$ref": "#/$defs/EventCapacity"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Event Capacities",
          "type": "array"
        },
        "export_operation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Export Operation Id",
          "type": "string"
        },
        "final_test_accessed": {
          "const": false,
          "default": false,
          "title": "Final Test Accessed",
          "type": "boolean"
        },
        "max_artifact_bytes": {
          "default": 33554432,
          "maximum": 67108864,
          "minimum": 1024,
          "title": "Max Artifact Bytes",
          "type": "integer"
        },
        "max_capture_bytes": {
          "default": 2147483648,
          "maximum": 8589934592,
          "minimum": 4096,
          "title": "Max Capture Bytes",
          "type": "integer"
        },
        "max_days": {
          "default": 20000000,
          "maximum": 20000000,
          "minimum": 1,
          "title": "Max Days",
          "type": "integer"
        },
        "max_index_bytes": {
          "default": 2147483648,
          "maximum": 8589934592,
          "minimum": 4096,
          "title": "Max Index Bytes",
          "type": "integer"
        },
        "max_role_bytes": {
          "default": 2147483648,
          "maximum": 8589934592,
          "minimum": 4096,
          "title": "Max Role Bytes",
          "type": "integer"
        },
        "max_series": {
          "default": 65536,
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Series",
          "type": "integer"
        },
        "max_series_bytes": {
          "default": 67108864,
          "maximum": 268435456,
          "minimum": 4096,
          "title": "Max Series Bytes",
          "type": "integer"
        },
        "max_series_rows": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Series Rows",
          "type": "integer"
        },
        "phase": {
          "const": "development",
          "default": "development",
          "title": "Phase",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/CensusFitPolicy",
          "default": {
            "contamination": "auto",
            "features": [
              "observed_units",
              "expected_units",
              "residual_units",
              "robust_scale_units",
              "standardized_residual",
              "planned_price",
              "promotion_offered",
              "on_hand",
              "short_count_residual",
              "long_count_residual",
              "inventory_shortfall"
            ],
            "fit_cpu_seconds": 300,
            "fit_rss_bytes": 1073741824,
            "fit_wall_seconds": 300,
            "max_features": 1.0,
            "max_matrix_bytes": 268435456,
            "max_samples": 64,
            "max_train_rows": 1000000,
            "minimum_available_memory_bytes": 1073741824,
            "minimum_free_disk_bytes": 6442450944,
            "minimum_train_rows": 16,
            "minimum_validation_rows": 16,
            "model_seed": 137,
            "n_estimators": 32,
            "population": "every_declared_eligible_training_row",
            "score_arithmetic": "decimal50_half_even_12_places",
            "selection": "unlabelled_validation_alert_capacity",
            "validation_alert_fraction": 0.05,
            "validation_high_fraction": 0.01,
            "version": "anomaly-detector-census-fit-1.0.0"
          }
        },
        "population": {
          "const": "all_native_declared_series_days_no_sampling",
          "default": "all_native_declared_series_days_no_sampling",
          "title": "Population",
          "type": "string"
        },
        "quality_qualified": {
          "const": false,
          "default": false,
          "title": "Quality Qualified",
          "type": "boolean"
        },
        "resources": {
          "$ref": "#/$defs/CampaignGenerationResources"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "source_recipe_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Recipe Sha256",
          "type": "string"
        },
        "stage_ready": {
          "const": false,
          "default": false,
          "title": "Stage Ready",
          "type": "boolean"
        },
        "test": {
          "$ref": "#/$defs/Window"
        },
        "train": {
          "$ref": "#/$defs/Window"
        },
        "training_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Training Cutoff",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/Window"
        },
        "version": {
          "const": "ai09-campaign-anomaly-fit-1.0.0",
          "default": "ai09-campaign-anomaly-fit-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_recipe_sha256",
        "export_operation_id",
        "train",
        "validation",
        "test",
        "training_cutoff",
        "selection_cutoff",
        "event_capacities",
        "resources"
      ],
      "title": "CampaignAnomalyFitPlan",
      "type": "object"
    },
    "CampaignGenerationResources": {
      "additionalProperties": false,
      "properties": {
        "cpu_threads": {
          "const": 1,
          "default": 1,
          "title": "Cpu Threads",
          "type": "integer"
        },
        "max_log_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "minimum_available_memory_bytes": {
          "minimum": 1024,
          "title": "Minimum Available Memory Bytes",
          "type": "integer"
        },
        "minimum_free_disk_bytes": {
          "minimum": 1024,
          "title": "Minimum Free Disk Bytes",
          "type": "integer"
        },
        "sample_seconds": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0.01,
          "title": "Sample Seconds",
          "type": "number"
        },
        "scratch_bytes": {
          "maximum": 137438953472,
          "minimum": 1024,
          "title": "Scratch Bytes",
          "type": "integer"
        },
        "tree_rss_bytes": {
          "maximum": 68719476736,
          "minimum": 1024,
          "title": "Tree Rss Bytes",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "tree_rss_bytes",
        "scratch_bytes",
        "minimum_free_disk_bytes",
        "minimum_available_memory_bytes"
      ],
      "title": "CampaignGenerationResources",
      "type": "object"
    },
    "CensusFitPolicy": {
      "additionalProperties": false,
      "properties": {
        "contamination": {
          "anyOf": [
            {
              "const": "auto",
              "type": "string"
            },
            {
              "exclusiveMinimum": 0,
              "maximum": 0.5,
              "type": "number"
            }
          ],
          "default": "auto",
          "title": "Contamination"
        },
        "features": {
          "default": [
            "observed_units",
            "expected_units",
            "residual_units",
            "robust_scale_units",
            "standardized_residual",
            "planned_price",
            "promotion_offered",
            "on_hand"
          ],
          "items": {
            "enum": [
              "observed_units",
              "expected_units",
              "residual_units",
              "robust_scale_units",
              "standardized_residual",
              "planned_price",
              "promotion_offered",
              "on_hand",
              "short_count_residual",
              "long_count_residual",
              "inventory_shortfall"
            ],
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        },
        "fit_cpu_seconds": {
          "const": 300,
          "default": 300,
          "title": "Fit Cpu Seconds",
          "type": "integer"
        },
        "fit_rss_bytes": {
          "const": 1073741824,
          "default": 1073741824,
          "title": "Fit Rss Bytes",
          "type": "integer"
        },
        "fit_wall_seconds": {
          "const": 300,
          "default": 300,
          "title": "Fit Wall Seconds",
          "type": "integer"
        },
        "max_features": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Features",
          "type": "number"
        },
        "max_matrix_bytes": {
          "const": 268435456,
          "default": 268435456,
          "title": "Max Matrix Bytes",
          "type": "integer"
        },
        "max_samples": {
          "default": 64,
          "maximum": 256,
          "minimum": 16,
          "title": "Max Samples",
          "type": "integer"
        },
        "max_train_rows": {
          "const": 1000000,
          "default": 1000000,
          "title": "Max Train Rows",
          "type": "integer"
        },
        "minimum_available_memory_bytes": {
          "const": 1073741824,
          "default": 1073741824,
          "title": "Minimum Available Memory Bytes",
          "type": "integer"
        },
        "minimum_free_disk_bytes": {
          "const": 6442450944,
          "default": 6442450944,
          "title": "Minimum Free Disk Bytes",
          "type": "integer"
        },
        "minimum_train_rows": {
          "default": 16,
          "maximum": 10000,
          "minimum": 16,
          "title": "Minimum Train Rows",
          "type": "integer"
        },
        "minimum_validation_rows": {
          "default": 16,
          "maximum": 10000,
          "minimum": 16,
          "title": "Minimum Validation Rows",
          "type": "integer"
        },
        "model_seed": {
          "default": 137,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "n_estimators": {
          "default": 32,
          "maximum": 128,
          "minimum": 8,
          "title": "N Estimators",
          "type": "integer"
        },
        "population": {
          "const": "every_declared_eligible_training_row",
          "default": "every_declared_eligible_training_row",
          "title": "Population",
          "type": "string"
        },
        "score_arithmetic": {
          "const": "decimal50_half_even_12_places",
          "default": "decimal50_half_even_12_places",
          "title": "Score Arithmetic",
          "type": "string"
        },
        "selection": {
          "const": "unlabelled_validation_alert_capacity",
          "default": "unlabelled_validation_alert_capacity",
          "title": "Selection",
          "type": "string"
        },
        "validation_alert_fraction": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Validation Alert Fraction",
          "type": "number"
        },
        "validation_high_fraction": {
          "default": 0.01,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Validation High Fraction",
          "type": "number"
        },
        "version": {
          "const": "anomaly-detector-census-fit-1.0.0",
          "default": "anomaly-detector-census-fit-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "CensusFitPolicy",
      "type": "object"
    },
    "EventCapacity": {
      "additionalProperties": false,
      "properties": {
        "alert_fraction": {
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Alert Fraction",
          "type": "number"
        },
        "event_type": {
          "enum": [
            "sale_completed",
            "return_completed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "high_fraction": {
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "High Fraction",
          "type": "number"
        }
      },
      "required": [
        "event_type",
        "alert_fraction",
        "high_fraction"
      ],
      "title": "EventCapacity",
      "type": "object"
    },
    "JsonValue": {},
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:campaign_anomaly_fit_receipt:28.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Artifact Files",
      "type": "object"
    },
    "export_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Export Receipt Sha256",
      "type": "string"
    },
    "feature_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Manifest Sha256",
      "type": "string"
    },
    "final_test_accessed": {
      "const": false,
      "default": false,
      "title": "Final Test Accessed",
      "type": "boolean"
    },
    "model_artifact_bytes": {
      "minimum": 1,
      "title": "Model Artifact Bytes",
      "type": "integer"
    },
    "model_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Artifact Sha256",
      "type": "string"
    },
    "model_id": {
      "pattern": "^anomaly-detector-sha256-[0-9a-f]{64}$",
      "title": "Model Id",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Operation Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/CampaignAnomalyFitPlan"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "quality_qualified": {
      "const": false,
      "default": false,
      "title": "Quality Qualified",
      "type": "boolean"
    },
    "reservation_id": {
      "pattern": "^campaign-operation-[0-9a-f]{32}$",
      "title": "Reservation Id",
      "type": "string"
    },
    "runtime_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Code Sha256",
      "type": "string"
    },
    "stage_ready": {
      "const": false,
      "default": false,
      "title": "Stage Ready",
      "type": "boolean"
    },
    "version": {
      "const": "ai09-campaign-anomaly-fit-receipt-1.0.0",
      "default": "ai09-campaign-anomaly-fit-receipt-1.0.0",
      "title": "Version",
      "type": "string"
    },
    "worker_evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Worker Evidence",
      "type": "object"
    }
  },
  "required": [
    "protocol_sha256",
    "operation_id",
    "reservation_id",
    "plan",
    "export_receipt_sha256",
    "runtime_code_sha256",
    "model_id",
    "feature_manifest_sha256",
    "model_artifact_sha256",
    "model_artifact_bytes",
    "artifact_files",
    "worker_evidence"
  ],
  "title": "CampaignAnomalyFitReceipt",
  "type": "object"
}
