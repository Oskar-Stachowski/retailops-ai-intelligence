        "history_in_stock_days": {
          "minimum": 0,
          "title": "History In Stock Days",
          "type": "integer"
        },
        "history_inventory_unknown_days": {
          "minimum": 0,
          "title": "History Inventory Unknown Days",
          "type": "integer"
        },
        "history_known_days": {
          "minimum": 0,
          "title": "History Known Days",
          "type": "integer"
        },
        "history_missing_days": {
          "minimum": 0,
          "title": "History Missing Days",
          "type": "integer"
        },
        "in_stock_sales_mean": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "In Stock Sales Mean"
        },
        "next_expected_delivery_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Expected Delivery Hours"
        },
        "observed_sales_mean": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Sales Mean"
        },
        "observed_sales_std": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Sales Std"
        },
        "open_order_quantity": {
          "minimum": 0,
          "title": "Open Order Quantity",
          "type": "integer"
        },
        "overdue_order_quantity": {
          "minimum": 0,
          "title": "Overdue Order Quantity",
          "type": "integer"
        },
        "quoted_lead_time_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quoted Lead Time Days"
        },
        "snapshot_age_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Age Hours"
