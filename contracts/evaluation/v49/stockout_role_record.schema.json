      },
      "required": [
        "available_qty",
        "snapshot_age_hours",
        "history_known_days",
        "history_missing_days",
        "observed_sales_mean",
        "observed_sales_std",
        "in_stock_sales_mean",
        "history_in_stock_days",
        "history_constrained_days",
        "history_inventory_unknown_days",
        "historical_stockout_onsets",
        "days_of_supply_observed",
        "days_of_supply_in_stock",
        "open_order_quantity",
        "due_within_7d_quantity",
        "overdue_order_quantity",
        "next_expected_delivery_hours",
        "quoted_lead_time_days",
        "forecast_units_7d",
        "forecast_days_of_supply",
        "forecast_unavailable"
      ],
      "title": "CampaignStockoutPublicValues",
      "type": "object"
    },
    "CampaignStockoutRoleMembership": {
      "additionalProperties": false,
      "properties": {
        "development_window": {
          "anyOf": [
            {
              "enum": [
                "train",
                "early_stopping",
                "tune",
                "calibration",
                "development_evaluation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Development Window"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "label_knowledge_cutoff": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Knowledge Cutoff"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "base_train",
                "calibrator_fit",
                "recipe_selection",
                "threshold_assessment",
                "development_evaluation"
              ],
              "type": "string"
            },
            {
              "const": "purged",
              "type": "string"
            }
          ],
          "title": "Role"
        }
      },
      "required": [
        "role",
        "development_window",
        "eligible",
        "reason",
        "label_knowledge_cutoff"
      ],
      "title": "CampaignStockoutRoleMembership",
      "type": "object"
    },
    "LabelPoint": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "first_incident_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
