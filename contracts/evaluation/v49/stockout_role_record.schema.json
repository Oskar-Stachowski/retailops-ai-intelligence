        "label_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Available At"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "status": {
          "enum": [
            "evaluable",
            "already_stockout",
            "not_evaluable"
          ],
          "title": "Status",
          "type": "string"
        },
        "stock_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Stock Location Id",
          "type": "string"
        },
        "window_end_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Window End At",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "stock_location_id",
        "as_of",
        "window_end_at",
        "evaluated_at",
        "status",
        "reason",
        "incident_stockout",
        "label_available_at",
        "first_incident_at",
        "first_incident_event_id"
      ],
      "title": "LabelPoint",
      "type": "object"
    }
