{
  "$defs": {
    "CampaignStockoutPublicRow": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "As Of",
          "type": "string"
        },
        "category_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "const": "__unknown__",
              "type": "string"
            }
          ],
          "title": "Category Id"
        },
        "category_source_record_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category Source Record Sha256"
        },
        "feature_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Sha256",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "status": {
          "enum": [
            "eligible",
            "already_stockout",
            "insufficient_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "stock_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Stock Location Id",
          "type": "string"
        },
        "upstream_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Upstream Sha256",
          "type": "string"
        },
        "values": {
          "$ref": "#/$defs/CampaignStockoutPublicValues"
        }
      },
      "required": [
        "product_id",
        "stock_location_id",
        "as_of",
        "status",
        "reason",
        "category_id",
        "category_source_record_sha256",
        "values",
        "feature_sha256",
        "upstream_sha256"
      ],
      "title": "CampaignStockoutPublicRow",
      "type": "object"
    },
    "CampaignStockoutPublicValues": {
      "additionalProperties": false,
      "properties": {
        "available_qty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Qty"
        },
        "days_of_supply_in_stock": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
