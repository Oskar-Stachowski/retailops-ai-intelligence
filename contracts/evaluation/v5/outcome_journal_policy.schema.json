{
  "$defs": {
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "FoldPlan": {
      "additionalProperties": false,
      "properties": {
        "development_holdout": {
          "$ref": "#/$defs/DateWindow"
        },
        "evaluation_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluation Cutoff",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "purge_days": {
          "default": 15,
          "maximum": 90,
          "minimum": 14,
          "title": "Purge Days",
          "type": "integer"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "train": {
          "$ref": "#/$defs/DateWindow"
        },
        "training_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Training Cutoff",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/DateWindow"
        }
      },
      "required": [
        "name",
        "train",
        "validation",
        "development_holdout",
        "training_cutoff",
        "selection_cutoff",
        "evaluation_cutoff"
      ],
      "title": "FoldPlan",
      "type": "object"
    },
    "HistoricalOutcomeAttempt": {
      "additionalProperties": false,
      "properties": {
        "output": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Output",
          "type": "string"
        },
        "protocol_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol File Sha256",
          "type": "string"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed_development_diagnostic",
            "failed",
            "interrupted",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "output",
        "protocol_file_sha256",
        "protocol_sha256",
        "status"
      ],
      "title": "HistoricalOutcomeAttempt",
      "type": "object"
    },
    "HistoricalOutcomeInventory": {
      "additionalProperties": false,
      "description": "Exact metadata-only declaration from 09.6, retaining every original attempt.",
      "properties": {
        "freshness_of_unlisted_data": {
          "const": "unknown_not_automatically_unseen",
          "title": "Freshness Of Unlisted Data",
          "type": "string"
        },
        "historical_files_mutated": {
          "const": false,
          "title": "Historical Files Mutated",
          "type": "boolean"
        },
        "new_project_labels_read": {
          "const": false,
          "title": "New Project Labels Read",
          "type": "boolean"
        },
        "observed_existing_attempts": {
          "items": {
            "$ref": "#/$defs/HistoricalOutcomeAttempt"
          },
          "maxItems": 64,
          "title": "Observed Existing Attempts",
          "type": "array"
        },
        "observed_protocols": {
          "patternProperties": {
            "^[0-9a-f]{64}$": {
              "$ref": "#/$defs/HistoricalOutcomeProtocol"
            }
          },
          "title": "Observed Protocols",
          "type": "object"
        },
        "portfolio_final_test_authorized": {
          "const": false,
          "title": "Portfolio Final Test Authorized",
          "type": "boolean"
        },
        "prior_global_access_audit_completed": {
          "const": false,
          "title": "Prior Global Access Audit Completed",
          "type": "boolean"
        },
        "project_data_fits": {
          "maximum": 0,
          "minimum": 0,
          "title": "Project Data Fits",
          "type": "integer"
        },
        "scope": {
          "const": "historical_outcome_access_declaration_from_existing_metadata_only",
          "title": "Scope",
          "type": "string"
        },
        "source_ledger": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Ledger",
          "type": "string"
        },
        "source_ledger_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Ledger Sha256",
          "type": "string"
        },
        "source_preparation_receipt": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Preparation Receipt",
          "type": "string"
        },
        "source_preparation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Preparation Sha256",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "source_ledger",
        "source_ledger_sha256",
        "source_preparation_receipt",
        "source_preparation_sha256",
        "observed_existing_attempts",
        "observed_protocols",
        "freshness_of_unlisted_data",
        "prior_global_access_audit_completed",
        "historical_files_mutated",
        "new_project_labels_read",
        "project_data_fits",
        "portfolio_final_test_authorized"
      ],
      "title": "HistoricalOutcomeInventory",
      "type": "object"
    },
    "HistoricalOutcomeProtocol": {
      "additionalProperties": false,
      "properties": {
        "existing_development_holdout_freshness": {
          "const": "opened_during_parent_verification_not_untouched",
          "title": "Existing Development Holdout Freshness",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "fold": {
          "$ref": "#/$defs/FoldPlan"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "provenance": {
          "const": "retrospective_metadata_and_preparation_receipt_not_pre_read_journal",
          "title": "Provenance",
          "type": "string"
        },
        "source_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Source Parameters",
          "type": "object"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        }
      },
      "required": [
        "parent",
        "feature_set_id",
        "split_id",
        "fold",
        "source_parameters",
        "existing_development_holdout_freshness",
        "provenance"
      ],
      "title": "HistoricalOutcomeProtocol",
      "type": "object"
    },
    "JsonValue": {},
    "Parent": {
      "additionalProperties": false,
      "properties": {
        "business_timezone": {
          "const": "UTC",
          "title": "Business Timezone",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "curated_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Curated Descriptor Sha256",
          "type": "string"
        },
        "forecast_source_status": {
          "const": "passed",
          "title": "Forecast Source Status",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snapshot-sha256-[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "curated_dataset_id",
        "snapshot_id",
        "curated_descriptor_sha256",
        "business_timezone",
        "forecast_source_status"
      ],
      "title": "Parent",
      "type": "object"
    },
    "PreparationRuntime": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "python_version": {
          "pattern": "^3\\.11\\.[0-9]+$",
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "dependency_lock_sha256",
        "python_version"
      ],
      "title": "PreparationRuntime",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:outcome_journal_policy:5.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audit Code Sha256",
      "type": "string"
    },
    "audit_scope": {
      "const": "cooperating_development_readers_partial_historical_inventory",
      "default": "cooperating_development_readers_partial_historical_inventory",
      "title": "Audit Scope",
      "type": "string"
    },
    "failure_policy": {
      "const": "reserved_failed_or_unresolved_reads_remain_potentially_exposed",
      "default": "reserved_failed_or_unresolved_reads_remain_potentially_exposed",
      "title": "Failure Policy",
      "type": "string"
    },
    "final_test_access_authorized": {
      "const": false,
      "default": false,
      "title": "Final Test Access Authorized",
      "type": "boolean"
    },
    "historical_inventory_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Historical Inventory File Sha256",
      "type": "string"
    },
    "historical_inventory_path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Historical Inventory Path",
      "type": "string"
    },
    "history": {
      "$ref": "#/$defs/HistoricalOutcomeInventory"
    },
    "independent_evaluation_access_authorized": {
      "const": false,
      "default": false,
      "title": "Independent Evaluation Access Authorized",
      "type": "boolean"
    },
    "journal_path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Journal Path",
      "type": "string"
    },
    "maximum_new_reads": {
      "default": 64,
      "maximum": 128,
      "minimum": 1,
      "title": "Maximum New Reads",
      "type": "integer"
    },
    "maximum_plans": {
      "default": 16,
      "maximum": 32,
      "minimum": 1,
      "title": "Maximum Plans",
      "type": "integer"
    },
    "maximum_reads_per_binding": {
      "default": 4,
      "maximum": 16,
      "minimum": 1,
      "title": "Maximum Reads Per Binding",
      "type": "integer"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "runtime": {
      "$ref": "#/$defs/PreparationRuntime"
    },
    "version": {
      "const": "ai09-outcome-journal-policy-1.0.0",
      "default": "ai09-outcome-journal-policy-1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "journal_path",
    "historical_inventory_path",
    "historical_inventory_file_sha256",
    "history",
    "runtime",
    "audit_code_sha256"
  ],
  "title": "OutcomeJournalPolicy",
  "type": "object"
}
