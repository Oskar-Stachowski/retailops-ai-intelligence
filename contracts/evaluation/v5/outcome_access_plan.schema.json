{
  "$defs": {
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "OutcomeAccessBinding": {
      "additionalProperties": false,
      "properties": {
        "calibrator_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibrator Sha256"
        },
        "fitted_candidate_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fitted Candidate Sha256"
        },
        "population": {
          "$ref": "#/$defs/OutcomePopulation"
        },
        "purpose": {
          "enum": [
            "preprocessing_fit",
            "model_fit",
            "early_stopping",
            "recipe_selection",
            "calibrator_fit",
            "verification",
            "independent_evaluation"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "recipe_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Recipe Sha256",
          "type": "string"
        },
        "thresholds_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thresholds Sha256"
        },
        "training_initialization_seed": {
          "exclusiveMaximum": 4294967296,
          "minimum": 0,
          "title": "Training Initialization Seed",
          "type": "integer"
        }
      },
      "required": [
        "population",
        "purpose",
        "training_initialization_seed",
        "recipe_sha256"
      ],
      "title": "OutcomeAccessBinding",
      "type": "object"
    },
    "OutcomePopulation": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "data_seed": {
          "exclusiveMaximum": 4294967296,
          "minimum": 0,
          "title": "Data Seed",
          "type": "integer"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "label_knowledge_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Label Knowledge Cutoff",
          "type": "string"
        },
        "membership_keys_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Membership Keys Sha256",
          "type": "string"
        },
        "origins": {
          "$ref": "#/$defs/DateWindow"
        },
        "outcome_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outcome Artifact Sha256",
          "type": "string"
        },
        "partition_id": {
          "pattern": "^ai09-partitions-sha256-[0-9a-f]{64}$",
          "title": "Partition Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "train",
            "early_stopping",
            "tune",
            "calibration",
            "development_evaluation"
          ],
          "title": "Role",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snapshot-sha256-[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "use_case": {
          "const": "forecast",
          "default": "forecast",
          "title": "Use Case",
          "type": "string"
        }
      },
      "required": [
        "data_seed",
        "source_dataset_id",
        "snapshot_id",
        "curated_dataset_id",
        "feature_set_id",
        "partition_id",
        "role",
        "origins",
        "label_knowledge_cutoff",
        "membership_keys_sha256",
        "outcome_artifact_sha256"
      ],
      "title": "OutcomePopulation",
      "type": "object"
    },
    "PreparationRuntime": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "python_version": {
          "pattern": "^3\\.11\\.[0-9]+$",
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "code_files",
        "code_sha256",
        "dependency_lock_sha256",
        "python_version"
      ],
      "title": "PreparationRuntime",
      "type": "object"
    }
  },
  "$id": "urn:retailops:evaluation:outcome_access_plan:5.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/OutcomeAccessBinding"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Bindings",
      "type": "array"
    },
    "final_test_access_authorized": {
      "const": false,
      "default": false,
      "title": "Final Test Access Authorized",
      "type": "boolean"
    },
    "promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Promotion Allowed",
      "type": "boolean"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "qualification": {
      "const": "development_diagnostic_only_no_freshness_or_quality_acceptance",
      "default": "development_diagnostic_only_no_freshness_or_quality_acceptance",
      "title": "Qualification",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/PreparationRuntime"
    },
    "version": {
      "const": "ai09-outcome-access-plan-1.0.0",
      "default": "ai09-outcome-access-plan-1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "protocol_sha256",
    "runtime",
    "bindings"
  ],
  "title": "OutcomeAccessPlan",
  "type": "object"
}
