{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ControlWindow": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online",
            "marketplace",
            "wholesale"
          ],
          "title": "Channel",
          "type": "string"
        },
        "start_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "End Date",
          "type": "string"
        },
        "control_type": {
          "enum": [
            "clean",
            "promotion",
            "seasonality",
            "insufficient_history"
          ],
          "title": "Control Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_id",
        "selling_location_id",
        "channel",
        "start_date",
        "end_date",
        "control_type"
      ],
      "title": "ControlWindow",
      "type": "object"
    },
    "DemandInjection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online",
            "marketplace",
            "wholesale"
          ],
          "title": "Channel",
          "type": "string"
        },
        "start_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "End Date",
          "type": "string"
        },
        "injection_type": {
          "enum": [
            "one_day_spike",
            "multi_day_spike",
            "sustained_drop"
          ],
          "title": "Injection Type",
          "type": "string"
        },
        "shape": {
          "const": "constant_multiplier",
          "title": "Shape",
          "type": "string"
        },
        "magnitude": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Magnitude",
          "type": "string"
        },
        "affected_fields": {
          "items": {
            "enum": [
              "expected_rate",
              "latent_units"
            ],
            "type": "string"
          },
          "title": "Affected Fields",
          "type": "array"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "generator_version": {
          "const": "business-anomaly-generator-1.0.0",
          "title": "Generator Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "product_id",
        "selling_location_id",
        "channel",
        "start_date",
        "end_date",
        "injection_type",
        "shape",
        "magnitude",
        "affected_fields",
        "seed",
        "generator_version"
      ],
      "title": "DemandInjection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "business-anomaly-plan-1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "data_class": {
      "const": "simulation_truth",
      "title": "Data Class",
      "type": "string"
    },
    "generator_version": {
      "const": "business-anomaly-generator-1.0.0",
      "title": "Generator Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "business_timezone": {
      "const": "UTC",
      "title": "Business Timezone",
      "type": "string"
    },
    "boundary_policy": {
      "const": "inclusive_business_dates",
      "title": "Boundary Policy",
      "type": "string"
    },
    "overlap_policy": {
      "const": "reject",
      "title": "Overlap Policy",
      "type": "string"
    },
    "minimum_history_observations": {
      "maximum": 365,
      "minimum": 1,
      "title": "Minimum History Observations",
      "type": "integer"
    },
    "injections": {
      "items": {
        "$ref": "#/$defs/DemandInjection"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Injections",
      "type": "array"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlWindow"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Controls",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "data_class",
    "generator_version",
    "seed",
    "business_timezone",
    "boundary_policy",
    "overlap_policy",
    "minimum_history_observations",
    "injections",
    "controls"
  ],
  "title": "AnomalyPlan",
  "type": "object"
}
