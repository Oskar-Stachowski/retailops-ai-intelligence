{
  "$defs": {
    "DependencyStatus": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "up",
            "down",
            "timeout"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "required",
        "status"
      ],
      "title": "DependencyStatus",
      "type": "object"
    },
    "Ready": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyStatus"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "role": {
          "default": "foundation",
          "enum": [
            "foundation",
            "ai_api"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "degraded",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "dependencies"
      ],
      "title": "Ready",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code": {
      "anyOf": [
        {
          "enum": [
            "configuration-not-approved",
            "idempotency-conflict",
            "index-run-not-found",
            "index-not-configured",
            "queue-full",
            "worker-busy",
            "claim-lost"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "detail": {
      "title": "Detail",
      "type": "string"
    },
    "instance": {
      "pattern": "^urn:uuid:[0-9a-f-]{36}$",
      "title": "Instance",
      "type": "string"
    },
    "readiness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ready"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "maximum": 599,
      "minimum": 400,
      "title": "Status",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "type": {
      "const": "about:blank",
      "default": "about:blank",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "detail",
    "instance",
    "correlation_id"
  ],
  "title": "Problem",
  "type": "object"
}
