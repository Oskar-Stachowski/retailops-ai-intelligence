          "type": "string"
        },
        "input_byte_limit": {
          "const": 134217728,
          "title": "Input Byte Limit",
          "type": "integer"
        },
        "input_row_limit": {
          "const": 100000,
          "title": "Input Row Limit",
          "type": "integer"
        },
        "output_byte_limit": {
          "const": 134217728,
          "title": "Output Byte Limit",
          "type": "integer"
        },
        "output_row_limit": {
          "const": 100000,
          "title": "Output Row Limit",
          "type": "integer"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "version": {
          "const": "return-event-day-view-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "code_files",
        "code_sha256",
        "contract_files",
        "dependency_lock_sha256",
        "python_version",
        "input_row_limit",
        "input_byte_limit",
        "output_row_limit",
        "output_byte_limit"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "Parent": {
      "additionalProperties": false,
      "properties": {
        "curated_dataset_id": {
