{
  "$defs": {
    "Descriptor": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "detector_readiness": {
          "const": "not_qualified",
          "default": "not_qualified",
          "title": "Detector Readiness",
          "type": "string"
        },
        "evaluation_truth": {
          "const": "excluded",
          "default": "excluded",
          "title": "Evaluation Truth",
          "type": "string"
        },
        "implementation": {
          "$ref": "#/$defs/Implementation"
        },
        "input_tables": {
          "items": {
            "type": "string"
          },
          "title": "Input Tables",
          "type": "array"
        },
        "model_feature_allowlist": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Model Feature Allowlist",
          "type": "array"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "role": {
          "const": "operational_view",
          "default": "operational_view",
          "title": "Role",
          "type": "string"
        },
        "row_count": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status_counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Status Counts",
          "type": "object"
        }
      },
      "required": [
        "parent",
        "policy",
        "policy_sha256",
        "implementation",
        "input_tables",
        "model_feature_allowlist",
        "row_count",
        "content_sha256",
        "status_counts"
      ],
      "title": "Descriptor",
      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "contract_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
