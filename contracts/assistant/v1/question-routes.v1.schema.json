{
  "$defs": {
    "QuestionRoute": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "enum": [
            "sales",
            "sales_comparison",
            "inventory",
            "forecast",
            "risk",
            "anomalies",
            "operations",
            "model",
            "documentation",
            "verified_state",
            "investigation",
            "recommendations",
            "refuse"
          ],
          "title": "Intent",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "intent"
      ],
      "title": "QuestionRoute",
      "type": "object"
    }
  },
  "$id": "urn:retailops:assistant:question-routes:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "graph_config_id": {
      "pattern": "^agent-graph-config-sha256-[0-9a-f]{64}$",
      "title": "Graph Config Id",
      "type": "string"
    },
    "labels_state": {
      "enum": [
        "proposed",
        "accepted"
      ],
      "title": "Labels State",
      "type": "string"
    },
    "profile": {
      "const": "assistant-question-routes-v1",
      "title": "Profile",
      "type": "string"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/QuestionRoute"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Routes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "labels_state",
    "graph_config_id",
    "routes"
  ],
  "title": "QuestionRoutes",
  "type": "object"
}
