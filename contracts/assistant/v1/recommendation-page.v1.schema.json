{
  "$defs": {
    "PersistedSuggestion": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "agent_config_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Agent Config Version",
          "type": "string"
        },
        "answer_id": {
          "format": "uuid",
          "title": "Answer Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^candidate-sha256-[0-9a-f]{64}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Created At",
          "type": "string"
        },
        "evidence_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Observed At"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Expires At",
          "type": "string"
        },
        "freshness_status": {
          "const": "current",
          "title": "Freshness Status",
          "type": "string"
        },
        "model_release_refs": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Model Release Refs",
          "type": "array"
        },
        "origin": {
          "const": "retailops-ai",
          "default": "retailops-ai",
          "title": "Origin",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "policy_version": {
          "enum": [
            "read-only-review-v1",
            "read-only-review-native-v2"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Product Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommendation_id": {
          "format": "uuid",
          "title": "Recommendation Id",
          "type": "string"
        },
        "recommendation_type": {
          "enum": [
            "review_replenishment",
            "investigate_anomaly",
            "refresh_source_data"
          ],
          "title": "Recommendation Type",
          "type": "string"
        },
        "requires_human_review": {
          "const": true,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "selling_location_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Selling Location Id",
          "type": "string"
        },
        "source_as_of": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Source As Of",
          "type": "string"
        },
        "status": {
          "const": "proposed",
          "title": "Status",
          "type": "string"
        },
        "stock_location_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stock Location Id"
        },
        "store_id": {
          "format": "uuid",
          "title": "Store Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "trace_id": {
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "recommendation_type",
        "product_id",
        "selling_location_id",
        "stock_location_id",
        "channel",
        "action",
        "priority",
        "rationale",
        "evidence_refs",
        "model_release_refs",
        "policy_version",
        "policy_sha256",
        "source_as_of",
        "expires_at",
        "freshness_status",
        "requires_human_review",
        "status",
        "recommendation_id",
        "trace_id",
        "answer_id",
        "created_at",
        "store_id",
        "summary",
        "agent_config_version"
      ],
      "title": "PersistedSuggestion",
      "type": "object"
    }
  },
  "$id": "urn:retailops:assistant:recommendation-page:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/PersistedSuggestion"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "maximum": 500,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Offset"
    }
  },
  "required": [
    "items",
    "next_offset"
  ],
  "title": "RecommendationPage",
  "type": "object"
}
