{
  "$defs": {
    "SafeToolAudit": {
      "additionalProperties": false,
      "properties": {
        "freshness_status": {
          "enum": [
            "current",
            "stale",
            "missing",
            "unavailable",
            "not_requested"
          ],
          "title": "Freshness Status",
          "type": "string"
        },
        "name": {
          "pattern": "^get_[a-z_]+$|^search_knowledge$",
          "title": "Name",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "ok",
            "no_data",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "source_refs",
        "freshness_status"
      ],
      "title": "SafeToolAudit",
      "type": "object"
    },
    "TraceNode": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "invalid_scope",
                "unauthorized",
                "dependency_unavailable",
                "budget_exceeded",
                "deadline_exceeded",
                "provider_unavailable",
                "invalid_output",
                "invalid_evidence",
                "unauthorized_tool",
                "invalid_repair",
                "trace_unavailable",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "name": {
          "pattern": "^[a-z_]{1,32}$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "duration_ms",
        "error_code"
      ],
      "title": "TraceNode",
      "type": "object"
    },
    "TraceUsage": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "estimated_cost": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:E-[0-9]+)?$",
          "title": "Estimated Cost",
          "type": "string"
        },
        "input_tokens": {
          "maximum": 16000,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 3000,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "duration_ms",
        "estimated_cost"
      ],
      "title": "TraceUsage",
      "type": "object"
    }
  },
  "$id": "urn:retailops:assistant:run:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_config_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Agent Config Version",
      "type": "string"
    },
    "answer_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Answer Id"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "invalid_scope",
            "unauthorized",
            "dependency_unavailable",
            "budget_exceeded",
            "deadline_exceeded",
            "provider_unavailable",
            "invalid_output",
            "invalid_evidence",
            "unauthorized_tool",
            "invalid_repair",
            "trace_unavailable",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "index_id": {
      "title": "Index Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/TraceNode"
      },
      "maxItems": 20,
      "title": "Nodes",
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "answered",
            "insufficient_evidence",
            "refused"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Outcome"
    },
    "requested_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Requested At",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/SafeToolAudit"
      },
      "maxItems": 6,
      "title": "Tools",
      "type": "array"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/TraceUsage"
    }
  },
  "required": [
    "trace_id",
    "answer_id",
    "status",
    "outcome",
    "requested_at",
    "completed_at",
    "agent_config_version",
    "index_id",
    "nodes",
    "tools",
    "usage",
    "error_code"
  ],
  "title": "AssistantRun",
  "type": "object"
}
