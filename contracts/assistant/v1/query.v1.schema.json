{
  "$defs": {
    "QueryScope": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "store_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Store Ids",
          "type": "array"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "product_ids",
        "store_ids",
        "from",
        "to"
      ],
      "title": "QueryScope",
      "type": "object"
    }
  },
  "$id": "urn:retailops:assistant:query:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "default": null,
      "title": "Conversation Id",
      "type": "null"
    },
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/QueryScope"
    }
  },
  "required": [
    "question",
    "scope"
  ],
  "title": "AssistantQuery",
  "type": "object"
}
