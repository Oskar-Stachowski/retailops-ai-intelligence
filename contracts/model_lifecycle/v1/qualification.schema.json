{
  "$defs": {
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "$ref": "#/$defs/Receipt"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_ready",
            "not_evaluable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "report"
      ],
      "title": "Gate",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 268435456,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "title": "Receipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ai_code_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Ai Code Commit",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/Receipt"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "curated_dataset_id": {
      "pattern": "^curated-sha256-[0-9a-f]{64}$",
      "title": "Curated Dataset Id",
      "type": "string"
    },
    "data_seed": {
      "minimum": 0,
      "title": "Data Seed",
      "type": "integer"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "evaluation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "expected_output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Output Sha256",
      "type": "string"
    },
    "feature_schema_version": {
      "const": "forecast-features-v1",
      "title": "Feature Schema Version",
      "type": "string"
    },
    "feature_set_id": {
      "pattern": "^features-sha256-[0-9a-f]{64}$",
      "title": "Feature Set Id",
      "type": "string"
    },
    "flavor": {
      "enum": [
        "forecast-json-v1",
        "baseline-json-v1",
        "mechanics-json-v1"
      ],
      "title": "Flavor",
      "type": "string"
    },
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/Gate"
      },
      "maxProperties": 10,
      "minProperties": 10,
      "propertyNames": {
        "enum": [
          "features",
          "freshness_drift_compatibility",
          "model_card",
          "pit",
          "protocol",
          "resources",
          "security_license",
          "segments",
          "signature",
          "source"
        ]
      },
      "title": "Gates",
      "type": "object"
    },
    "input_example": {
      "$ref": "#/$defs/Receipt"
    },
    "label_dataset_id": {
      "pattern": "^labels-sha256-[0-9a-f]{64}$",
      "title": "Label Dataset Id",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/Receipt"
    },
    "model_family": {
      "enum": [
        "baseline",
        "random_forest",
        "hist_gradient_boosting",
        "mechanics"
      ],
      "title": "Model Family",
      "type": "string"
    },
    "model_seed": {
      "minimum": 0,
      "title": "Model Seed",
      "type": "integer"
    },
    "original_completed_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Original Completed At",
      "type": "string"
    },
    "original_run_kind": {
      "enum": [
        "historical_evidence",
        "training",
        "mechanics_fixture"
      ],
      "title": "Original Run Kind",
      "type": "string"
    },
    "original_started_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Original Started At",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "qualified_forecast",
        "lifecycle_mechanics_only"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "reference_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Reference Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/Receipt"
    },
    "source_code_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Code Commit",
      "type": "string"
    },
    "source_dataset_id": {
      "pattern": "^source-sha256-[0-9a-f]{64}$",
      "title": "Source Dataset Id",
      "type": "string"
    },
    "split_id": {
      "pattern": "^split-sha256-[0-9a-f]{64}$",
      "title": "Split Id",
      "type": "string"
    }
  },
  "required": [
    "purpose",
    "evidence_id",
    "evaluation_id",
    "reference_id",
    "original_run_kind",
    "original_started_at",
    "original_completed_at",
    "source_dataset_id",
    "curated_dataset_id",
    "label_dataset_id",
    "split_id",
    "feature_set_id",
    "feature_schema_version",
    "config_sha256",
    "config",
    "source_code_commit",
    "ai_code_commit",
    "dependency_lock_sha256",
    "model_seed",
    "data_seed",
    "model_family",
    "flavor",
    "model",
    "signature",
    "input_example",
    "expected_output_sha256",
    "gates"
  ],
  "title": "Qualification",
  "type": "object"
}
