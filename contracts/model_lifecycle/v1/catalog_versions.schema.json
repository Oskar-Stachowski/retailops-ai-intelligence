{
  "$defs": {
    "CatalogFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason": {
          "const": "registry_and_runtime_not_observed",
          "default": "registry_and_runtime_not_observed",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_at"
      ],
      "title": "CatalogFreshness",
      "type": "object"
    },
    "CatalogPagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "CatalogPagination",
      "type": "object"
    },
    "CatalogVersion": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "feature_schema_version": {
          "default": "forecast-features-v1",
          "enum": [
            "forecast-features-v1",
            "qualified-anomaly-inputs-1.0.0"
          ],
          "title": "Feature Schema Version",
          "type": "string"
        },
        "flavor": {
          "enum": [
            "forecast-json-v1",
            "baseline-json-v1",
            "anomaly-json-v1"
          ],
          "title": "Flavor",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/CatalogFreshness"
        },
        "mlflow_run_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Mlflow Run Id",
          "type": "string"
        },
        "model_artifact": {
          "$ref": "#/$defs/Receipt"
        },
        "model_card_report": {
          "$ref": "#/$defs/Receipt"
        },
        "model_family": {
          "enum": [
            "baseline",
            "random_forest",
            "hist_gradient_boosting",
            "seasonal_residual",
            "isolation_forest"
          ],
          "title": "Model Family",
          "type": "string"
        },
        "model_name": {
          "default": "retailops-demand-forecast",
          "enum": [
            "retailops-demand-forecast",
            "retailops-sales-anomaly"
          ],
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Model Version",
          "type": "string"
        },
        "qualification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qualification Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "approved_release_recorded",
            "previously_published"
          ],
          "title": "Status",
          "type": "string"
        },
        "visible_last_published_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Visible Last Published At",
          "type": "string"
        }
      },
      "required": [
        "model_version",
        "status",
        "model_family",
        "flavor",
        "mlflow_run_id",
        "model_artifact",
        "model_card_report",
        "qualification_sha256",
        "config_sha256",
        "evaluation_id",
        "visible_last_published_at",
        "freshness"
      ],
      "title": "CatalogVersion",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 268435456,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "title": "Receipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_status": {
      "enum": [
        "available",
        "no_data"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CatalogVersion"
      },
      "maxItems": 200,
      "title": "Items",
      "type": "array"
    },
    "pagination": {
      "$ref": "#/$defs/CatalogPagination"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "view_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "View Sha256",
      "type": "string"
    }
  },
  "required": [
    "items",
    "pagination",
    "generated_at",
    "data_status",
    "view_sha256"
  ],
  "title": "VersionPage",
  "type": "object"
}
