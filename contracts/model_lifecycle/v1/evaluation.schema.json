{
  "$defs": {
    "EvaluationFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason": {
          "const": "historical_evaluation_runtime_not_observed",
          "default": "historical_evaluation_runtime_not_observed",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_at"
      ],
      "title": "EvaluationFreshness",
      "type": "object"
    },
    "EvaluationMetric": {
      "additionalProperties": false,
      "properties": {
        "excluded_rows": {
          "minimum": 0,
          "title": "Excluded Rows",
          "type": "integer"
        },
        "method": {
          "enum": [
            "last_observed",
            "moving_average",
            "seasonal_naive7",
            "random_forest",
            "hist_gradient_boosting",
            "validation_selected",
            "validation_baseline"
          ],
          "title": "Method",
          "type": "string"
        },
        "point": {
          "$ref": "#/$defs/MetricResult"
        },
        "role": {
          "enum": [
            "validation",
            "development_holdout"
          ],
          "title": "Role",
          "type": "string"
        },
        "total_rows": {
          "minimum": 0,
          "title": "Total Rows",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "method",
        "total_rows",
        "excluded_rows",
        "point"
      ],
      "title": "EvaluationMetric",
      "type": "object"
    },
    "EvaluationScope": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "store",
              "online"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channels"
      ],
      "title": "EvaluationScope",
      "type": "object"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "absolute_actual_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Actual Sum"
        },
        "absolute_error_sum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Error Sum"
        },
        "eligible_rows": {
          "minimum": 0,
          "title": "Eligible Rows",
          "type": "integer"
        },
        "mae": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mae"
        },
        "predicted_rows": {
          "minimum": 0,
          "title": "Predicted Rows",
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "incomplete",
            "not_evaluable",
            "selection_not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "wape": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wape"
        },
        "wape_status": {
          "enum": [
            "passed",
            "zero_denominator",
            "incomplete",
            "no_rows",
            "selection_not_ready"
          ],
          "title": "Wape Status",
          "type": "string"
        }
      },
      "required": [
        "eligible_rows",
        "predicted_rows",
        "status",
        "mae",
        "wape",
        "absolute_error_sum",
        "absolute_actual_sum",
        "wape_status"
      ],
      "title": "MetricResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ai_code_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Ai Code Commit",
      "type": "string"
    },
    "backtest_id": {
      "pattern": "^forecast-backtest-sha256-[0-9a-f]{64}$",
      "title": "Backtest Id",
      "type": "string"
    },
    "curated_dataset_id": {
      "pattern": "^curated-sha256-[0-9a-f]{64}$",
      "title": "Curated Dataset Id",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Lock Sha256",
      "type": "string"
    },
    "evaluation_id": {
      "pattern": "^forecast-quality-sha256-[0-9a-f]{64}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "evaluation_use": {
      "const": "development_diagnostics_previously_observed_data",
      "default": "development_diagnostics_previously_observed_data",
      "title": "Evaluation Use",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "feature_set_id": {
      "pattern": "^features-sha256-[0-9a-f]{64}$",
      "title": "Feature Set Id",
      "type": "string"
    },
    "freshness": {
      "$ref": "#/$defs/EvaluationFreshness"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "label_dataset_id": {
      "pattern": "^labels-sha256-[0-9a-f]{64}$",
      "title": "Label Dataset Id",
      "type": "string"
    },
    "metric_verification": {
      "const": "replayed_from_saved_predictions_and_labels",
      "default": "replayed_from_saved_predictions_and_labels",
      "title": "Metric Verification",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/EvaluationMetric"
      },
      "maxItems": 14,
      "minItems": 14,
      "title": "Metrics",
      "type": "array"
    },
    "model_name": {
      "const": "retailops-demand-forecast",
      "default": "retailops-demand-forecast",
      "title": "Model Name",
      "type": "string"
    },
    "original_export_run_id": {
      "pattern": "^run-[0-9a-f]{32}$",
      "title": "Original Export Run Id",
      "type": "string"
    },
    "portfolio_final_test": {
      "const": "not_included_not_opened",
      "default": "not_included_not_opened",
      "title": "Portfolio Final Test",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "historical_development_evidence",
        "synthetic_acceptance_only"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "quality_status": {
      "enum": [
        "passed",
        "failed",
        "not_ready"
      ],
      "title": "Quality Status",
      "type": "string"
    },
    "quality_verification": {
      "const": "recorded_status_not_requalified",
      "default": "recorded_status_not_requalified",
      "title": "Quality Verification",
      "type": "string"
    },
    "registered_model_version": {
      "default": null,
      "title": "Registered Model Version",
      "type": "null"
    },
    "scope": {
      "$ref": "#/$defs/EvaluationScope"
    },
    "serving_eligible": {
      "const": false,
      "default": false,
      "title": "Serving Eligible",
      "type": "boolean"
    },
    "source_code_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Code Commit",
      "type": "string"
    },
    "source_dataset_id": {
      "pattern": "^source-sha256-[0-9a-f]{64}$",
      "title": "Source Dataset Id",
      "type": "string"
    },
    "split_id": {
      "pattern": "^split-sha256-[0-9a-f]{64}$",
      "title": "Split Id",
      "type": "string"
    },
    "target_type": {
      "const": "observed_sales_units",
      "default": "observed_sales_units",
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "evaluation_id",
    "evidence_sha256",
    "original_export_run_id",
    "purpose",
    "scope",
    "quality_status",
    "source_dataset_id",
    "curated_dataset_id",
    "feature_set_id",
    "label_dataset_id",
    "split_id",
    "backtest_id",
    "source_code_commit",
    "ai_code_commit",
    "dependency_lock_sha256",
    "generated_at",
    "freshness",
    "metrics"
  ],
  "title": "EvaluationDetail",
  "type": "object"
}
