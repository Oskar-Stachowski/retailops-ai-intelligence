{
  "$defs": {
    "ApprovedModelRelease": {
      "additionalProperties": false,
      "properties": {
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Model Version",
          "type": "string"
        },
        "release_id": {
          "pattern": "^(model-release|anomaly-release)-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "model_version",
        "image_digest"
      ],
      "title": "ApprovedModelRelease",
      "type": "object"
    },
    "CatalogFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason": {
          "const": "registry_and_runtime_not_observed",
          "default": "registry_and_runtime_not_observed",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_at"
      ],
      "title": "CatalogFreshness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_release": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovedModelRelease"
        },
        {
          "type": "null"
        }
      ]
    },
    "deployed_model_version": {
      "default": null,
      "title": "Deployed Model Version",
      "type": "null"
    },
    "deployment_status": {
      "const": "not_attested",
      "default": "not_attested",
      "title": "Deployment Status",
      "type": "string"
    },
    "drift_status": {
      "const": "not_run",
      "default": "not_run",
      "title": "Drift Status",
      "type": "string"
    },
    "freshness": {
      "$ref": "#/$defs/CatalogFreshness"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "model_name": {
      "default": "retailops-demand-forecast",
      "enum": [
        "retailops-demand-forecast",
        "retailops-sales-anomaly"
      ],
      "title": "Model Name",
      "type": "string"
    },
    "registry_aliases": {
      "default": null,
      "title": "Registry Aliases",
      "type": "null"
    },
    "visible_version_count": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Visible Version Count",
      "type": "integer"
    }
  },
  "required": [
    "visible_version_count",
    "approved_release",
    "freshness",
    "generated_at"
  ],
  "title": "CatalogModel",
  "type": "object"
}
