{
  "$defs": {
    "AnomalyEvaluationScope": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "store",
              "online",
              "marketplace",
              "wholesale"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channels"
      ],
      "title": "AnomalyEvaluationScope",
      "type": "object"
    },
    "AnomalyEvaluationSummary": {
      "additionalProperties": false,
      "properties": {
        "detector_id": {
          "pattern": "^anomaly-detector-sha256-[0-9a-f]{64}$",
          "title": "Detector Id",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^anomaly-quality-sha256-[0-9a-f]{64}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "family": {
          "enum": [
            "seasonal_residual",
            "isolation_forest"
          ],
          "title": "Family",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/CatalogFreshness"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "metric_verification": {
          "const": "recomputed_from_saved_decisions_and_offline_truth",
          "default": "recomputed_from_saved_decisions_and_offline_truth",
          "title": "Metric Verification",
          "type": "string"
        },
        "mlflow_run_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Mlflow Run Id",
          "type": "string"
        },
        "model_name": {
          "const": "retailops-sales-anomaly",
          "default": "retailops-sales-anomaly",
          "title": "Model Name",
          "type": "string"
        },
        "qualification_scope": {
          "default": "synthetic_ai_07_portfolio_v1",
          "enum": [
            "synthetic_ai_07_portfolio_v1",
            "synthetic_ai_07_portfolio_v2",
            "synthetic_ai_07_portfolio_v3"
          ],
          "title": "Qualification Scope",
          "type": "string"
        },
        "quality_id": {
          "pattern": "^anomaly-quality-sha256-[0-9a-f]{64}$",
          "title": "Quality Id",
          "type": "string"
        },
        "quality_status": {
          "const": "passed",
          "default": "passed",
          "title": "Quality Status",
          "type": "string"
        },
        "registered_model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Registered Model Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AnomalyEvaluationScope"
        },
        "source_dataset_ids": {
          "items": {
            "pattern": "^source-sha256-[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Source Dataset Ids",
          "type": "array"
        }
      },
      "required": [
        "evaluation_id",
        "quality_id",
        "evidence_sha256",
        "registered_model_version",
        "mlflow_run_id",
        "detector_id",
        "family",
        "scope",
        "source_dataset_ids",
        "generated_at",
        "freshness"
      ],
      "title": "AnomalyEvaluationSummary",
      "type": "object"
    },
    "CatalogFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason": {
          "const": "registry_and_runtime_not_observed",
          "default": "registry_and_runtime_not_observed",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_at"
      ],
      "title": "CatalogFreshness",
      "type": "object"
    },
    "CatalogPagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "CatalogPagination",
      "type": "object"
    },
    "EvaluationFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason": {
          "const": "historical_evaluation_runtime_not_observed",
          "default": "historical_evaluation_runtime_not_observed",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_at"
      ],
      "title": "EvaluationFreshness",
      "type": "object"
    },
    "EvaluationScope": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "store",
              "online"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "product_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Product Ids",
          "type": "array"
        },
        "selling_location_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Selling Location Ids",
          "type": "array"
        }
      },
      "required": [
        "product_ids",
        "selling_location_ids",
        "channels"
      ],
      "title": "EvaluationScope",
      "type": "object"
    },
    "EvaluationSummary": {
      "additionalProperties": false,
      "properties": {
        "ai_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Ai Code Commit",
          "type": "string"
        },
        "backtest_id": {
          "pattern": "^forecast-backtest-sha256-[0-9a-f]{64}$",
          "title": "Backtest Id",
          "type": "string"
        },
        "curated_dataset_id": {
          "pattern": "^curated-sha256-[0-9a-f]{64}$",
          "title": "Curated Dataset Id",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^forecast-quality-sha256-[0-9a-f]{64}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evaluation_use": {
          "const": "development_diagnostics_previously_observed_data",
          "default": "development_diagnostics_previously_observed_data",
          "title": "Evaluation Use",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "feature_set_id": {
          "pattern": "^features-sha256-[0-9a-f]{64}$",
          "title": "Feature Set Id",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/EvaluationFreshness"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "label_dataset_id": {
          "pattern": "^labels-sha256-[0-9a-f]{64}$",
          "title": "Label Dataset Id",
          "type": "string"
        },
        "metric_verification": {
          "const": "replayed_from_saved_predictions_and_labels",
          "default": "replayed_from_saved_predictions_and_labels",
          "title": "Metric Verification",
          "type": "string"
        },
        "model_name": {
          "const": "retailops-demand-forecast",
          "default": "retailops-demand-forecast",
          "title": "Model Name",
          "type": "string"
        },
        "original_export_run_id": {
          "pattern": "^run-[0-9a-f]{32}$",
          "title": "Original Export Run Id",
          "type": "string"
        },
        "portfolio_final_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Portfolio Final Test",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "historical_development_evidence",
            "synthetic_acceptance_only"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "quality_status": {
          "enum": [
            "passed",
            "failed",
            "not_ready"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "quality_verification": {
          "const": "recorded_status_not_requalified",
          "default": "recorded_status_not_requalified",
          "title": "Quality Verification",
          "type": "string"
        },
        "registered_model_version": {
          "default": null,
          "title": "Registered Model Version",
          "type": "null"
        },
        "scope": {
          "$ref": "#/$defs/EvaluationScope"
        },
        "serving_eligible": {
          "const": false,
          "default": false,
          "title": "Serving Eligible",
          "type": "boolean"
        },
        "source_code_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Code Commit",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "split_id": {
          "pattern": "^split-sha256-[0-9a-f]{64}$",
          "title": "Split Id",
          "type": "string"
        },
        "target_type": {
          "const": "observed_sales_units",
          "default": "observed_sales_units",
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "evidence_sha256",
        "original_export_run_id",
        "purpose",
        "scope",
        "quality_status",
        "source_dataset_id",
        "curated_dataset_id",
        "feature_set_id",
        "label_dataset_id",
        "split_id",
        "backtest_id",
        "source_code_commit",
        "ai_code_commit",
        "dependency_lock_sha256",
        "generated_at",
        "freshness"
      ],
      "title": "EvaluationSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_status": {
      "enum": [
        "available",
        "no_data"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "items": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/EvaluationSummary"
          },
          {
            "$ref": "#/$defs/AnomalyEvaluationSummary"
          }
        ]
      },
      "maxItems": 200,
      "title": "Items",
      "type": "array"
    },
    "pagination": {
      "$ref": "#/$defs/CatalogPagination"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "view_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "View Sha256",
      "type": "string"
    }
  },
  "required": [
    "items",
    "pagination",
    "generated_at",
    "data_status",
    "view_sha256"
  ],
  "title": "EvaluationPage",
  "type": "object"
}
