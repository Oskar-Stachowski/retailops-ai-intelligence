{
  "$defs": {
    "ApprovedModelRelease": {
      "additionalProperties": false,
      "properties": {
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "model_version": {
          "pattern": "^[1-9][0-9]{0,9}$",
          "title": "Model Version",
          "type": "string"
        },
        "release_id": {
          "pattern": "^model-release-sha256-[0-9a-f]{64}$",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "model_version",
        "image_digest"
      ],
      "title": "ApprovedModelRelease",
      "type": "object"
    },
    "CatalogFreshness": {
      "additionalProperties": false,
      "properties": {
        "evaluated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Evaluated At",
          "type": "string"
        },
        "reason": {
          "const": "registry_and_runtime_not_observed",
          "default": "registry_and_runtime_not_observed",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unknown",
          "default": "unknown",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluated_at"
      ],
      "title": "CatalogFreshness",
      "type": "object"
    },
    "CatalogModel": {
      "additionalProperties": false,
      "properties": {
        "approved_release": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovedModelRelease"
            },
            {
              "type": "null"
            }
          ]
        },
        "deployed_model_version": {
          "default": null,
          "title": "Deployed Model Version",
          "type": "null"
        },
        "deployment_status": {
          "const": "not_attested",
          "default": "not_attested",
          "title": "Deployment Status",
          "type": "string"
        },
        "drift_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Drift Status",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/CatalogFreshness"
        },
        "generated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Generated At",
          "type": "string"
        },
        "model_name": {
          "const": "retailops-demand-forecast",
          "default": "retailops-demand-forecast",
          "title": "Model Name",
          "type": "string"
        },
        "registry_aliases": {
          "default": null,
          "title": "Registry Aliases",
          "type": "null"
        },
        "visible_version_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Visible Version Count",
          "type": "integer"
        }
      },
      "required": [
        "visible_version_count",
        "approved_release",
        "freshness",
        "generated_at"
      ],
      "title": "CatalogModel",
      "type": "object"
    },
    "CatalogPagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Offset"
        },
        "offset": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "offset",
        "total",
        "next_offset"
      ],
      "title": "CatalogPagination",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_status": {
      "enum": [
        "available",
        "no_data"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CatalogModel"
      },
      "maxItems": 200,
      "title": "Items",
      "type": "array"
    },
    "pagination": {
      "$ref": "#/$defs/CatalogPagination"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "view_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "View Sha256",
      "type": "string"
    }
  },
  "required": [
    "items",
    "pagination",
    "generated_at",
    "data_status",
    "view_sha256"
  ],
  "title": "ModelPage",
  "type": "object"
}
