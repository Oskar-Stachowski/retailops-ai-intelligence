  "format_version": "retailops-parquet-1.0.0",
  "mapping_semantics": {
    "inventory": "stock location mapping is available; inventory_ready=false forbids inventory features",
    "missing_mapping": "reject/quarantine with lineage; never invent store/warehouse/zero",
    "product_id": "products.id = product_catalog.id; SKU from product_catalog",
    "selling_location_id": "selling_locations.id; channel_assignments maps legacy_store_id by channel, validity and availability",
    "stock_location_id": "stock_locations.id; fulfillment_routes maps selling location/channel by validity and availability"
  },
  "namespaces": {
    "simulation_truth": "evaluation_truth",
    "source_observation": "facts",
    "source_plan": "facts"
  },
  "producer": "retailops-cloud-native-platform",
  "readiness_semantics": {
    "anomaly": "not_ready",
    "forecast_source": "ready",
    "forecasting": "not_ready",
    "hard_checks": 46,
    "inventory_ready": false,
    "rag": "not_applicable",
    "replay": "not_ready",
    "required_use_case": "forecast_source",
    "source_ready": true,
    "source_report_policy": "forecast-source-acceptance-1.1.0",
    "stockout": "not_ready"
  },
  "supported_snapshot_versions": [
    "1.0.0"
  ],
  "supported_source_versions": [
    "2.6.0"
  ],
  "time_semantics": {
    "business_date": "UTC business day; local_timezone is calendar metadata",
    "business_timezone": "UTC",
    "history": "append-only version, increasing available_at; latest version known at origin, never latest overall",
    "intervals": "effective_from <= business_date < effective_to; available_at <= origin",
    "null": "unknown/missing/open interval; never replace with zero",
    "origin": "inclusive UTC knowledge cutoff; available_at must be <= origin",
    "returns": "39-day return tail; event time, ingestion and cohort maturity remain separate",
    "timestamps": "UTC, explicit timezone, microsecond precision",
    "watermarks": "manifest per-stream boundary and declared completeness, not maximum event timestamp"
  },
  "units": {
    "channels": [
      "store",
      "online",
      "marketplace",
      "wholesale"
    ],
    "money": "decimal128(38,2), source currency retained",
    "rates": "decimal256(76,40); never binary float for canonicalization",
    "sales_quantity": "integer saleable packs; pack_quantity/pack_unit describes physical content"
  }
}
