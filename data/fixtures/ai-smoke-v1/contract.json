{
  "arrow_metadata": {
    "retailops.format": "retailops-parquet-1.0.0",
    "retailops.source_schema": "2.6.0"
  },
  "canonical_identity": {
    "ai_foundation_hash": "Existing logical_rows_sha256 in AI v1 uses unique keys and a different algorithm; do not substitute it for this source multiset hash",
    "boolean": "JSON true/false",
    "date": "YYYY-MM-DD",
    "decimal": "finite Decimal.normalize() with context precision 28; fixed notation string; all numeric zero is '0'",
    "identity_excludes": [
      "own ID",
      "generated_at",
      "local paths",
      "physical file checksums",
      "manifest checksum"
    ],
    "integer": "JSON integer, never float or boolean",
    "json": "UTF-8 json.dumps(sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)",
    "physical_integrity": "separate SHA256/bytes for every file; manifest.sha256 checks snapshot_manifest.json",
    "snapshot_id": "snapshot-sha256- + SHA256(canonical JSON descriptor)",
    "source_id": "source-sha256- + SHA256(canonical JSON source.descriptor)",
    "table_hash": "sha256(canonical JSON ordered column-name list + LF + canonical JSON rows sorted by UTF-8 bytes, each followed by LF); preserve duplicate rows",
    "text": "Unicode NFC; preserve whitespace; empty CSV cell maps to null",
    "timestamp": "UTC datetime.isoformat(), +00:00 suffix; retain microseconds"
  },
  "canonicalization_version": "typed-csv-nfc-utc-multiset-1.6.0",
  "consumer": "retailops-ai-intelligence",
  "consumer_rules": [
    "No generator imports or operational DB access",
    "Reject unsupported versions, unsafe paths, symlinks, missing/extra artifacts and identity/checksum conflicts",
    "Verify every declared physical file and typed canonical rows before immutable import publication",
    "Choose facts explicitly; truth never enters API runtime or feature joins automatically",
    "Schemas include full upstream lineage metadata; excluded source CSV paths are not snapshot file references",
    "Fixture acceptance checks transport/schema/identity; typed importer, curated and cross-repo gate are stages 03.4/03.5/03.6"
  ],
