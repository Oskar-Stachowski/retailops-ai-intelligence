# Local diagnostics; this file contains no credentials.
APP_ENV=local
ARTIFACT_ROOT=./artifacts
LOG_LEVEL=INFO
# Real retrieval queries require an accepted release and explicit AWS opt-in.
RAG_BEDROCK_ENABLED=false
# Optional persisted human-review events; requires the isolated AI database.
# See docs/assistant-suggestion-outbox.md and the accepted Source v1 policy.
ASSISTANT_SUGGESTION_OUTBOX_ENABLED=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8081
READINESS_TIMEOUT_SECONDS=1
# METRICS_TOKEN is optional: absent => /metrics returns 404.
# Set a generated 32-128 character URL-safe token through the environment
# or a private .env. Never commit the value or pass it on the command line.
# BUILD_COMMIT (40 lowercase hex) and IMAGE_DIGEST (sha256:64 hex) are optional
# build-provided metadata, not automatically inferred or attested.
# DB/MLflow/provider/exporter settings arrive with their actual components.
# Application credentials are independent of METRICS_TOKEN.
# API_AUTH_FILE is optional: absent => protected /api/v1 endpoints return 401.
# Point to a private owner-only policy file generated by access-init.
# Never put client credentials in dotenv, Git, reports or command arguments.

# Optional document Assistant: configure BOTH paths, DATABASE_URL and RAG_BEDROCK_ENABLED=true.
# See docs/assistant-document-runtime.md for source/pin/permissions and separate cost limits.
# ASSISTANT_RUNTIME_FILE=agent/document-runtime.v1.json
# ASSISTANT_SOURCE_IMPORT=<verified-AI03-import-directory>
