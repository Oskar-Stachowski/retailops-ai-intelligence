# Local diagnostics; this file contains no credentials.
APP_ENV=local
ARTIFACT_ROOT=./artifacts
LOG_LEVEL=INFO
HTTP_HOST=127.0.0.1
HTTP_PORT=8081
READINESS_TIMEOUT_SECONDS=1
# METRICS_TOKEN is optional: absent => /metrics returns 404.
# Set a generated 32-128 character URL-safe token through the environment
# or a private .env. Never commit the value or pass it on the command line.
# BUILD_COMMIT (40 lowercase hex) and IMAGE_DIGEST (sha256:64 hex) are optional
# build-provided metadata, not automatically inferred or attested.
# DB/MLflow/provider/exporter settings arrive with their actual components.
