{
  "$defs": {
    "Descriptor": {
      "additionalProperties": false,
      "properties": {
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "cohort_maturity_is_day_closure": {
          "const": false,
          "title": "Cohort Maturity Is Day Closure",
          "type": "boolean"
        },
        "contract_version": {
          "const": "business-day-coverage-1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "dependency_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Sha256",
          "type": "string"
        },
        "missing_grain_policy": {
          "const": "unknown_not_zero",
          "title": "Missing Grain Policy",
          "type": "string"
        },
        "owner": {
          "const": "retailops-cloud-native-platform",
          "title": "Owner",
          "type": "string"
        },
        "policy_version": {
          "const": "synthetic-parent-event-day-close-1.0.0",
          "title": "Policy Version",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "return_closure_basis": {
          "const": "verified_complete_synthetic_export_and_bounded_native_ingestion",
          "title": "Return Closure Basis",
          "type": "string"
        },
        "return_scope": {
          "const": "purchases_in_parent_source_only",
          "title": "Return Scope",
          "type": "string"
        },
        "row_count": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Row Count",
          "type": "integer"
        },
        "rows_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rows Sha256",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "source_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Descriptor Sha256",
          "type": "string"
        },
        "source_tables": {
          "additionalProperties": {
            "$ref": "#/$defs/TableIdentity"
          },
          "title": "Source Tables",
          "type": "object"
        },
        "transport_durability_proven": {
          "const": false,
          "title": "Transport Durability Proven",
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "policy_version",
        "owner",
        "source_dataset_id",
        "source_descriptor_sha256",
        "source_tables",
        "return_scope",
        "return_closure_basis",
        "missing_grain_policy",
        "cohort_maturity_is_day_closure",
        "transport_durability_proven",
        "code_sha256",
        "dependency_sha256",
        "python_version",
        "rows_sha256",
        "row_count"
      ],
      "title": "Descriptor",
      "type": "object"
    },
    "TableIdentity": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "data_class": {
          "enum": [
            "source_observation",
            "source_plan",
            "simulation_truth"
          ],
          "title": "Data Class",
          "type": "string"
        },
        "grain": {
          "items": {
            "type": "string"
          },
          "title": "Grain",
          "type": "array"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        }
      },
      "required": [
        "row_count",
        "columns",
        "grain",
        "data_class",
        "content_sha256"
      ],
      "title": "TableIdentity",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage_id": {
      "pattern": "^day-coverage-sha256-[0-9a-f]{64}$",
      "title": "Coverage Id",
      "type": "string"
    },
    "descriptor": {
      "$ref": "#/$defs/Descriptor"
    }
  },
  "required": [
    "coverage_id",
    "descriptor"
  ],
  "title": "Manifest",
  "type": "object"
}
