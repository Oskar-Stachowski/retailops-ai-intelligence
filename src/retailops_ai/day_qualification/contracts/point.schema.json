{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount"
    },
    "as_of": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "As Of",
      "type": "string"
    },
    "business_date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "Business Date",
      "type": "string"
    },
    "channel": {
      "enum": [
        "store",
        "online",
        "marketplace",
        "wholesale"
      ],
      "title": "Channel",
      "type": "string"
    },
    "currency": {
      "enum": [
        "PLN",
        "EUR"
      ],
      "title": "Currency",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "sale_completed",
        "return_completed"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "missing_fact_keys": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fact Keys",
      "type": "array"
    },
    "observed_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Units"
    },
    "product_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Product Id",
      "type": "string"
    },
    "raw_dq_completeness": {
      "default": "not_qualified",
      "enum": [
        "qualified",
        "not_qualified"
      ],
      "title": "Raw Dq Completeness",
      "type": "string"
    },
    "rejected_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Units"
    },
    "score_eligible": {
      "default": false,
      "title": "Score Eligible",
      "type": "boolean"
    },
    "selling_location_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Selling Location Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "no_declaration",
        "closure_unavailable",
        "source_incomplete",
        "location_closed",
        "dq_unattributed_quarantine",
        "dq_missing_facts",
        "qualified"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "business_date",
    "product_id",
    "selling_location_id",
    "channel",
    "currency",
    "as_of",
    "status"
  ],
  "title": "Point",
  "type": "object"
}
