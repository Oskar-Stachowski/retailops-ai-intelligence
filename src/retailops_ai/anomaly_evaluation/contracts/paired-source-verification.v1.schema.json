{
  "$defs": {
    "JsonValue": {},
    "PairedSourceParent": {
      "additionalProperties": false,
      "properties": {
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "source_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Descriptor Sha256",
          "type": "string"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        },
        "source_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Report Sha256",
          "type": "string"
        },
        "source_rows": {
          "maximum": 20000000,
          "minimum": 1,
          "title": "Source Rows",
          "type": "integer"
        },
        "source_schema_version": {
          "enum": [
            "2.7.0",
            "2.8.0"
          ],
          "title": "Source Schema Version",
          "type": "string"
        },
        "source_table_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Table Inventory Sha256",
          "type": "string"
        },
        "source_tables": {
          "const": 58,
          "default": 58,
          "title": "Source Tables",
          "type": "integer"
        }
      },
      "required": [
        "source_dataset_id",
        "source_schema_version",
        "source_manifest_sha256",
        "source_descriptor_sha256",
        "source_report_sha256",
        "source_table_inventory_sha256",
        "source_rows"
      ],
      "title": "PairedSourceParent",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "both_complete_sources_and_reports_replayed": {
      "const": true,
      "default": true,
      "title": "Both Complete Sources And Reports Replayed",
      "type": "boolean"
    },
    "clean_window_count": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Clean Window Count",
      "type": "integer"
    },
    "clean_windows_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Clean Windows Sha256",
      "type": "string"
    },
    "comparison_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Comparison Policy Sha256",
      "type": "string"
    },
    "comparison_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Comparison Sha256",
      "type": "string"
    },
    "complete_observation_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Complete Observation Count",
      "type": "integer"
    },
    "complete_window_count": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Complete Window Count",
      "type": "integer"
    },
    "complete_windows_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Complete Windows Sha256",
      "type": "string"
    },
    "episode_count": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Episode Count",
      "type": "integer"
    },
    "episodes_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Episodes Sha256",
      "type": "string"
    },
    "exporter_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Exporter Lock Sha256",
      "type": "string"
    },
    "inventory_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inventory Configuration Sha256",
      "type": "string"
    },
    "native_reader": {
      "const": "data.inventory.source_dataset_io.read_source_dataset",
      "default": "data.inventory.source_dataset_io.read_source_dataset",
      "title": "Native Reader",
      "type": "string"
    },
    "ordinary": {
      "$ref": "#/$defs/PairedSourceParent"
    },
    "planned": {
      "$ref": "#/$defs/PairedSourceParent"
    },
    "producer_code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Producer Code Sha256",
      "type": "string"
    },
    "producer_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Producer Commit",
      "type": "string"
    },
    "producer_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Producer Lock Sha256",
      "type": "string"
    },
    "producer_python_version": {
      "pattern": "^3\\.11\\.[0-9]+$",
      "title": "Producer Python Version",
      "type": "string"
    },
    "quality_qualified": {
      "const": false,
      "default": false,
      "title": "Quality Qualified",
      "type": "boolean"
    },
    "resolved_parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Resolved Parameters",
      "type": "object"
    },
    "scenario_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Plan Sha256",
      "type": "string"
    },
    "source_context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Context Sha256",
      "type": "string"
    },
    "source_scenario_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Scenario Sha256",
      "type": "string"
    },
    "version": {
      "const": "ai09-complete-paired-source-verification-1.0.0",
      "default": "ai09-complete-paired-source-verification-1.0.0",
      "title": "Version",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/Window"
    }
  },
  "required": [
    "ordinary",
    "planned",
    "producer_commit",
    "producer_code_sha256",
    "producer_lock_sha256",
    "exporter_lock_sha256",
    "producer_python_version",
    "resolved_parameters",
    "inventory_configuration_sha256",
    "source_context_sha256",
    "source_scenario_sha256",
    "scenario_plan_sha256",
    "window",
    "comparison_sha256",
    "comparison_policy_sha256",
    "clean_windows_sha256",
    "clean_window_count",
    "complete_windows_sha256",
    "complete_window_count",
    "complete_observation_count",
    "episodes_sha256",
    "episode_count"
  ],
  "title": "PairedSourceVerification",
  "type": "object"
}
