{
  "$defs": {
    "CampaignGenerationResources": {
      "additionalProperties": false,
      "properties": {
        "cpu_threads": {
          "const": 1,
          "default": 1,
          "title": "Cpu Threads",
          "type": "integer"
        },
        "max_log_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 1024,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "minimum_available_memory_bytes": {
          "minimum": 1024,
          "title": "Minimum Available Memory Bytes",
          "type": "integer"
        },
        "minimum_free_disk_bytes": {
          "minimum": 1024,
          "title": "Minimum Free Disk Bytes",
          "type": "integer"
        },
        "sample_seconds": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0.01,
          "title": "Sample Seconds",
          "type": "number"
        },
        "scratch_bytes": {
          "maximum": 137438953472,
          "minimum": 1024,
          "title": "Scratch Bytes",
          "type": "integer"
        },
        "tree_rss_bytes": {
          "maximum": 68719476736,
          "minimum": 1024,
          "title": "Tree Rss Bytes",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "tree_rss_bytes",
        "scratch_bytes",
        "minimum_free_disk_bytes",
        "minimum_available_memory_bytes"
      ],
      "title": "CampaignGenerationResources",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generation_operation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Generation Operation Id",
      "type": "string"
    },
    "max_source_bytes": {
      "default": 2147483648,
      "maximum": 2147483648,
      "minimum": 1024,
      "title": "Max Source Bytes",
      "type": "integer"
    },
    "max_source_rows": {
      "default": 20000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Max Source Rows",
      "type": "integer"
    },
    "max_truth_bytes": {
      "default": 33554432,
      "maximum": 33554432,
      "minimum": 1024,
      "title": "Max Truth Bytes",
      "type": "integer"
    },
    "phase": {
      "enum": [
        "development",
        "final"
      ],
      "title": "Phase",
      "type": "string"
    },
    "population": {
      "const": "all_native_sales_days_and_parent_purchase_return_tail",
      "default": "all_native_sales_days_and_parent_purchase_return_tail",
      "title": "Population",
      "type": "string"
    },
    "quality_qualified": {
      "const": false,
      "default": false,
      "title": "Quality Qualified",
      "type": "boolean"
    },
    "resources": {
      "$ref": "#/$defs/CampaignGenerationResources"
    },
    "source_recipe_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Recipe Sha256",
      "type": "string"
    },
    "version": {
      "const": "ai09-campaign-ordinary-truth-plan-1.0.0",
      "default": "ai09-campaign-ordinary-truth-plan-1.0.0",
      "title": "Version",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/Window"
    }
  },
  "required": [
    "phase",
    "source_recipe_sha256",
    "generation_operation_id",
    "window",
    "resources"
  ],
  "title": "CampaignOrdinaryTruthPlan",
  "type": "object"
}
