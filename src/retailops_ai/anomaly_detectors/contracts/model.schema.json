{
  "$defs": {
    "Fill": {
      "additionalProperties": false,
      "properties": {
        "known_count": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Known Count",
          "type": "integer"
        },
        "name": {
          "enum": [
            "observed_units",
            "expected_units",
            "residual_units",
            "robust_scale_units",
            "standardized_residual",
            "planned_price",
            "promotion_offered",
            "on_hand",
            "short_count_residual",
            "long_count_residual",
            "inventory_shortfall"
          ],
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "enum": [
            "train_median",
            "entirely_missing_constant_zero"
          ],
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "known_count",
        "reason"
      ],
      "title": "Fill",
      "type": "object"
    },
    "FitPolicy": {
      "additionalProperties": false,
      "properties": {
        "contamination": {
          "anyOf": [
            {
              "const": "auto",
              "type": "string"
            },
            {
              "exclusiveMinimum": 0,
              "maximum": 0.5,
              "type": "number"
            }
          ],
          "default": "auto",
          "title": "Contamination"
        },
        "features": {
          "default": [
            "observed_units",
            "expected_units",
            "residual_units",
            "robust_scale_units",
            "standardized_residual",
            "planned_price",
            "promotion_offered",
            "on_hand"
          ],
          "items": {
            "enum": [
              "observed_units",
              "expected_units",
              "residual_units",
              "robust_scale_units",
              "standardized_residual",
              "planned_price",
              "promotion_offered",
              "on_hand",
              "short_count_residual",
              "long_count_residual",
              "inventory_shortfall"
            ],
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        },
        "fit_cpu_seconds": {
          "const": 60,
          "default": 60,
          "title": "Fit Cpu Seconds",
          "type": "integer"
        },
        "fit_rss_bytes": {
          "const": 536870912,
          "default": 536870912,
          "title": "Fit Rss Bytes",
          "type": "integer"
        },
        "fit_wall_seconds": {
          "const": 60,
          "default": 60,
          "title": "Fit Wall Seconds",
          "type": "integer"
        },
        "max_features": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Features",
          "type": "number"
        },
        "max_matrix_bytes": {
          "const": 4194304,
          "default": 4194304,
          "title": "Max Matrix Bytes",
          "type": "integer"
        },
        "max_samples": {
          "default": 64,
          "maximum": 256,
          "minimum": 16,
          "title": "Max Samples",
          "type": "integer"
        },
        "max_train_rows": {
          "const": 10000,
          "default": 10000,
          "title": "Max Train Rows",
          "type": "integer"
        },
        "minimum_train_rows": {
          "default": 16,
          "maximum": 10000,
          "minimum": 16,
          "title": "Minimum Train Rows",
          "type": "integer"
        },
        "minimum_validation_rows": {
          "default": 16,
          "maximum": 10000,
          "minimum": 16,
          "title": "Minimum Validation Rows",
          "type": "integer"
        },
        "model_seed": {
          "default": 137,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "n_estimators": {
          "default": 32,
          "maximum": 128,
          "minimum": 8,
          "title": "N Estimators",
          "type": "integer"
        },
        "score_arithmetic": {
          "const": "decimal50_half_even_12_places",
          "default": "decimal50_half_even_12_places",
          "title": "Score Arithmetic",
          "type": "string"
        },
        "selection": {
          "const": "unlabelled_validation_alert_capacity",
          "default": "unlabelled_validation_alert_capacity",
          "title": "Selection",
          "type": "string"
        },
        "validation_alert_fraction": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Validation Alert Fraction",
          "type": "number"
        },
        "validation_high_fraction": {
          "default": 0.01,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Validation High Fraction",
          "type": "number"
        },
        "version": {
          "default": "anomaly-detector-fit-1.0.0",
          "enum": [
            "anomaly-detector-fit-1.0.0",
            "anomaly-detector-fit-2.0.0"
          ],
          "title": "Version",
          "type": "string"
        }
      },
      "title": "FitPolicy",
      "type": "object"
    },
    "Forest": {
      "additionalProperties": false,
      "properties": {
        "feature_count": {
          "maximum": 22,
          "minimum": 2,
          "title": "Feature Count",
          "type": "integer"
        },
        "input_dtype": {
          "const": "float32",
          "default": "float32",
          "title": "Input Dtype",
          "type": "string"
        },
        "max_samples": {
          "maximum": 256,
          "minimum": 16,
          "title": "Max Samples",
          "type": "integer"
        },
        "native_offset": {
          "maximum": 0,
          "minimum": -1,
          "title": "Native Offset",
          "type": "number"
        },
        "sklearn_version": {
          "const": "1.9.1",
          "default": "1.9.1",
          "title": "Sklearn Version",
          "type": "string"
        },
        "trees": {
          "items": {
            "$ref": "#/$defs/Tree"
          },
          "maxItems": 128,
          "minItems": 8,
          "title": "Trees",
          "type": "array"
        }
      },
      "required": [
        "feature_count",
        "max_samples",
        "native_offset",
        "trees"
      ],
      "title": "Forest",
      "type": "object"
    },
    "Group": {
      "additionalProperties": false,
      "properties": {
        "baseline_threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Threshold"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "enum": [
            "PLN",
            "EUR"
          ],
          "title": "Currency",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "sale_completed",
            "return_completed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "forest_threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Threshold"
            },
            {
              "type": "null"
            }
          ]
        },
        "pipeline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pipeline"
            },
            {
              "type": "null"
            }
          ]
        },
        "training_rows": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Training Rows",
          "type": "integer"
        }
      },
      "required": [
        "event_type",
        "currency",
        "training_rows",
        "pipeline",
        "baseline_threshold",
        "forest_threshold"
      ],
      "title": "Group",
      "type": "object"
    },
    "ModelDescriptor": {
      "additionalProperties": false,
      "properties": {
        "detector_readiness": {
          "const": "not_qualified",
          "default": "not_qualified",
          "title": "Detector Readiness",
          "type": "string"
        },
        "feature_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Descriptor Sha256",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/Group"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/FitPolicy"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "qualified_anomaly_input_id": {
          "pattern": "^qualified-anomaly-inputs-sha256-[0-9a-f]{64}$",
          "title": "Qualified Anomaly Input Id",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "training_membership_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Training Membership Sha256",
          "type": "string"
        },
        "truth_access": {
          "const": "excluded",
          "default": "excluded",
          "title": "Truth Access",
          "type": "string"
        },
        "validation_membership_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Membership Sha256",
          "type": "string"
        },
        "version": {
          "const": "anomaly-detectors-1.0.0",
          "default": "anomaly-detectors-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "qualified_anomaly_input_id",
        "feature_descriptor_sha256",
        "protocol",
        "policy",
        "runtime",
        "training_membership_sha256",
        "validation_membership_sha256",
        "groups"
      ],
      "title": "ModelDescriptor",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "anyOf": [
            {
              "maximum": 21,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Feature"
        },
        "left": {
          "anyOf": [
            {
              "maximum": 510,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left"
        },
        "right": {
          "anyOf": [
            {
              "maximum": 510,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right"
        },
        "sample_count": {
          "maximum": 256,
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "sample_count",
        "feature",
        "threshold",
        "left",
        "right"
      ],
      "title": "Node",
      "type": "object"
    },
    "Pipeline": {
      "additionalProperties": false,
      "properties": {
        "fills": {
          "items": {
            "$ref": "#/$defs/Fill"
          },
          "maxItems": 11,
          "minItems": 1,
          "title": "Fills",
          "type": "array"
        },
        "forest": {
          "$ref": "#/$defs/Forest"
        },
        "training_rows": {
          "maximum": 10000,
          "minimum": 16,
          "title": "Training Rows",
          "type": "integer"
        },
        "training_rows_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Training Rows Sha256",
          "type": "string"
        }
      },
      "required": [
        "training_rows",
        "training_rows_sha256",
        "fills",
        "forest"
      ],
      "title": "Pipeline",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "fit_clock": {
          "const": "utc_window_start_minus_one_microsecond",
          "default": "utc_window_start_minus_one_microsecond",
          "title": "Fit Clock",
          "type": "string"
        },
        "history_days": {
          "const": 28,
          "default": 28,
          "title": "History Days",
          "type": "integer"
        },
        "minimum_history_days": {
          "const": 14,
          "default": 14,
          "title": "Minimum History Days",
          "type": "integer"
        },
        "minimum_residuals": {
          "const": 7,
          "default": 7,
          "title": "Minimum Residuals",
          "type": "integer"
        },
        "quantity_basis": {
          "const": "dq_accepted_receipts_at_query_cutoff",
          "default": "dq_accepted_receipts_at_query_cutoff",
          "title": "Quantity Basis",
          "type": "string"
        },
        "returns_delay_hours": {
          "default": 72,
          "maximum": 168,
          "minimum": 0,
          "title": "Returns Delay Hours",
          "type": "integer"
        },
        "sales_delay_hours": {
          "default": 24,
          "maximum": 168,
          "minimum": 0,
          "title": "Sales Delay Hours",
          "type": "integer"
        },
        "scale_policy": {
          "const": "max_1_pcs_1.4826_mad_prior_seasonal_residuals",
          "default": "max_1_pcs_1.4826_mad_prior_seasonal_residuals",
          "title": "Scale Policy",
          "type": "string"
        },
        "scoring_clock": {
          "const": "exclusive_utc_day_end_plus_delay_inclusive",
          "default": "exclusive_utc_day_end_plus_delay_inclusive",
          "title": "Scoring Clock",
          "type": "string"
        },
        "seasonal_lag_days": {
          "const": 7,
          "default": 7,
          "title": "Seasonal Lag Days",
          "type": "integer"
        },
        "stock_policy": {
          "const": "scoring_context_only_no_automatic_censoring_correction",
          "default": "scoring_context_only_no_automatic_censoring_correction",
          "title": "Stock Policy",
          "type": "string"
        },
        "version": {
          "const": "qualified-anomaly-inputs-1.0.0",
          "default": "qualified-anomaly-inputs-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "Protocol": {
      "additionalProperties": false,
      "properties": {
        "feature_policy": {
          "$ref": "#/$defs/Policy",
          "default": {
            "fit_clock": "utc_window_start_minus_one_microsecond",
            "history_days": 28,
            "minimum_history_days": 14,
            "minimum_residuals": 7,
            "quantity_basis": "dq_accepted_receipts_at_query_cutoff",
            "returns_delay_hours": 72,
            "sales_delay_hours": 24,
            "scale_policy": "max_1_pcs_1.4826_mad_prior_seasonal_residuals",
            "scoring_clock": "exclusive_utc_day_end_plus_delay_inclusive",
            "seasonal_lag_days": 7,
            "stock_policy": "scoring_context_only_no_automatic_censoring_correction",
            "version": "qualified-anomaly-inputs-1.0.0"
          }
        },
        "final_portfolio_test": {
          "const": "not_included_not_opened",
          "default": "not_included_not_opened",
          "title": "Final Portfolio Test",
          "type": "string"
        },
        "gap_policy": {
          "const": "requested_and_counted_never_fitted",
          "default": "requested_and_counted_never_fitted",
          "title": "Gap Policy",
          "type": "string"
        },
        "membership_clock": {
          "const": "business_window_and_available_scoring_outcome",
          "default": "business_window_and_available_scoring_outcome",
          "title": "Membership Clock",
          "type": "string"
        },
        "missing_policy": {
          "const": "requested_unknown_not_clean_negative",
          "default": "requested_unknown_not_clean_negative",
          "title": "Missing Policy",
          "type": "string"
        },
        "purpose": {
          "const": "development_mechanics_only",
          "default": "development_mechanics_only",
          "title": "Purpose",
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "test": {
          "$ref": "#/$defs/Window"
        },
        "train": {
          "$ref": "#/$defs/Window"
        },
        "training_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Training Cutoff",
          "type": "string"
        },
        "training_labels": {
          "const": "unavailable_no_oracle_filter",
          "default": "unavailable_no_oracle_filter",
          "title": "Training Labels",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/Window"
        },
        "version": {
          "const": "anomaly-detector-protocol-1.0.0",
          "default": "anomaly-detector-protocol-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "scopes",
        "train",
        "validation",
        "test",
        "training_cutoff",
        "selection_cutoff"
      ],
      "title": "Protocol",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "code_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Code Files",
          "type": "object"
        },
        "contract_files": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Contract Files",
          "type": "object"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "code_files",
        "contract_files",
        "dependency_lock_sha256",
        "python_version"
      ],
      "title": "Runtime",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online",
            "marketplace",
            "wholesale"
          ],
          "title": "Channel",
          "type": "string"
        },
        "currency": {
          "enum": [
            "PLN",
            "EUR"
          ],
          "title": "Currency",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "sale_completed",
            "return_completed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Selling Location Id",
          "type": "string"
        }
      },
      "required": [
        "event_type",
        "product_id",
        "selling_location_id",
        "channel",
        "currency"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Threshold": {
      "additionalProperties": false,
      "properties": {
        "allowed_alerts": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Allowed Alerts",
          "type": "integer"
        },
        "allowed_high_alerts": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Allowed High Alerts",
          "type": "integer"
        },
        "comparison": {
          "const": "strictly_greater_ties_do_not_alert",
          "default": "strictly_greater_ties_do_not_alert",
          "title": "Comparison",
          "type": "string"
        },
        "high_threshold": {
          "minimum": 0,
          "title": "High Threshold",
          "type": "number"
        },
        "threshold": {
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "validation_rows": {
          "maximum": 10000,
          "minimum": 16,
          "title": "Validation Rows",
          "type": "integer"
        },
        "validation_scores_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Scores Sha256",
          "type": "string"
        }
      },
      "required": [
        "validation_rows",
        "validation_scores_sha256",
        "allowed_alerts",
        "allowed_high_alerts",
        "threshold",
        "high_threshold"
      ],
      "title": "Threshold",
      "type": "object"
    },
    "Tree": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 511,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "Tree",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/ModelDescriptor"
    },
    "detector_id": {
      "pattern": "^anomaly-detector-sha256-[0-9a-f]{64}$",
      "title": "Detector Id",
      "type": "string"
    }
  },
  "required": [
    "detector_id",
    "descriptor"
  ],
  "title": "ModelManifest",
  "type": "object"
}
