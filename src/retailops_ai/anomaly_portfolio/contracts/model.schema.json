            "enum": [
              "observed_units",
              "expected_units",
              "residual_units",
              "robust_scale_units",
              "standardized_residual",
              "planned_price",
              "promotion_offered",
              "on_hand",
              "short_count_residual",
              "long_count_residual",
              "inventory_shortfall"
            ],
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        },
        "fit_cpu_seconds": {
          "const": 300,
          "default": 300,
          "title": "Fit Cpu Seconds",
          "type": "integer"
        },
        "fit_rss_bytes": {
          "const": 1073741824,
          "default": 1073741824,
          "title": "Fit Rss Bytes",
          "type": "integer"
        },
        "fit_wall_seconds": {
          "const": 300,
          "default": 300,
          "title": "Fit Wall Seconds",
          "type": "integer"
        },
        "max_features": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Max Features",
          "type": "number"
        },
        "max_matrix_bytes": {
          "const": 268435456,
          "default": 268435456,
          "title": "Max Matrix Bytes",
          "type": "integer"
        },
        "max_samples": {
          "default": 64,
          "maximum": 256,
          "minimum": 16,
          "title": "Max Samples",
          "type": "integer"
        },
        "max_train_rows": {
          "const": 1000000,
          "default": 1000000,
          "title": "Max Train Rows",
          "type": "integer"
        },
        "minimum_available_memory_bytes": {
          "const": 1073741824,
          "default": 1073741824,
          "title": "Minimum Available Memory Bytes",
          "type": "integer"
        },
        "minimum_free_disk_bytes": {
          "const": 6442450944,
          "default": 6442450944,
          "title": "Minimum Free Disk Bytes",
          "type": "integer"
        },
        "minimum_train_rows": {
          "default": 16,
          "maximum": 10000,
          "minimum": 16,
          "title": "Minimum Train Rows",
          "type": "integer"
        },
        "minimum_validation_rows": {
          "default": 16,
          "maximum": 10000,
          "minimum": 16,
          "title": "Minimum Validation Rows",
          "type": "integer"
        },
        "model_seed": {
          "default": 137,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Model Seed",
          "type": "integer"
        },
        "n_estimators": {
          "default": 32,
          "maximum": 128,
          "minimum": 8,
          "title": "N Estimators",
          "type": "integer"
        },
        "population": {
          "const": "every_declared_eligible_training_row",
          "default": "every_declared_eligible_training_row",
          "title": "Population",
          "type": "string"
        },
        "score_arithmetic": {
          "const": "decimal50_half_even_12_places",
          "default": "decimal50_half_even_12_places",
          "title": "Score Arithmetic",
          "type": "string"
        },
        "selection": {
          "const": "unlabelled_validation_alert_capacity",
          "default": "unlabelled_validation_alert_capacity",
          "title": "Selection",
          "type": "string"
        },
        "validation_alert_fraction": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Validation Alert Fraction",
          "type": "number"
        },
        "validation_high_fraction": {
          "default": 0.01,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Validation High Fraction",
          "type": "number"
