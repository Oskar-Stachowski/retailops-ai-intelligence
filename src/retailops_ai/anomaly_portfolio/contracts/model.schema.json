{
  "$defs": {
    "CensusCountRateDescriptor": {
      "additionalProperties": false,
      "description": "Full-count numerical artifacts use a separate version from AI07 models.",
      "properties": {
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "event_capacities": {
          "items": {
            "$ref": "#/$defs/EventCapacity"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Event Capacities",
          "type": "array"
        },
        "feature_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Manifest Sha256",
          "type": "string"
        },
        "feature_population": {
          "const": "complete_declared_point_census",
          "default": "complete_declared_point_census",
          "title": "Feature Population",
          "type": "string"
        },
        "feature_rows_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Rows Sha256",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/CensusGroup"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "history_clock": {
          "const": "prior_ready_scoring_origins_at_or_before_current_origin",
          "default": "prior_ready_scoring_origins_at_or_before_current_origin",
          "title": "History Clock",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/CensusFitPolicy"
        },
        "qualified_anomaly_input_id": {
          "default": null,
          "title": "Qualified Anomaly Input Id",
          "type": "null"
        },
        "rate_clock": {
          "const": "mean_qualified_prior_28_days_at_current_fit_cutoff",
          "default": "mean_qualified_prior_28_days_at_current_fit_cutoff",
          "title": "Rate Clock",
          "type": "string"
        },
        "residual_recipe": {
          "const": "causal-count-residuals-2.0.0",
          "default": "causal-count-residuals-2.0.0",
          "title": "Residual Recipe",
          "type": "string"
        },
        "selection_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Selection Cutoff",
          "type": "string"
        },
        "source_dataset_id": {
          "pattern": "^source-sha256-[0-9a-f]{64}$",
          "title": "Source Dataset Id",
          "type": "string"
        },
        "train": {
          "$ref": "#/$defs/Window"
        },
        "training_cutoff": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
          "title": "Training Cutoff",
          "type": "string"
        },
        "training_membership_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Training Membership Sha256",
          "type": "string"
        },
        "truth_access": {
          "const": "excluded_no_oracle_training",
          "default": "excluded_no_oracle_training",
          "title": "Truth Access",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/Window"
        },
        "validation_membership_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Validation Membership Sha256",
          "type": "string"
        },
        "version": {
          "const": "anomaly-portfolio-model-4.0.0",
          "default": "anomaly-portfolio-model-4.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_dataset_id",
        "feature_manifest_sha256",
        "feature_rows_sha256",
        "train",
        "validation",
        "training_cutoff",
        "selection_cutoff",
        "policy",
        "groups",
        "training_membership_sha256",
        "validation_membership_sha256",
        "code_sha256",
        "dependency_lock_sha256",
        "event_capacities"
      ],
      "title": "CensusCountRateDescriptor",
      "type": "object"
    },
    "CensusFill": {
      "additionalProperties": false,
      "properties": {
        "known_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Known Count",
          "type": "integer"
        },
        "name": {
          "enum": [
            "observed_units",
            "expected_units",
            "residual_units",
            "robust_scale_units",
            "standardized_residual",
            "planned_price",
            "promotion_offered",
            "on_hand",
            "short_count_residual",
            "long_count_residual",
            "inventory_shortfall"
          ],
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "enum": [
            "train_median",
            "entirely_missing_constant_zero"
          ],
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "known_count",
        "reason"
      ],
      "title": "CensusFill",
      "type": "object"
    },
    "CensusFitPolicy": {
      "additionalProperties": false,
