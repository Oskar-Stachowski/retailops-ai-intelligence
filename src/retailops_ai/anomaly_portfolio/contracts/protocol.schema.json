{
  "$defs": {
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "fit_clock": {
          "const": "utc_window_start_minus_one_microsecond",
          "default": "utc_window_start_minus_one_microsecond",
          "title": "Fit Clock",
          "type": "string"
        },
        "history_days": {
          "const": 28,
          "default": 28,
          "title": "History Days",
          "type": "integer"
        },
        "minimum_history_days": {
          "const": 14,
          "default": 14,
          "title": "Minimum History Days",
          "type": "integer"
        },
        "minimum_residuals": {
          "const": 7,
          "default": 7,
          "title": "Minimum Residuals",
          "type": "integer"
        },
        "quantity_basis": {
          "const": "dq_accepted_receipts_at_query_cutoff",
          "default": "dq_accepted_receipts_at_query_cutoff",
          "title": "Quantity Basis",
          "type": "string"
        },
        "returns_delay_hours": {
          "default": 72,
          "maximum": 168,
          "minimum": 0,
          "title": "Returns Delay Hours",
          "type": "integer"
        },
        "sales_delay_hours": {
          "default": 24,
          "maximum": 168,
          "minimum": 0,
          "title": "Sales Delay Hours",
          "type": "integer"
        },
        "scale_policy": {
          "const": "max_1_pcs_1.4826_mad_prior_seasonal_residuals",
          "default": "max_1_pcs_1.4826_mad_prior_seasonal_residuals",
          "title": "Scale Policy",
          "type": "string"
        },
        "scoring_clock": {
          "const": "exclusive_utc_day_end_plus_delay_inclusive",
          "default": "exclusive_utc_day_end_plus_delay_inclusive",
          "title": "Scoring Clock",
          "type": "string"
        },
        "seasonal_lag_days": {
          "const": 7,
          "default": 7,
          "title": "Seasonal Lag Days",
          "type": "integer"
        },
        "stock_policy": {
          "const": "scoring_context_only_no_automatic_censoring_correction",
          "default": "scoring_context_only_no_automatic_censoring_correction",
          "title": "Stock Policy",
          "type": "string"
        },
        "version": {
          "const": "qualified-anomaly-inputs-1.0.0",
          "default": "qualified-anomaly-inputs-1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "store",
            "online",
            "marketplace",
            "wholesale"
          ],
          "title": "Channel",
          "type": "string"
        },
        "currency": {
          "enum": [
            "PLN",
            "EUR"
          ],
          "title": "Currency",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "sale_completed",
            "return_completed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "product_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Product Id",
          "type": "string"
        },
        "selling_location_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Selling Location Id",
          "type": "string"
        }
      },
      "required": [
        "event_type",
        "product_id",
        "selling_location_id",
        "channel",
        "currency"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "feature_policy": {
      "$ref": "#/$defs/Policy",
      "default": {
        "fit_clock": "utc_window_start_minus_one_microsecond",
        "history_days": 28,
        "minimum_history_days": 14,
        "minimum_residuals": 7,
        "quantity_basis": "dq_accepted_receipts_at_query_cutoff",
        "returns_delay_hours": 72,
        "sales_delay_hours": 24,
        "scale_policy": "max_1_pcs_1.4826_mad_prior_seasonal_residuals",
        "scoring_clock": "exclusive_utc_day_end_plus_delay_inclusive",
        "seasonal_lag_days": 7,
        "stock_policy": "scoring_context_only_no_automatic_censoring_correction",
        "version": "qualified-anomaly-inputs-1.0.0"
      }
    },
    "final_portfolio_test": {
      "const": "reserved_until_selection_frozen",
      "default": "reserved_until_selection_frozen",
      "title": "Final Portfolio Test",
      "type": "string"
    },
    "gap_policy": {
      "const": "requested_and_counted_never_fitted",
      "default": "requested_and_counted_never_fitted",
      "title": "Gap Policy",
      "type": "string"
    },
    "membership_clock": {
      "const": "business_window_and_available_scoring_outcome",
      "default": "business_window_and_available_scoring_outcome",
      "title": "Membership Clock",
      "type": "string"
    },
    "missing_policy": {
      "const": "requested_unknown_not_clean_negative",
      "default": "requested_unknown_not_clean_negative",
      "title": "Missing Policy",
      "type": "string"
    },
    "purpose": {
      "const": "bounded_portfolio_qualification",
      "default": "bounded_portfolio_qualification",
      "title": "Purpose",
      "type": "string"
    },
    "scopes": {
      "items": {
        "$ref": "#/$defs/Scope"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Scopes",
      "type": "array"
    },
    "selection_cutoff": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Selection Cutoff",
      "type": "string"
    },
    "test": {
      "$ref": "#/$defs/Window"
    },
    "train": {
      "$ref": "#/$defs/Window"
    },
    "training_cutoff": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Training Cutoff",
      "type": "string"
    },
    "training_labels": {
      "const": "unavailable_no_oracle_filter",
      "default": "unavailable_no_oracle_filter",
      "title": "Training Labels",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/Window"
    },
    "version": {
      "const": "anomaly-portfolio-protocol-1.0.0",
      "default": "anomaly-portfolio-protocol-1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "scopes",
    "train",
    "validation",
    "test",
    "training_cutoff",
    "selection_cutoff"
  ],
  "title": "PortfolioProtocol",
  "type": "object"
}
