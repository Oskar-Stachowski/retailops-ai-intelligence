{
  "$defs": {
    "InventoryContext": {
      "additionalProperties": false,
      "properties": {
        "on_hand": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "On Hand"
        },
        "status": {
          "enum": [
            "unavailable",
            "potential_stockout",
            "no_stockout_signal"
          ],
          "title": "Status",
          "type": "string"
        },
        "stock_location_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stock Location Id"
        }
      },
      "required": [
        "stock_location_id",
        "on_hand",
        "status"
      ],
      "title": "InventoryContext",
      "type": "object"
    },
    "PromotionContext": {
      "additionalProperties": false,
      "properties": {
        "offered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offered"
        },
        "planned_price": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Planned Price"
        }
      },
      "required": [
        "offered",
        "planned_price"
      ],
      "title": "PromotionContext",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alert": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Alert"
    },
    "alert_status": {
      "enum": [
        "open",
        "no_alert",
        "insufficient_data"
      ],
      "title": "Alert Status",
      "type": "string"
    },
    "anomaly_id": {
      "pattern": "^anomaly-sha256-[0-9a-f]{64}$",
      "title": "Anomaly Id",
      "type": "string"
    },
    "anomaly_type": {
      "anyOf": [
        {
          "enum": [
            "sales_spike",
            "sales_drop",
            "residual_outlier",
            "return_spike",
            "stockout_censored_demand",
            "data_quality_suspicion"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Anomaly Type"
    },
    "as_of": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "As Of",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^anomaly-batch-sha256-[0-9a-f]{64}$",
      "title": "Batch Id",
      "type": "string"
    },
    "business_date": {
      "format": "date",
      "title": "Business Date",
      "type": "string"
    },
    "channel": {
      "enum": [
        "store",
        "online",
        "marketplace",
        "wholesale"
      ],
      "title": "Channel",
      "type": "string"
    },
    "curated_dataset_id": {
      "pattern": "^curated-sha256-[0-9a-f]{64}$",
      "title": "Curated Dataset Id",
      "type": "string"
    },
    "currency": {
      "enum": [
        "PLN",
        "EUR"
      ],
      "title": "Currency",
      "type": "string"
    },
    "detected_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Detected At",
      "type": "string"
    },
    "detector_id": {
      "pattern": "^anomaly-detector-sha256-[0-9a-f]{64}$",
      "title": "Detector Id",
      "type": "string"
    },
    "detector_name": {
      "const": "retailops-sales-anomaly",
      "default": "retailops-sales-anomaly",
      "title": "Detector Name",
      "type": "string"
    },
    "detector_version": {
      "pattern": "^[1-9][0-9]{0,9}$",
      "title": "Detector Version",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "sale_completed",
        "return_completed"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "expected_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Units"
    },
    "explanation_codes": {
      "items": {
        "type": "string"
      },
      "title": "Explanation Codes",
      "type": "array"
    },
    "family": {
      "enum": [
        "seasonal_residual",
        "isolation_forest"
      ],
      "title": "Family",
      "type": "string"
    },
    "freshness_status": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ],
      "title": "Freshness Status",
      "type": "string"
    },
    "full_dq_replay_id": {
      "pattern": "^full-dq-replay-sha256-[0-9a-f]{64}$",
      "title": "Full Dq Replay Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Generated At",
      "type": "string"
    },
    "inference_run_id": {
      "pattern": "^anomaly-batch-sha256-[0-9a-f]{64}$",
      "title": "Inference Run Id",
      "type": "string"
    },
    "input_status": {
      "enum": [
        "ready_input",
        "insufficient_history",
        "day_unqualified",
        "no_declaration"
      ],
      "title": "Input Status",
      "type": "string"
    },
    "inventory_context": {
      "$ref": "#/$defs/InventoryContext"
    },
    "observed_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Units"
    },
    "observed_window": {
      "$ref": "#/$defs/Window"
    },
    "on_hand": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "On Hand"
    },
    "product_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Product Id",
      "type": "string"
    },
    "promotion_context": {
      "$ref": "#/$defs/PromotionContext"
    },
    "promotion_offered": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Promotion Offered"
    },
    "qualified_anomaly_input_id": {
      "pattern": "^qualified-anomaly-inputs-sha256-[0-9a-f]{64}$",
      "title": "Qualified Anomaly Input Id",
      "type": "string"
    },
    "quality_status": {
      "const": "passed_at_publication",
      "default": "passed_at_publication",
      "title": "Quality Status",
      "type": "string"
    },
    "release_id": {
      "pattern": "^anomaly-release-sha256-[0-9a-f]{64}$",
      "title": "Release Id",
      "type": "string"
    },
    "residual_units": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Residual Units"
    },
    "role": {
      "enum": [
        "validation",
        "final_test",
        "batch"
      ],
      "title": "Role",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Score"
    },
    "score_definition": {
      "enum": [
        "absolute_causal_standardized_residual",
        "portable_isolation_forest_path_length"
      ],
      "title": "Score Definition",
      "type": "string"
    },
    "scoring_origin": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$",
      "title": "Scoring Origin",
      "type": "string"
    },
    "selling_location_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Selling Location Id",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "none",
            "medium",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Severity"
    },
    "signal_episode_id": {
      "anyOf": [
        {
          "pattern": "^signal-episode-sha256-[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Signal Episode Id"
    },
    "source_dataset_id": {
      "pattern": "^source-sha256-[0-9a-f]{64}$",
      "title": "Source Dataset Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "scored",
        "insufficient_data"
      ],
      "title": "Status",
      "type": "string"
    },
    "threshold": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Threshold"
    },
    "threshold_version": {
      "const": "validation-alert-capacity-1.0.0",
      "default": "validation-alert-capacity-1.0.0",
      "title": "Threshold Version",
      "type": "string"
    },
    "version": {
      "const": "anomaly-portfolio-decision-1.0.0",
      "default": "anomaly-portfolio-decision-1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "product_id",
    "selling_location_id",
    "channel",
    "currency",
    "business_date",
    "scoring_origin",
    "detector_id",
    "family",
    "role",
    "status",
    "score",
    "threshold",
    "alert",
    "severity",
    "explanation_codes",
    "observed_units",
    "expected_units",
    "residual_units",
    "promotion_offered",
    "on_hand",
    "input_status",
    "anomaly_id",
    "batch_id",
    "signal_episode_id",
    "observed_window",
    "detected_at",
    "inference_run_id",
    "inventory_context",
    "promotion_context",
    "detector_version",
    "release_id",
    "source_dataset_id",
    "curated_dataset_id",
    "qualified_anomaly_input_id",
    "full_dq_replay_id",
    "generated_at",
    "as_of",
    "freshness_status",
    "anomaly_type",
    "alert_status",
    "score_definition"
  ],
  "title": "Item",
  "type": "object"
}
